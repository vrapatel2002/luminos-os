#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer B { float data[]; };
layout(push_constant) uniform P { uint iters; } pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  float s = data[i];
  float a0=s, a1=s+1.0, a2=s+2.0, a3=s+3.0;
  float a4=s+4.0, a5=s+5.0, a6=s+6.0, a7=s+7.0;
  const float b = 1.0000001, c = 0.0000001;
  for (uint k = 0u; k < pc.iters; ++k) {
    a0 = fma(a0,b,c); a1 = fma(a1,b,c); a2 = fma(a2,b,c); a3 = fma(a3,b,c);
    a4 = fma(a4,b,c); a5 = fma(a5,b,c); a6 = fma(a6,b,c); a7 = fma(a7,b,c);
  }
  data[i] = a0+a1+a2+a3+a4+a5+a6+a7;
}
