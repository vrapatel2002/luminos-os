# [CHANGE: claude-code | 2026-06-03]
# [CHANGE: claude-code | 2026-09-14] Was a udev-triggered oneshot that blanked the
# screen and kept the box awake. It is now a long-running watcher that suspends.
# The udev rule it used to depend on (99-luminos-lid.rules) is gone: it matched
# KERNEL=="LID0", SUBSYSTEM=="button", which does not exist on this kernel.
[Unit]
Description=Luminos lid handler — a closed lid suspends, ignoring all inhibitors
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/luminos-lid
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
