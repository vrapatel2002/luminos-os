[Unit]
# [CHANGE: claude-code | 2026-08-29] BUG-146 — bring /dev/nvidia-uvm{,-tools} under DECISION 25.
# nvidia-modprobe hardcodes 0666 root:root for these two nodes and the NVreg_DeviceFile*
# params do not reach them, so they were the one hole left in the default-deny gate.
Description=Luminos dGPU gate: nvidia_uvm device nodes (DECISION 25 / BUG-146)
Documentation=file:///home/shawn/luminos-os/docs/BUGS.md

# [CHANGE: claude-code | 2026-08-29] BUG-147 — THIS UNIT IS NOW THE BACKSTOP, NOT THE FIX.
# It used to be the only mechanism, and it lost the boot race at EVERY boot: nvidia-modprobe
# is invoked from 60-nvidia.rules the moment the card binds (t=6.87 s, measured) and creates
# both UVM nodes 0666 root:root, while this unit did not run until t=9.09 s. That is a 2.2
# second world-open window on every boot, i.e. DECISION 25 was not actually in force then.
#
# 71-luminos-uvm-gate.rules now closes it: that rule rides the SAME PCI uevent and runs
# `luminos-uvm-gate --udev` immediately after nvidia-modprobe. Measured residual window
# 9-18 ms. This unit still runs, and still catches the case where the rule did not fire at
# all (file removed, udev not reloaded, module loaded later by some other path).
#
# HOW TO READ `systemctl status` NOW: the healthy outcome is "active (exited)" with a single
# `gated: ... root:dgpu 660` line and NO "created" line. A failure here means the udev rule
# did not do its job — that is the signal. Do not silence it by relaxing the script.
#
# And do NOT restore the old "must win the race" goal below. Winning it BREAKS THE CARD:
# 60-nvidia.rules guards both its RUN+= lines with TEST!="/dev/nvidia-uvm", so a pre-created
# UVM node suppresses nvidia-modprobe entirely and /dev/nvidia0 is never made. Measured.

# The module must be loaded for the device major to exist; modules-load.d/nvidia.conf does it.
After=systemd-modules-load.service
Wants=systemd-modules-load.service

# [CHANGE: claude-code | 2026-08-29] BUG-147 — this used to read "Must win the race:
# pre-create the nodes correctly owned BEFORE anything triggers nvidia-modprobe". That goal
# was both unreachable (udev beats us by 2.2 s) and, if reached, destructive (see above).
# These two orderings are KEPT anyway, for a different and still-valid reason: they make this
# backstop run before the two things that first OPEN the dGPU, so if the udev rule ever fails
# the repair still lands before a real client can use an ungated node.
Before=supergfxd.service
Before=display-manager.service

# [CHANGE: claude-code | 2026-08-29] BUG-147 — DO NOT ADD `Before=nvidia-powerd.service`.
# It was proposed as the fix for the boot race and then tested; it is REDUNDANT, twice over:
#   1. nvidia-powerd itself declares `After=supergfxd.service`, and this unit is already
#      `Before=supergfxd.service`, so the ordering gate -> supergfxd -> nvidia-powerd is
#      already guaranteed transitively.
#   2. nvidia-powerd is `disabled` with an EMPTY WantedBy — it cannot start itself at boot
#      at all. supergfxd starts it explicitly, which is by definition after us. The boot
#      journal shows `Did CommandArgs { inner: ["start", "nvidia-powerd.service"] }`.
# Checked with `systemctl show -p After -p Before -p WantedBy`, not by reading documentation.
# Adding the line would cost nothing but would imply a guarantee we did not actually need.

[Service]
Type=oneshot
# RemainAfterExit is what makes `systemctl status` readable for a unit whose whole job is a
# one-time boot fixup. The cost: to re-apply by hand you must use `systemctl RESTART`, because
# `start` on an already-active unit is a silent no-op.
RemainAfterExit=yes
ExecStart=/usr/local/bin/luminos-uvm-gate

# NO PAIRED .path UNIT — this was tried on 2026-08-29 and removed. Two reasons, both measured:
#   1. It spun. PathExists= stays satisfied for as long as the path is there, and this service
#      CREATES the path rather than consuming it, so the unit retriggered itself ~4x/second
#      until systemd tripped the start limit and left the service 'failed'. PathExists is for
#      flag files that the triggered unit deletes; that is not this.
#   2. It was not needed. Device nodes live in devtmpfs and are NOT removed when the module
#      unloads — verified by `rmmod nvidia_uvm`, after which both nodes remained present with
#      0660 root:dgpu intact. So once this service gets them right at boot they stay right for
#      the whole session; nothing but root can delete them, and nothing does.

[Install]
WantedBy=multi-user.target
