 /*
+ * LUMINOS-NVSLEEP: PM_SUSPEND_PREPARE marks the port and every descendant except the card syscore.
+ * The card's .prepare (after freeze, pm_suspend_target_state valid) re-checks the slot and marks the
+ * card or aborts the sleep with -EBUSY. PM_POST_SUSPEND (also after an abort) clears everything.
+ */
+static NvBool nv_sleep_card_syscore;     /* the card's .prepare confirmed the skip */
+/* pci_walk_bus callback: a function that is awake, or outside the card's slot, voids the scan. */
+static int nv_sleep_scan_fn(struct pci_dev *pdev, void *data)
+{
+    struct pci_dev **card = data;
+
+    if (pm_runtime_suspended(&pdev->dev) && (PCI_SLOT(pdev->devfn) == PCI_SLOT((*card)->devfn)))
+        return 0;
+    *card = NULL;
+    return 1;
+}
+
+/* True when the port, the card and every function below the port are runtime-suspended. */
+static NvBool nv_sleep_slot_idle(struct pci_dev *card)
+{
+    struct pci_dev *port = pci_upstream_bridge(card);
+
+    if ((port == NULL) || (port->subordinate == NULL) || !pm_runtime_suspended(&port->dev))
+        return NV_FALSE;
+    pci_walk_bus(port->subordinate, nv_sleep_scan_fn, &card);
+    return card != NULL;
+}
+
+/* Set or clear syscore on dev and every descendant, any depth. Idempotent. */
+static int nv_sleep_mark(struct device *dev, void *on)
+{
+    dev_pm_syscore_device(dev, *(NvBool *)on);
+    return device_for_each_child(dev, on, nv_sleep_mark);
+}
+
+/* PM_SUSPEND_PREPARE: every GPU's slot idle -> mark the ports and descendants, not the cards. */
+static NvBool nv_sleep_skip_begin(void)
+{
+    nv_linux_state_t *nvl;
+    NvBool on = NV_TRUE, idle;
+
+    if (!READ_ONCE(nv_sleep_skip_idle))
+        return NV_FALSE;
+    down(&nv_system_power_state_lock);
+    down_write(&nv_system_pm_lock);
+    LOCK_NV_LINUX_DEVICES();
+    idle = (nv_linux_devices != NULL) && (nv_system_power_state == NV_POWER_STATE_RUNNING);
+    for (nvl = nv_linux_devices; idle && (nvl != NULL); nvl = nvl->next)
+        idle = (nvl->pci_dev != NULL) && nv_sleep_slot_idle(nvl->pci_dev);
+    for (nvl = nv_linux_devices; idle && (nvl != NULL); nvl = nvl->next)
+    {
+        nv_sleep_mark(&pci_upstream_bridge(nvl->pci_dev)->dev, &on);
+        dev_pm_syscore_device(nvl->dev, false);    /* the card decides in .prepare */
+    }
+    UNLOCK_NV_LINUX_DEVICES();
+    if (idle)
+    {
+        WRITE_ONCE(nv_sleep_skipping, NV_TRUE);
+        nv_system_power_state = NV_POWER_STATE_IN_STANDBY;
+        printk(KERN_INFO "NVRM: nvsleep: GPU slot idle, leaving it off for this sleep\n");
+    }
+    else
+        up_write(&nv_system_pm_lock);
+    up(&nv_system_power_state_lock);
+
+    return idle;
+}
+
+/* Clear the port subtree (card included); a slot that a queued port resume powered is resynced. */
+static void nv_sleep_unmark(nv_linux_state_t *nvl)
+{
+    struct pci_dev *port = (nvl->pci_dev != NULL) ? pci_upstream_bridge(nvl->pci_dev) : NULL;
+    NvBool off = NV_FALSE;
+
+    if (port == NULL)
+        return;
+    nv_sleep_mark(&port->dev, &off);
+    dev_pm_set_strict_midlayer(nvl->dev, false);   /* pci_pm_prepare set it; the card's complete() never ran */
+    if (pm_runtime_status_suspended(nvl->dev) && !pm_runtime_status_suspended(&port->dev))
+    {
+        printk(KERN_INFO "NVRM: nvsleep: slot powered while the GPU slept, resuming it to resync\n");
+        pm_request_resume(nvl->dev);
+    }
+}
+
+/* PM_POST_SUSPEND after a skipped (or aborted) sleep. Returns NV_FALSE when the stock path applies. */
+static NvBool nv_sleep_skip_end(void)
+{
+    nv_linux_state_t *nvl;
+
+    down(&nv_system_power_state_lock);
+    if (!nv_sleep_skipping)
+    {
+        up(&nv_system_power_state_lock);
+        return NV_FALSE;
+    }
+    LOCK_NV_LINUX_DEVICES();
+    for (nvl = nv_linux_devices; nvl != NULL; nvl = nvl->next)
+        nv_sleep_unmark(nvl);
+    UNLOCK_NV_LINUX_DEVICES();
+    WRITE_ONCE(nv_sleep_skipping, NV_FALSE);
+    up_write(&nv_system_pm_lock);
+    nv_system_power_state = NV_POWER_STATE_RUNNING;
+    printk(KERN_INFO "NVRM: nvsleep: %s\n", nv_sleep_card_syscore ? "sleep over, GPU stayed off" : "sleep aborted, flags cleared");
+    if (nv_sleep_card_syscore)
+        nv_sleep_skipped++;
+    nv_sleep_card_syscore = NV_FALSE;
+    up(&nv_system_power_state_lock);
+
+    return NV_TRUE;
+}
+
+/*
+ * LUMINOS-NVSLEEP: runs after freeze_processes, when pm_suspend_target_state is valid. Confirms
+ * the skip for this card (it becomes syscore too) or aborts the sleep; POST then cleans up.
+ */
+static int nv_pmops_prepare(struct device *dev)
+{
+    struct pci_dev *card, *port;
+
+    if (!READ_ONCE(nv_sleep_skipping) || !dev_is_pci(dev))   /* skipping implies every GPU is PCI */
+        return 0;
+    card = to_pci_dev(dev);
+    port = pci_upstream_bridge(card);
+    if ((pm_suspend_target_state == PM_SUSPEND_TO_IDLE) && (port != NULL))
+    {
+        pm_runtime_barrier(&port->dev);   /* a queued port resume runs now, not at late-suspend */
+        if (nv_sleep_slot_idle(card))
+        {
+            dev_pm_syscore_device(dev, true);
+            nv_sleep_card_syscore = NV_TRUE;
+            return 0;
+        }
+    }
+    printk(KERN_INFO "NVRM: nvsleep: GPU slot no longer idle or not s2idle, aborting this sleep\n");
+    return -EBUSY;
+}
