 namespace Platform
 {
 
+// [CHANGE: claude-code | 2026-08-14] Luminos OS, DECISION 72.
+// Kirigami's design tokens are compiled-in constants with no config file and
+// read-only QML properties, so a desktop that wants a different visual scale
+// (here: Caelestia's Material 3 scale) has no lever at all. These helpers add
+// one. Every token below keeps its upstream default when the variable is unset
+// or unparseable, so an un-set environment is byte-for-byte stock behaviour.
+namespace
+{
+qreal luminosEnvReal(const char *name, qreal fallback)
+{
+    const QByteArray value = qgetenv(name);
+    if (value.isEmpty()) {
+        return fallback;
+    }
+    bool ok = false;
+    const qreal parsed = value.toDouble(&ok);
+    return (ok && parsed >= 0) ? parsed : fallback;
+}
+
+int luminosEnvInt(const char *name, int fallback)
+{
+    const QByteArray value = qgetenv(name);
+    if (value.isEmpty()) {
+        return fallback;
+    }
+    bool ok = false;
+    const int parsed = value.toInt(&ok);
+    return (ok && parsed > 0) ? parsed : fallback;
+}
+}
+
 class UnitsPrivate
 {
     Q_DISABLE_COPY(UnitsPrivate)
