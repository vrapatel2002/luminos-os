# Maintainer: Antonio Rojas <arojas@archlinux.org>
#
# [CHANGE: claude-code | 2026-08-14] LUMINOS FORK — DECISION 72.
# This is Arch's stock kirigami PKGBUILD plus one patch. Do not "clean up" the
# pkgrel: 1.1 sorts ABOVE the repo's 1, which is what stops a routine
# `pacman -Syu` from silently reverting the desktop's look. When upstream moves
# to 6.28.1 or 6.29 the repo version wins again and this must be rebuilt.
#
#   Rebuild:  makepkg -si
#   Revert:   sudo pacman -U /var/cache/pacman/pkg/kirigami-6.30.0-1-x86_64.pkg.tar.zst
#
# [CHANGE: claude-code | 2026-10-10] Rebased to 6.30.0 (patch applies unchanged).
# 6.28 -> 6.30 silently reverted the fork; /etc/pacman.d/hooks/luminos-kirigami.hook
# (source: config/pacman-hooks/) now warns loudly when stock kirigami replaces it.
#
# The patch does NOT change any default. It only lets three compiled-in
# constants be overridden by environment variables, which is otherwise
# impossible — Kirigami exposes them as read-only QML properties and reads no
# config file. With the environment unset the package behaves exactly like
# stock. Live values are set in /etc/environment.
#
# [CHANGE: claude-code | 2026-10-11] DECISION 140 (Phase 3) — pkgrel 1.2 adds
# kirigami-luminos-icondisc.patch: IconTitleSubtitle draws its icon inside a round
# Nexus "icon disc" (Theme.highlightColor; focusColor when selected). Only when
# an icon is present. QML is compiled in (qmldir prefer :/), so it needs this rebuild.
#
# [CHANGE: claude-code | 2026-10-12] DECISION 140 (Phase 4) — pkgrel 1.3 adds
# kirigami-luminos-formcards.patch: FormLayout renders Nexus connected card rows
# (label = title left, control right; fill-width controls stacked below; sections
# as small labels; no separator lines). Same rules for the new Kirigami.Form/FormGroup/
# FormEntry (flat style, e.g. Quick Settings). Public API unchanged.
# 1.4: a bare Separator also ends a card group; Form subtitles sit under the title;
# a lone untitled check box / switch uses its text as the row title.
# 1.5: icon-disc colour change is 120 ms, curve (0.2,0,0,1) — Shawn chose "Snappy" (DECISION 140 phase 5).
# 1.6: kirigami-luminos-viewheader.patch — InlineViewHeader is a section row (no band,
# no line, small grey title, actions right) over the Nexus list card.
# 1.7: kirigami-luminos-messages.patch — InlineMessage = tonal r16 info bar (4 tones,
# flat text actions, 180 ms slide-in); PlaceholderMessage = 56 px disc empty state.
# 1.8: Positive/Warning/Error fills derived from the tone hue (KF6 ignores Background* keys).

pkgname=kirigami
pkgver=6.30.0
pkgrel=1.8
pkgdesc='A QtQuick based components set'
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=(LGPL-2.0-only
         LGPL-3.0-only)
depends=(glibc
         libgomp
         libstdc++
         qt6-base
         qt6-declarative
         qt6-svg)
makedepends=(doxygen
             extra-cmake-modules
             qt6-shadertools
             qt6-tools)
groups=(kf6)
source=(https://download.kde.org/stable/frameworks/${pkgver%.*}/$pkgname-$pkgver.tar.xz{,.sig}
        kirigami-luminos-units.patch
        kirigami-luminos-icondisc.patch
        kirigami-luminos-formcards.patch
        kirigami-luminos-viewheader.patch
        kirigami-luminos-messages.patch)
sha256sums=('6de811e559c20dc1086c0cf2c34bb98712dbe4d45f960c62c3c3f887332c95f8'
            'SKIP'
            '992c86c174d4e2d5873d66dd9a6d86594e9883916e618d436dace6412c39e1b9'
            'd96d895b94fc97c6f7bf6b7a5d4b751a02716d0c632e947334367aec48550193'
            'a85ed70422ff8446a39bb5eb46a81b6636026284a1544310b6a103f78802ce9f'
            'ffc6e55fda91bb6bace79c23e679887c4821c7e70a7419fa077a48ccb7b9f29b'
            '3c4b5cda8df04a3ae5430da83b825dcdba8e13eba5ba6b126d5c9e3afb3096c3')
validpgpkeys=(53E6B47B45CEA3E0D5B7457758D0EE648A48B3BB  # David Faure <faure@kde.org>
              90A968ACA84537CC27B99EAF2C8DF587A6D4AAC1) # Nicolas Fella <nicolas.fella@kde.org>

prepare() {
  patch -p1 -d $pkgname-$pkgver < "$srcdir"/kirigami-luminos-units.patch
  patch -p1 -d $pkgname-$pkgver < "$srcdir"/kirigami-luminos-icondisc.patch
  patch -p1 -d $pkgname-$pkgver < "$srcdir"/kirigami-luminos-formcards.patch
  patch -p1 -d $pkgname-$pkgver < "$srcdir"/kirigami-luminos-viewheader.patch
  patch -p1 -d $pkgname-$pkgver < "$srcdir"/kirigami-luminos-messages.patch
}

build() {
  cmake -B build -S $pkgname-$pkgver \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}

