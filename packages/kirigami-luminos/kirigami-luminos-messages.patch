diff --git a/src/controls/InlineMessage.qml b/src/controls/InlineMessage.qml
index 04b5b29..0f4b14d 100644
--- a/src/controls/InlineMessage.qml
+++ b/src/controls/InlineMessage.qml
@@ -10,52 +10,62 @@ import QtQuick
 import org.kde.kirigami.controls as KC
 import org.kde.kirigami.platform as Platform
 import org.kde.kirigami.templates as KT
+import org.kde.kirigami.primitives as Primitives
 
 KT.InlineMessage {
     id: root
 
-    // a rectangle padded with anchors.margins is used to simulate a border
-    leftPadding: bgFillRect.anchors.leftMargin + Platform.Units.smallSpacing
-    topPadding: bgFillRect.anchors.topMargin + Platform.Units.smallSpacing
-    rightPadding: bgFillRect.anchors.rightMargin + Platform.Units.smallSpacing
-    bottomPadding: bgFillRect.anchors.bottomMargin + Platform.Units.smallSpacing
-
-    background: Rectangle {
-        id: bgBorderRect
-
-        color: switch (root.type) {
-            case KC.MessageType.Positive: return Platform.Theme.positiveTextColor;
-            case KC.MessageType.Warning: return Platform.Theme.neutralTextColor;
-            case KC.MessageType.Error: return Platform.Theme.negativeTextColor;
-            default: return Platform.Theme.activeTextColor;
+    // [CHANGE: claude-code | 2026-10-12] LUMINOS DECISION 140 (phase 6) — Nexus info bar:
+    // a tonal card (r16, no border), leading icon, text, flat text actions, round close.
+    // Information = Selection colours; Positive/Warning/Error = the colour scheme's
+    // Positive/Neutral/Negative background + text. Header/Footer bars keep the page's
+    // side margins and round only the corners facing the content.
+    readonly property bool lxHeader: position === KT.InlineMessage.Position.Header
+    readonly property bool lxFooter: position === KT.InlineMessage.Position.Footer
+    readonly property color lxBg: {
+        switch (root.type) {
+        // KF6 ignores Background{Positive,Neutral,Negative} and only tints lightly, and a
+        // tint of a pale text colour can never reach a saturated container — so derive an
+        // M3-like container from the tone's hue: saturation x0.45, lightness 0.22.
+        case KC.MessageType.Positive: return lxContainer(Platform.Theme.positiveTextColor);
+        case KC.MessageType.Warning: return lxContainer(Platform.Theme.neutralTextColor);
+        case KC.MessageType.Error: return lxContainer(Platform.Theme.negativeTextColor);
+        default: return Platform.Theme.highlightColor;
         }
-
-        radius: root.position === KT.InlineMessage.Position.Inline ? Platform.Units.cornerRadius : 0
-
-        Rectangle {
-            id: bgFillRect
-
-            anchors.fill: parent
-            anchors {
-                leftMargin: root.position === KT.InlineMessage.Position.Inline ? 1 : 0
-                topMargin: root.position === KT.InlineMessage.Position.Header ? 0 : 1
-                rightMargin: root.position === KT.InlineMessage.Position.Inline ? 1 : 0
-                bottomMargin: root.position === KT.InlineMessage.Position.Footer ? 0 : 1
-            }
-
-            color: Platform.Theme.backgroundColor
-
-            radius: bgBorderRect.radius * 0.60
+    }
+    function lxContainer(c: color): color {
+        return Qt.hsla(Math.max(0, c.hslHue), c.hslSaturation * 0.45, 0.22, 1);
+    }
+    readonly property color lxFg: {
+        switch (root.type) {
+        case KC.MessageType.Positive: return Platform.Theme.positiveTextColor;
+        case KC.MessageType.Warning: return Platform.Theme.neutralTextColor;
+        case KC.MessageType.Error: return Platform.Theme.negativeTextColor;
+        default: return Platform.Theme.highlightedTextColor;
         }
+    }
+    // Tone the text/icons of the content only (setting it on root would re-trigger lxFg).
+    Binding {
+        target: root.contentItem ? root.contentItem.Platform.Theme : null
+        property: "textColor"
+        value: root.lxFg
+    }
+    icon.color: lxFg
 
-        Rectangle {
-            anchors.fill: bgFillRect
-
-            color: bgBorderRect.color
-
-            opacity: 0.20
+    leftInset: lxHeader || lxFooter ? 12 : 0
+    rightInset: leftInset
+    leftPadding: leftInset + 10
+    rightPadding: rightInset + 10
+    topPadding: Math.max(10, (52 - (contentItem?.implicitHeight ?? 0)) / 2)
+    bottomPadding: topPadding
 
-            radius: bgFillRect.radius
+    background: Primitives.ShadowedRectangle {
+        color: root.lxBg
+        corners {
+            topLeftRadius: root.lxHeader ? 0 : 16
+            topRightRadius: root.lxHeader ? 0 : 16
+            bottomLeftRadius: root.lxFooter ? 0 : 16
+            bottomRightRadius: root.lxFooter ? 0 : 16
         }
     }
 }
