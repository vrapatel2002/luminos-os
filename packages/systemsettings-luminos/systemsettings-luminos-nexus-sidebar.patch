+                    implicitHeight: 44
+                    topLeftRadius: index === 0 ? 20 : 4; topRightRadius: topLeftRadius
+                    bottomLeftRadius: index === root.sections.length - 1 ? 20 : 4; bottomRightRadius: bottomLeftRadius
