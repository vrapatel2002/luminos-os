 #include <cmath>
 
+// [CHANGE: claude-code | 2026-10-11] Luminos Nexus "hole" (DECISION 140). The page (View colour)
+// sits in a 16 px rounded rect, 12 px in from the window edges, on the Window colour. Child
+// widgets (QQuickWidget KCMs) paint square, so this overlay repaints the four corners on top.
+static constexpr int LuminosHoleInset = 12;
+static constexpr qreal LuminosHoleRadius = 16;
+
+static QPainterPath luminosHoleCorners(const QRectF &r)
+{
+    QPainterPath outer;
+    outer.addRect(r);
+    QPainterPath inner;
+    inner.addRoundedRect(r, LuminosHoleRadius, LuminosHoleRadius);
+    return outer.subtracted(inner);
+}
+
+// QML KCMs: draw the page on View (the hole) instead of Window, drop the header strip's colour
+// and line, and give the page title the mock's 30 px. Kirigami.Theme.View == 0.
+static void luminosRestyleQmlKcm(QWidget *widget, bool lastTry)
+{
+    static bool warned = false;
+    auto warnOnce = [](const char *what) {
+        if (!warned) {
+            warned = true;
+            qWarning() << "luminos: KCM restyle skipped," << what << "not found (Kirigami internals changed?)";
+        }
+    };
+    auto qqw = qobject_cast<QQuickWidget *>(widget);
+    qqw = qqw ? qqw : widget->findChild<QQuickWidget *>();
+    QObject *root = qqw ? qqw->rootObject() : nullptr;
+    QObject *pageRow = root ? root->property("pageStack").value<QObject *>() : nullptr;
+    auto toolBar = pageRow ? pageRow->property("globalToolBar").value<QObject *>() : nullptr;
+    if (!toolBar) {
+        return warnOnce("pageStack.globalToolBar");
+    }
+    toolBar->setProperty("colorSet", 0);
+    toolBar->setProperty("separatorVisible", false);
+    QQmlListReference pages(pageRow, "items");
+    bool titled = false;
+    for (qsizetype i = 0; i < pages.count(); ++i) { // only the KCM's own top-level pages
+        QObject *page = pages.at(i);
+        QQmlProperty(page, QStringLiteral("Kirigami.Theme.colorSet"), qmlContext(root)).write(0);
+        QList<QQuickItem *> todo{page->property("globalToolBarItem").value<QQuickItem *>()};
+        while (!todo.isEmpty()) {
+            QQuickItem *o = todo.takeLast();
+            if (!o) {
+                continue;
+            }
+            todo << o->childItems();
+            if (QByteArray(o->metaObject()->className()).startsWith("Heading") && o->parentItem()
+                && QByteArray(o->parentItem()->metaObject()->className()).startsWith("DefaultPageTitleDelegate")) {
+                QFont f = o->property("font").value<QFont>();
+                f.setPixelSize(30);
+                f.setWeight(QFont::Normal);
+                o->setProperty("font", f);
+                titled = true;
+            }
+        }
+    }
+    if (lastTry && !titled && pages.count() > 0) {
+        warnOnce("DefaultPageTitleDelegate heading");
+    }
+}
+
+class LuminosHoleCorners : public QWidget
+{
+public:
+    explicit LuminosHoleCorners(QWidget *parent)
+        : QWidget(parent)
+    {
+        setAttribute(Qt::WA_TransparentForMouseEvents);
+        setAttribute(Qt::WA_NoSystemBackground);
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing);
+        p.fillPath(luminosHoleCorners(rect()), palette().color(QPalette::Window));
+    }
+};
