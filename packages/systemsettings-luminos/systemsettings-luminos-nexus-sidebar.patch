+QVariantList ModuleView::luminosSections() const
+{
+    KCModule *kcm = d->mPages.value(d->mPageWidget->currentPage());
+    auto qqw = kcm ? kcm->widget()->findChild<QQuickWidget *>() : nullptr;
+    QList<QQuickItem *> todo{qqw ? qqw->rootObject() : nullptr};
+    QVariantList out;
+    while (!todo.isEmpty()) {
+        QQuickItem *o = todo.takeLast();
+        if (o && o->isVisible()) {
+            todo << o->childItems();
+            if (QByteArray(o->metaObject()->className()).startsWith("Heading") && !o->property("text").toString().isEmpty()
+                && !QByteArray(o->parentItem()->metaObject()->className()).startsWith("DefaultPageTitleDelegate")) {
+                out << QVariant::fromValue<QObject *>(o);
+            }
+        }
+    }
+    std::sort(out.begin(), out.end(), [](const QVariant &a, const QVariant &b) {
+        return qvariant_cast<QQuickItem *>(a)->mapToScene({}).y() < qvariant_cast<QQuickItem *>(b)->mapToScene({}).y();
+    });
+    return out;
+}
+
+void ModuleView::paintEvent(QPaintEvent *)
+{
+    QPainter p(this);
+    p.setRenderHint(QPainter::Antialiasing);
+    p.fillRect(rect(), palette().color(QPalette::Window));
+    p.setPen(Qt::NoPen);
+    p.setBrush(palette().color(QPalette::Base));
+    p.drawRoundedRect(QRectF(rect().adjusted(4, LuminosHoleInset, -LuminosHoleInset, -LuminosHoleInset)), LuminosHoleRadius, LuminosHoleRadius);
+}
+
+void ModuleView::resizeEvent(QResizeEvent *event)
+{
+    QWidget::resizeEvent(event);
+    const QRect hole = rect().adjusted(4, LuminosHoleInset, -LuminosHoleInset, -LuminosHoleInset);
+    d->mHoleCorners->setGeometry(hole);
+    d->mHoleCorners->raise();
 }
 
