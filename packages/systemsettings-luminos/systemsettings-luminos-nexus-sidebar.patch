+// [CHANGE: claude-code | 2026-10-11] Luminos Nexus "hole" (DECISION 140). The page (View colour)
+// sits in a 16 px rounded rect, 12 px in from the window edges, on the Window colour. Child
+// widgets (QQuickWidget KCMs) paint square, so this overlay repaints the four corners on top.
+static constexpr int LuminosHoleInset = 12;
+static constexpr qreal LuminosHoleRadius = 16;
+
+// QML KCMs: page on View (the hole), no header strip colour/line, 30 px title. Kirigami.Theme.View == 0.
+static void luminosRestyleQmlKcm(QWidget *widget, bool lastTry)
+{
+    static bool warned = false; // fail loudly, once, if Kirigami internals change
+    auto qqw = qobject_cast<QQuickWidget *>(widget);
+    qqw = qqw ? qqw : widget->findChild<QQuickWidget *>();
+    QObject *root = qqw ? qqw->rootObject() : nullptr;
+    QObject *pageRow = root ? root->property("pageStack").value<QObject *>() : nullptr;
+    auto toolBar = pageRow ? pageRow->property("globalToolBar").value<QObject *>() : nullptr;
+    if (!toolBar) {
+        if (!std::exchange(warned, true)) qWarning() << "luminos: KCM restyle skipped, no pageStack.globalToolBar";
+        return;
+    }
+    toolBar->setProperty("colorSet", 0);
+    toolBar->setProperty("separatorVisible", false);
+    QQmlListReference pages(pageRow, "items");
+    bool titled = false;
+    for (qsizetype i = 0; i < pages.count(); ++i) { // only the KCM's own top-level pages
+        QObject *page = pages.at(i);
+        QQmlProperty(page, QStringLiteral("Kirigami.Theme.inherit"), qmlContext(root)).write(false);
+        QQmlProperty(page, QStringLiteral("Kirigami.Theme.colorSet"), qmlContext(root)).write(0);
+        auto pageItem = qobject_cast<QQuickItem *>(page);
+        QList<QQuickItem *> todo{page->property("globalToolBarItem").value<QQuickItem *>(), pageItem};
+        while (!todo.isEmpty()) {
+            QQuickItem *o = todo.takeLast();
+            if (!o) {
+                continue;
+            }
+            todo << o->childItems();
+            if (QByteArray(o->metaObject()->className()).startsWith("Separator") && pageItem
+                && (o->width() > pageItem->width() * 0.9 || QByteArray(o->parentItem()->metaObject()->className()) == "QQuickColumn")) {
+                o->setOpacity(0); // (not setVisible: its QML binding would re-show it) full-width structural lines (KCM header/footer/view edges): none in Nexus
+            } else if (QByteArray(o->metaObject()->className()).startsWith("Heading") && o->parentItem()
+                && QByteArray(o->parentItem()->metaObject()->className()).startsWith("DefaultPageTitleDelegate")) {
+                QFont f = o->property("font").value<QFont>();
+                f.setPixelSize(30);
+                f.setWeight(QFont::Normal);
+                o->setProperty("font", f);
+                titled = true;
+            }
+        }
+    }
+    if (lastTry && !titled && pages.count() > 0 && !std::exchange(warned, true)) {
+        qWarning() << "luminos: KCM title restyle skipped, no DefaultPageTitleDelegate heading";
+    }
+}
+
+class LuminosHoleCorners : public QWidget
+{
+public:
+    explicit LuminosHoleCorners(QWidget *parent, QWidget *footer)
+        : QWidget(parent)
+        , m_footer(footer)
+    {
+        setAttribute(Qt::WA_TransparentForMouseEvents);
+        setAttribute(Qt::WA_NoSystemBackground);
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing);
+        QPainterPath corners, hole;
+        corners.addRect(rect());
+        hole.addRoundedRect(QRectF(rect()), LuminosHoleRadius, LuminosHoleRadius);
+        p.fillPath(corners.subtracted(hole), palette().color(QPalette::Window));
+        // Breeze/Darkly draw a separator on top of every QDialogButtonBox: cover it with the hole colour
+        const QRect footer = m_footer->geometry().translated(-pos());
+        p.fillRect(QRect(footer.left(), footer.top(), footer.width(), 1), palette().color(QPalette::Base));
+    }
+    QWidget *m_footer;
+};
