+void SidebarMode::openEdgeDrawer(const QString &which)
+{
+    // One drawer at a time: "left" lives in the sidebar (Main.qml), "top"/"right" in d->drawers over the page.
+    QMetaObject::invokeMethod(d->quickWidget->rootObject(), "setDrawerOpen", Q_ARG(QVariant, which == QLatin1String("left")));
+    const QVariantList sections = which == QLatin1String("right") ? d->moduleView->luminosSections() : QVariantList();
+    QObject *root = d->drawers->rootObject();
+    if (!root) return;
+    root->setProperty("open", false);
+    d->drawers->setVisible(which == QLatin1String("top") || !sections.isEmpty());
+    if (!d->drawers->isVisible()) {
+        return;
+    }
+    const QRect r = d->moduleView->rect();
+    d->drawers->setGeometry(which == QLatin1String("top") ? QRect(r.center().x() - 280, 0, 560, std::min(r.height() - 12, 640))
+                                                          : QRect(r.width() - 304, 0, 304, r.height() - 12));
+    root->setProperty("sections", sections);
+    root->setProperty("kind", which);
+    root->setProperty("open", true);
+    d->drawers->raise();
+}
+
 bool SidebarMode::eventFilter(QObject *watched, QEvent *event)
 {
+    if (auto zone = qobject_cast<QWidget *>(watched); zone && d->zones.contains(zone)) {
+        const bool right = zone == d->zones[1];
+        if (event->type() == QEvent::Enter) {
+            openEdgeDrawer(zone->objectName());
+        } else if (event->type() == QEvent::Leave && d->drawers->isVisible()) {
+            QMetaObject::invokeMethod(d->drawers->rootObject(), "softClose");
+        } else if (event->type() == QEvent::Paint && !(right && d->moduleView->luminosSections().isEmpty())) {
+            QPainter p(zone); // the 4x56 hint line, outline colour at 35 % (90 % under the pointer)
+            p.setRenderHint(QPainter::Antialiasing);
+            QColor c = zone->palette().color(QPalette::Disabled, QPalette::WindowText);
+            c.setAlphaF(zone->underMouse() ? 0.9 : 0.35);
+            p.setPen(Qt::NoPen), p.setBrush(c);
+            p.drawRoundedRect(right ? QRectF(zone->width() - 8, zone->height() / 2.0 - 28, 4, 56) : QRectF(zone->width() / 2.0 - 28, 4, 56, 4), 2, 2);
+        }
+        return false;
+    }
+    if (watched == d->moduleView && event->type() == QEvent::Resize) {
+        d->zones[0]->setGeometry(120, 0, d->moduleView->width() - 260, 12);
+        d->zones[1]->setGeometry(d->moduleView->width() - 12, 52, 12, d->moduleView->height() - 104);
+        return false;
+    }
     if (watched != d->quickWidget && watched != d->mainWidget) {
         return QObject::eventFilter(watched, event);
     }
