# Luminos fork of systemsettings (maintained in ~/luminos-os).
# Based on Arch PKGBUILD by Felix Yan / Antonio Rojas (gitlab.archlinux.org/archlinux/packaging/packages/systemsettings).
#
# [CHANGE: claude-code | 2026-10-11] LUMINOS FORK — DECISION 140 (Phase 3 "the mockup, for real").
# Stock systemsettings plus one patch: the Nexus sidebar (search pill, grey category labels,
# two-line rows with icon discs + connected corners + selected pill, chevrons) and the page
# drawn in a rounded "hole" (View colour, r16, 12 px inset) on the Window colour, 30 px title.
# [CHANGE: claude-code | 2026-10-11] 1.2: review fixes (corner overlay raise, title font outside paint, top-level pages only, no corner anim while scrolling).
# [CHANGE: claude-code | 2026-10-12] 1.3: no sidebar/page separator, back pill, icon-tile sidebar in narrow windows, View on all top-level KCM pages.
# [CHANGE: claude-code | 2026-10-12] 1.4: no lines (sidebar edge, footer, KCM header/footer), hole drawn at its inset, KCM kept clear of the top corners.
# [CHANGE: claude-code | 2026-10-12] 1.5: Phase 5 edge drawers (left = all settings, top = search, right = on this page), one sidebar column, 180 ms motion.
# Do not "clean up" the pkgrel: 1.x sorts ABOVE the repo's 1. When upstream moves to a new
# pkgver the repo wins again; /etc/pacman.d/hooks/luminos-systemsettings.hook warns.
# QML is compiled into the binary (qt_add_qml_module), so editing files on disk does nothing.
#
#   Test aid: LUMINOS_SS_OPEN_DRAWER=left|top[:query]|right systemsettings  (opens that drawer once, 3 s after start)
#   Rebuild:  makepkg -si
#   Revert:   sudo pacman -U /var/cache/pacman/pkg/systemsettings-6.7.5-1-x86_64.pkg.tar.zst
#
# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Contributor: Andrea Scarpino <andrea@archlinux.org>

# [CHANGE: claude-code | 2026-11-08] pkgrel 1.7 — DECISION 176: systemsettings-luminos-tunables.patch swaps the look literals for live
# 1.8 (R6): search bar size/position, sidebar bottom gap, icon colour/size/nudge, bottom button bar margins (live, C++ watcher).
# 1.9 (R7): the menu (☰) button next to the search box can be hidden (showMenuButton).
# 1.10 (R8, BUG-232): drop hard-coded page minimum widths >= 600 px in QtWidgets KCMs (Wi-Fi overflowed sideways).
# 1.11: also re-checks late-built widgets (LayoutRequest filter), lets tab bars scroll, Wi-Fi list min 300 -> 240.
# org.luminos.style values (same defaults; ~/.config/luminos/style.json changes them live). Needs luminos-style.

pkgname=systemsettings
pkgver=6.7.5
_dirver=$(echo $pkgver | cut -d. -f1-3)
pkgrel=1.11
pkgdesc='KDE system manager for hardware, software, and workspaces'
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=(LGPL-2.0-or-later)
depends=(glibc
         plasma-activities
         kauth
         kcmutils
         kcolorscheme
         kconfig
         kconfigwidgets
         kcoreaddons
         kcrash
         kdbusaddons
         ki18n
         kio
         kirigami
         kitemmodels
         kitemviews
         kjobwidgets
         krunner
         kservice
         kwidgetsaddons
         kwindowsystem
         kxmlgui
         libstdc++
         qt6-base
         qt6-declarative
         luminos-style)
makedepends=(extra-cmake-modules
             kdoctools)
groups=(plasma)
source=(https://download.kde.org/stable/plasma/$_dirver/$pkgname-$pkgver.tar.xz{,.sig}
        systemsettings-luminos-nexus-sidebar.patch
        systemsettings-luminos-tunables.patch)
sha256sums=('317a21165709d61796fba19f5454397577ffd8aa96655b29dd286a1df252cddb'
            'SKIP'
            '3b89ce0d1c5005feb9554c11e4be2ad444b87d1f35673c35313223088b84129c'
            '6bf6b2db76046624e2ec8c9b1a585c75681cb2415651639b2dd11da84d4fb870')
validpgpkeys=('E0A3EB202F8E57528E13E72FD7574483BB57B18D'  # Jonathan Esk-Riddell <jr@jriddell.org>
              '0AAC775BB6437A8D9AF7A3ACFE0784117FBCE11D'  # Bhushan Shah <bshah@kde.org>
              'D07BD8662C56CB291B316EB2F5675605C74E02CF'  # David Edmundson <davidedmundson@kde.org>
              '1FA881591C26B276D7A5518EEAAF29B42A678C20') # Marco Martin <notmart@gmail.com>

prepare() {
  patch -p1 -d $pkgname-$pkgver < "$srcdir"/systemsettings-luminos-nexus-sidebar.patch
  patch -p1 -d $pkgname-$pkgver < "$srcdir"/systemsettings-luminos-tunables.patch  # DECISION 176: live style values (org.luminos.style)
}

build() {
  cmake -B build  -S $pkgname-$pkgver \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
