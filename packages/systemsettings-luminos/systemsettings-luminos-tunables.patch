+}
+// R8 (BUG-232): some QtWidgets KCMs hard-code a page minimum (Wi-Fi: KCMForm 800x500 in kcm.ui). Our sidebar
+// leaves ~690 px for the page, so the scroll area grew a sideways scrollbar and clipped the right side.
+// Drop only big fixed minimum widths (>= 600 px); real content minimums (tabs, lists, labels) stay.
+static void luminosFitWidth(QWidget *root)
+{
+    if (!root)
+        return;
+    QList<QWidget *> all = root->findChildren<QWidget *>();
+    all.prepend(root);
+    for (QWidget *w : std::as_const(all)) {
+        if (w->minimumWidth() >= 600 && !w->isWindow())
+            w->setMinimumWidth(0);
+        if (auto *tb = qobject_cast<QTabBar *>(w); tb && !tb->usesScrollButtons())
+            tb->setUsesScrollButtons(true); // tabs scroll instead of forcing the page wider
+        if (w->objectName() == QLatin1String("connectionView") && w->minimumWidth() > 240)
+            w->setMinimumWidth(240); // Wi-Fi list: upstream 300 px; 240 still fits names, frees room for the editor
+    }
+}
+// KCMs build and rebuild widgets long after load (Wi-Fi recreates its editor tabs per connection, each tab content
+// with setMinimumWidth(600)). A size change posts LayoutRequest up the tree, so re-check the open KCMs then, once per
+// event-loop turn. Only widgets that still have a >= 600 px minimum are touched, so a pass that finds none is cheap.
+class LuminosFitFilter : public QObject
+{
+public:
+    static LuminosFitFilter *self()
+    {
+        static LuminosFitFilter *f = [] { auto *x = new LuminosFitFilter; qApp->installEventFilter(x); return x; }();
+        return f;
+    }
+    void add(QWidget *root)
+    {
+        m_roots.append(root);
+        luminosFitWidth(root);
+    }
+protected:
+    bool eventFilter(QObject *o, QEvent *e) override
+    {
+        if (e->type() == QEvent::LayoutRequest && o->isWidgetType() && !m_pending) {
+            m_pending = true;
+            QTimer::singleShot(0, this, [this] {
+                m_pending = false;
+                m_roots.removeAll(nullptr);
+                for (const auto &r : std::as_const(m_roots))
+                    luminosFitWidth(r);
+            });
+        }
+        return false;
+    }
+private:
+    QList<QPointer<QWidget>> m_roots;
+    bool m_pending = false;
+};
