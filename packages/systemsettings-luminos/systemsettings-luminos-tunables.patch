+static int luminosStylePx(const char *key, int fallback)
+{
+    QFile f(QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) + QStringLiteral("/luminos/style.json"));
+    if (!f.open(QIODevice::ReadOnly))
+        return fallback;
+    const QJsonValue v = QJsonDocument::fromJson(f.readAll()).object().value(QLatin1String(key));
+    return v.isDouble() ? qBound(14, qRound(v.toDouble()), 60) : fallback;
+}
+// R6: bottom button bar margins. The base is what the code would set anyway; a key in the file overrides one side.
+static void luminosApplyButtons(QWidget *w)
+{
+    const QVariantList base = w->property("_lxBase").toList();
+    if (base.size() != 4)
+        return;
+    QJsonObject o;
+    QFile f(QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) + QStringLiteral("/luminos/style.json"));
+    if (f.open(QIODevice::ReadOnly))
+        o = QJsonDocument::fromJson(f.readAll()).object();
+    const char *keys[4] = {"buttonsLeftPx", "buttonsTopPx", "buttonsRightPx", "buttonsBottomPx"};
+    int m[4];
+    for (int i = 0; i < 4; ++i) {
+        const QJsonValue v = o.value(QLatin1String(keys[i]));
+        m[i] = v.isDouble() ? qBound(0, qRound(v.toDouble()), 96) : base.at(i).toInt();
+    }
+    w->setContentsMargins(m[0], m[1], m[2], m[3]);
+}
+static void luminosSetButtonBase(QWidget *w, const QMargins &b)
