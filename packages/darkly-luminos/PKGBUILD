# Luminos fork of darkly (maintained in ~/luminos-os).
# Based on the AUR darkly 0.5.40-1 PKGBUILD by DeltaCopy <7x0bb03yq@mozmail.com>
# (autogenerated from https://github.com/DeltaCopy/darkly-aur-ci).
#
# [CHANGE: claude-code | 2026-10-11] LUMINOS FORK (pkgrel 1.2: popups/alt rows stock, per-row neighbour cache) — DECISION 140 (Phase 3, Nexus insides for QtWidgets).
# [CHANGE: claude-code | 2026-10-12] pkgrel 1.3-1.5 — Phase 6 (docs/windowstyle/CONTRACTS.md): Dolphin/BUG-196, menus, tooltips, scroll bars.
# Stock AUR darkly plus one patch to the QStyle (kstyle/darklystyle.cpp only):
#   - item-view rows (QListView list mode / QTreeView): connected corners from model neighbours
#     (28 outer / 4 touching; group = same parent, split by KFilePlacesModel::GroupRole for
#     Dolphin's places sections), selected = 32 pill in Highlight, 2 px inset, hover = 8 % overlay.
#     Unselected rows are filled (Button tone) ONLY in Window-background/transparent views (sidebars/panels);
#     content views, combobox/completer popups and alternating rows stay stock unless selected/hovered.
#   - M3 slider: 16 px round track (active = focus colour, rest = Highlight), 4x36 bar handle, 5 px gaps.
#   - M3 radio: 2 px outline ring / filled focus-colour disc with a check.
#   - Phase 6 (1.3): Dolphin (KItemListWidget) = one Highlight pill over the full selection rect (r12 rows, r16 icon
#     tiles), hover 8 %, no focus underline (BUG-196 line), no alternate rows (AlternateBase transparent on its view+scene);
#     horizontal headers on the page colour with no band/lines (BUG-196 blob was Dolphin's narrow leading-padding section
#     hitting the rounded first-corner code), sorted label in Text, others WindowText; tree branches = chevrons only;
#     QMenu r16 on Button, 6 px padding, 40 px items, r10 Highlight hover, shortcuts in PlaceholderText, 1 px separators
#     inset 10; tooltips inverse (Text bg / Window text) r8, 6x10 padding; scroll bars 12 px: no track/arrows, 4 px pill
#     at 45 % PlaceholderText, 8 px at 75 % when hovered/dragged.
#   - 1.4: parentless QToolTip labels reach polish (upstream returned early for parentless QLabels, so real tooltips
#     kept ToolTipBase); scroll bar Sub/AddLine rects empty; open combo = field tone + 1 px focus ring, bottom r8.
#   - 1.5: Dolphin's current-but-unselected item gets a 2 px focus-colour outline (a11y); header look gated to
#     Dolphin's KItemListContainer viewport (QHeaderViews elsewhere stay stock); tooltip radius 8 always.
# No animations, no timers, no new deps. Do not "clean up" the pkgrel: 1.x sorts ABOVE the AUR's 1,
# so an AUR helper never silently reverts it; a new upstream pkgver will — the hook
# /etc/pacman.d/hooks/luminos-darkly.hook (source: config/pacman-hooks/) warns when that happens.
#
#   Rebuild:  makepkg -f && sudo pacman -U darkly-*.pkg.tar.zst
#   Revert:   build the AUR darkly (pkgrel 1) and pacman -U it

pkgname="darkly"
_gitname="Darkly"
pkgver=0.5.40
pkgrel=1.5
pkgdesc="Fork of Lightly (A modern style for Qt applications) - Luminos Nexus rows/slider/radio/menus/tooltips/scrollbars"
url="https://github.com/Bali10050/darkly"
arch=('x86_64' 'aarch64')
license=("GPL-2.0-or-later")
build_dir="build_kf6"

makedepends=(
  'cmake'
  'extra-cmake-modules'
)

options=(!emptydirs)

source=(
    "${url}/archive/refs/tags/v${pkgver}.tar.gz"
    "darkly-luminos-nexus.patch"
)

sha256sums=(
  '0c171ef2f3c2f7c5d1888a5ad232b47a53d772544cf5149142ebe94406c42a8e'
  'eeaaaa6ebc543375442fdb02b5333a934f9aae993e45380557560a16a6fa3801'
)

depends=(
  'kdecoration'
  'qt6-declarative'
  'kcoreaddons'
  'kcmutils'
  'kcolorscheme'
  'kconfig'
  'kguiaddons'
  'kiconthemes'
  'kwindowsystem'
  'frameworkintegration'
  'libplasma'
)

prepare() {
  patch -p1 -d "$_gitname-${pkgver}" < "$srcdir"/darkly-luminos-nexus.patch
}

build() (
  local cmake_options=(
    -B $build_dir
    -S "$_gitname-${pkgver}"
    -DBUILD_TESTING=OFF
    -DBUILD_QT6=ON
    -DBUILD_QT5=OFF
    -Wno-author
  )

  cmake "${cmake_options[@]}"
  cmake --build $build_dir
)

package() (
  DESTDIR="$pkgdir" cmake --install $build_dir
  rm -rf "$pkgdir/usr/lib/cmake"
)
