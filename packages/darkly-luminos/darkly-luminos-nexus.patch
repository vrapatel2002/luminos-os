+// [LUMINOS] DECISION 140 (Phase 3): Nexus rows, M3 slider, M3 radio. Logical px, no animation.
+namespace
+{
+constexpr int LumRowOuter = 28, LumRowInner = 4, LumRowPill = 32, LumRowInset = 2;
+constexpr int LumTrack = 16, LumBar = LumTrack + 20, LumGap = 5;
+constexpr int LumGroupRole = 0x0a5b64ee; // KFilePlacesModel::GroupRole (Dolphin places sections)
+
+QPainterPath lumRoundRect(const QRectF &r, qreal tl, qreal tr, qreal br, qreal bl)
+{
+    const qreal m = qMin(r.width(), r.height()) / 2;
+    tl = qMin(tl, m), tr = qMin(tr, m), br = qMin(br, m), bl = qMin(bl, m);
+    QPainterPath p;
+    p.moveTo(r.left() + tl, r.top());
+    p.arcTo(r.right() - 2 * tr, r.top(), 2 * tr, 2 * tr, 90, -90);
+    p.arcTo(r.right() - 2 * br, r.bottom() - 2 * br, 2 * br, 2 * br, 0, -90);
+    p.arcTo(r.left(), r.bottom() - 2 * bl, 2 * bl, 2 * bl, 270, -90);
+    p.arcTo(r.left(), r.top(), 2 * tl, 2 * tl, 180, -90);
+    p.closeSubpath();
+    return p;
+}
+
+// is the visually adjacent row (step -1 above, +1 below) in the same group as index?
+bool lumNeighbour(const QModelIndex &index, int step, const QAbstractItemView *view)
+{
+    const QModelIndex idx = index.siblingAtColumn(0);
+    const QVariant group = idx.data(LumGroupRole);
+    if (const auto tree = qobject_cast<const QTreeView *>(view)) {
+        const QModelIndex n = step < 0 ? tree->indexAbove(idx) : tree->indexBelow(idx);
+        return n.isValid() && n.parent() == idx.parent() && n.data(LumGroupRole) == group;
+    }
+    const auto list = qobject_cast<const QListView *>(view);
+    for (int r = idx.row() + step; r >= 0 && r < idx.model()->rowCount(idx.parent()); r += step) {
+        if (!list->isRowHidden(r))
+            return idx.model()->index(r, 0, idx.parent()).data(LumGroupRole) == group;
+    }
+    return false;
+}
+}
