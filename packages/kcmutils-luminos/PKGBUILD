# Maintainer: Felix Yan <felixonmars@archlinux.org>
#
# [CHANGE: claude-code | 2026-10-12] LUMINOS FORK — DECISION 140.
# Arch's stock kcmutils PKGBUILD (tag 6.30.0-1) plus kcmutils-luminos-listcard.patch:
# ScrollViewKCM puts the page's main list on a Nexus card (View alternateBackground,
# r28 clamped) in the same ~760 px column as the form cards, over the page "hole";
# AbstractKCM draws no header/footer separator lines. pkgrel 1.1 sorts above the
# repo's 1; /etc/pacman.d/hooks/luminos-kcmutils.hook warns when stock returns.
# QML is compiled in (qmldir prefer :/), so on-disk QML edits do nothing.
#
#   Rebuild:  makepkg -f && sudo pacman -U kcmutils-*-1.N-*.pkg.tar.zst
#   Revert:   sudo pacman -U /var/cache/pacman/pkg/kcmutils-6.30.0-1-x86_64.pkg.tar.zst
# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Contributor: Andrea Scarpino <andrea@archlinux.org>

# [CHANGE: claude-code | 2026-11-08] pkgrel 1.2 — DECISION 176: kcmutils-luminos-tunables.patch swaps the look literals for live
# org.luminos.style values (same defaults; ~/.config/luminos/style.json changes them live). Needs luminos-style.

pkgname=kcmutils
pkgver=6.30.0
# [CHANGE: claude-code | 2026-11-10] pkgrel 1.5 — R27: page lists sit 8 px inside their card and are cut to their card's rounded shape (no square rows poking out).
# [CHANGE: claude-code | 2026-11-13] pkgrel 1.7 — R30: gap under the page title when a list has a header; list scroll bar runs beside the rows only.
pkgrel=1.7
pkgdesc='Utilities for interacting with KCModules'
arch=(x86_64)
url='https://develop.kde.org/products/frameworks/'
license=(LGPL-2.0-only LGPL-3.0-only)
depends=(libstdc++
         glibc
         kconfig
         kconfigwidgets
         kcoreaddons
         kguiaddons
         ki18n
         kio
         kirigami
         kitemviews
         kservice
         kwidgetsaddons
         kxmlgui
         qt6-base
         qt6-declarative
         luminos-style)
makedepends=(doxygen
             extra-cmake-modules
             qt6-tools)
groups=(kf6)
source=(https://download.kde.org/stable/frameworks/${pkgver%.*}/$pkgname-$pkgver.tar.xz{,.sig}
        kcmutils-luminos-listcard.patch
        kcmutils-luminos-tunables.patch
        kcmutils-luminos-listmask.patch)
sha256sums=('0159f80d030ac250b0b353113a55c013ed7e38cb0b678df44d2f0d0b2aca944c'
            'SKIP'
            'b41e2498b4d570e4b36987f8bac2c0c89b1a3965016ecd5488e74ca1f89d2b43'
            'e29e2fe4234f6dbc40ddb9fa36d1a18aa41b33cb6841c2ccb84feeae1e292bb4'
            '965b6ec0cd2eadd5c53b1134d51123124088f119b2c212fccd63dce590765b79')
validpgpkeys=(53E6B47B45CEA3E0D5B7457758D0EE648A48B3BB # David Faure <faure@kde.org>
              90A968ACA84537CC27B99EAF2C8DF587A6D4AAC1 # Nicolas Fella <nicolas.fella@kde.org>
              )

prepare() {
  patch -p1 -d $pkgname-$pkgver < "$srcdir"/kcmutils-luminos-listcard.patch
  patch -p1 -d $pkgname-$pkgver < "$srcdir"/kcmutils-luminos-tunables.patch  # DECISION 176: live style values (org.luminos.style)
  patch -p1 -d $pkgname-$pkgver < "$srcdir"/kcmutils-luminos-listmask.patch  # R27: list cut to the card's rounded shape
}

build() {
  cmake -B build -S $pkgname-$pkgver \
    -DBUILD_TESTING=OFF \
    -DCMAKE_INSTALL_LIBEXECDIR=lib
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
