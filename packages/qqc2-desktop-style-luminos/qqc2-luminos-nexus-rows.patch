new file mode 100644
index 0000000..8a05a6b
--- /dev/null
+++ b/org.kde.desktop/private/M3RadioIndicator.qml
@@ -0,0 +1,61 @@
+/*
+    SPDX-FileCopyrightText: 2026 Luminos
+    SPDX-License-Identifier: LGPL-3.0-only OR GPL-2.0-or-later
+*/
+// [CHANGE: luminos | 2026-10-11] DECISION 140 — Nexus radio: 2 px outline circle; checked = filled primary with a check.
+import QtQuick
+import QtQuick.Shapes
+import QtQuick.Templates as T
+import org.kde.kirigami as Kirigami
+
+Rectangle {
+    id: indicator
+    property T.AbstractButton control
+    property bool drawIcon: false // kept for API parity with CheckIndicator (ignored)
+    // the label code in RadioButton.qml asks the indicator for these style metrics
+    function pixelMetric(name: string): int {
+        return name === "exclusiveindicatorwidth" ? width : name === "radiobuttonlabelspacing" ? Kirigami.Units.mediumSpacing : 0
+    }
+
+    implicitWidth: 24
+    implicitHeight: 24
+    radius: width / 2
+    color: control.checked ? Kirigami.Theme.focusColor : "transparent"
+    border.width: control.checked ? 0 : 2
+    border.color: control.hovered || control.visualFocus ? Kirigami.Theme.textColor : Kirigami.Theme.disabledTextColor
+    opacity: control.enabled ? 1 : 0.38
+    Behavior on color { ColorAnimation { duration: 120; easing.type: Easing.BezierSpline; easing.bezierCurve: [0.2, 0, 0, 1, 1, 1] } }
+
+    Rectangle { // hover / press state layer, M3 40 px circle
+        anchors.centerIn: parent
+        width: 40; height: 40; radius: 20
+        color: Kirigami.Theme.textColor
+        opacity: indicator.control.down ? 0.10 : indicator.control.hovered ? 0.08 : 0
+    }
+    Rectangle { // keyboard focus ring
+        anchors.fill: parent
+        anchors.margins: -3
+        radius: width / 2
+        visible: indicator.control.visualFocus
+        color: "transparent"
+        border.width: 2
+        border.color: Kirigami.Theme.focusColor
+    }
+    Shape { // check glyph on a 24-unit grid, drawn in onPrimary
+        anchors.centerIn: parent
+        width: 24; height: 24
+        scale: indicator.control.checked ? indicator.width / 24 * 0.8 : 0.3
+        opacity: indicator.control.checked ? 1 : 0
+        preferredRendererType: Shape.CurveRenderer
+        Behavior on scale { NumberAnimation { duration: 180; easing.type: Easing.BezierSpline; easing.bezierCurve: [0.2, 0, 0, 1, 1, 1] } }
+        Behavior on opacity { NumberAnimation { duration: 120 } }
+        ShapePath {
+            strokeColor: Qt.hsla(Kirigami.Theme.focusColor.hslHue, Kirigami.Theme.focusColor.hslSaturation * 0.4, Kirigami.Theme.focusColor.hslLightness > 0.5 ? 0.27 : 1.0, 1)
+            strokeWidth: 2.6
+            fillColor: "transparent"
+            capStyle: ShapePath.RoundCap
+            joinStyle: ShapePath.RoundJoin
+            PathSvg { path: "M6.5 12.5 L10.5 16.5 L17.5 8.5" }
+        }
+    }
+}
