#!/usr/bin/env python3
"""What is installed, as one JSON line the settings gallery can render.

[CHANGE: claude-code | 2026-09-19] SPEC §3.3, CONTRACTS §5, DECISION 123.
SPDX-License-Identifier: GPL-3.0-or-later

    luminos-wallpaper-gallery            -> [ {...}, ... ]
    luminos-wallpaper-gallery --plugin-mtime -> 1789936000   (epoch seconds)

`--plugin-mtime` is how the settings page finds out it is stale. A separate
invocation rather than an extra field, so a page running the OLD cached QML keeps
parsing the list exactly as it did — the one thing that must not break is the
page that is already broken. [CHANGE: claude-code | 2026-09-20] BUG-185.

Split from luminos-wallpaper-install on purpose: installing is the write side and
this is the read side, and only this one is called from QML — on every open of the
settings dialog, by a Plasma config page that must never be able to modify anything.

Each row carries absolute paths and an honest `playable`. A package we cannot show
yet is listed with `playable: false` and a reason rather than hidden, because a
Lively wallpaper that silently disappears after importing looks like a failed
import (CONTRACTS §5: import, mark unsupported, do not pretend).
"""
import json, os, sys

ROOT = os.path.expanduser("~/.local/share/luminos/wallpapers")
MANIFEST = "luminos-wallpaper.json"
# What the wallpaper can actually show today. `producer` is SPEC §3.6.
# `web` is here because web mode EXISTS today — it is the Chromium path SPEC §3.6
# is meant to replace, but a Lively web wallpaper runs on it right now and
# pretending otherwise would grey out most of their library. BUG-181.
PLAYABLE = {"scene", "shader", "js", "video", "image", "gif", "web"}


def describe(pkg_dir):
    """One gallery row: the manifest, plus absolute paths and why-not."""
    with open(os.path.join(pkg_dir, MANIFEST), encoding="utf-8-sig") as f:
        m = json.load(f)
    entry = os.path.join(pkg_dir, m.get("entry", ""))
    preview = m.get("preview")
    m["dir"] = pkg_dir
    m["entryPath"] = entry
    m["previewPath"] = os.path.join(pkg_dir, preview) if preview else ""
    if not os.path.isfile(entry):
        m["playable"], m["why"] = False, "its entry file is missing"
    elif m.get("type") not in PLAYABLE:
        m["playable"] = False
        m["why"] = ("%s wallpapers need the external producer, which is not built yet "
                    "(SPEC §3.6)" % m.get("type"))
    else:
        m["playable"], m["why"] = True, ""
    return m


def plugin_mtime():
    """Newest mtime under the plugin's contents/, in epoch seconds.

    QQmlEngine caches compiled components for the life of the engine, so a
    settings page keeps running the QML it loaded at startup no matter what lands
    on disk afterwards (BUG-171, three times now). The page cannot see this about
    itself — but it knows when IT started, and this says when the FILES were last
    written, and comparing the two is the whole test.
    """
    here = os.path.dirname(os.path.abspath(__file__))
    contents = os.path.dirname(here)
    newest = 0.0
    for base, _dirs, files in os.walk(contents):
        for name in files:
            try:
                newest = max(newest, os.path.getmtime(os.path.join(base, name)))
            except OSError:
                continue
    return int(newest)


def installed():
    if not os.path.isdir(ROOT):
        return []
    out = []
    for name in sorted(os.listdir(ROOT)):
        d = os.path.join(ROOT, name)
        if not os.path.isfile(os.path.join(d, MANIFEST)):
            continue
        try:
            out.append(describe(d))
        except (OSError, ValueError):
            continue          # one broken package never empties the gallery
    return out


if __name__ == "__main__":
    if "--plugin-mtime" in sys.argv[1:]:
        print(plugin_mtime())
    else:
        print(json.dumps(installed()))
    sys.exit(0)
