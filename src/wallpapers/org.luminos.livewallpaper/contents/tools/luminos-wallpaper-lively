#!/usr/bin/env python3
"""Import Lively's own `LivelyInfo.json`, unmodified, into our manifest shape.

[CHANGE: claude-code | 2026-09-19] SPEC §3.3, CONTRACTS §5, BUG-181.
SPDX-License-Identifier: GPL-3.0-or-later

Its own file because it tracks an EXTERNAL project's enum, which changes on
someone else's schedule, and because carrying it kept luminos-wallpaper-pkg over
SPEC §9's 150 lines. The type table below is transcribed from Lively's source
(src/Lively/Lively.Models/Enums/WallpaperType.cs) rather than guessed — the table
it replaces was invented and every one of its entries was wrong.
"""
# Lively's WallpaperType enum IN ITS OWN ORDER, read from its source and mapped
# to ours. Order matters: Lively writes Type as the enum INDEX. The map this
# replaced was invented and every entry was wrong — see BUG-181.
# [CHANGE: claude-code | 2026-09-19]
_LIVELY_TYPE_MAP = {
    "app": "producer", "web": "web", "webaudio": "web", "url": "web",
    "bizhawk": "producer", "unity": "producer", "godot": "producer",
    "video": "video", "gif": "gif", "unityaudio": "producer",
    "videostream": "video", "picture": "image",
}
_LIVELY_ORDER = list(_LIVELY_TYPE_MAP)


def lively_type_name(raw):
    """Older Lively files write Type as the enum index, newer ones as the name."""
    if isinstance(raw, bool):
        return None
    if isinstance(raw, int) and 0 <= raw < len(_LIVELY_ORDER):
        return _LIVELY_ORDER[raw]
    if isinstance(raw, str) and raw.strip().lower() in _LIVELY_TYPE_MAP:
        return raw.strip().lower()
    return None


def lively_to_manifest(info: dict, pkg_id: str) -> dict:
    manifest: dict = {"id": pkg_id, "source": "lively"}
    try:
        manifest["title"] = info.get("Title") or "Untitled"
        name = lively_type_name(info.get("Type"))
        if name is not None:
            manifest["type"] = _LIVELY_TYPE_MAP[name]
            manifest["livelyType"] = name
        else:
            manifest["type"] = "unknown"
            manifest["unsupported"] = True
        for src, dst in [("Author", "author"), ("FileName", "entry"), ("Arguments", "args")]:
            val = info.get(src)
            if val is not None:
                manifest[dst] = val
        preview = info.get("Thumbnail") or info.get("Preview")
        if preview is not None:
            manifest["preview"] = preview
    except Exception:
        manifest.setdefault("title", "Untitled")
        manifest.setdefault("type", "unknown")
        manifest["unsupported"] = True
    return manifest



# ---------------------------------------------------------------------------
# LivelyProperties.json -> our properties schema.  BUG-183.
# [CHANGE: claude-code | 2026-09-20]
#
# Transcribed from src/Lively/Lively.Models/LivelyControls/*.cs — the same rule
# BUG-181 taught: read the other project's source, never guess its vocabulary.
# Lively's own player skips `button` and `label` when it restores properties
# (Lively.Common/Helpers/LivelyPropertyUtil.cs: "user interaction only"), so the
# bridge in QML skips them too; they are kept here because the settings panel
# still draws them.
_LIVELY_CONTROL_MAP = {
    "slider": "slider", "dropdown": "dropdown", "scalerdropdown": "dropdown",
    "folderdropdown": "dropdown", "checkbox": "checkbox", "textbox": "textbox",
    "color": "color", "button": "button", "label": "label",
}
_LIVELY_PASSTHROUGH = ("min", "max", "step", "items", "help")


def _folder_control(entry, out, listdir):
    """folderDropdown: items live in a folder on disk, and the value Lively sends
    the page is `folder/file` — not the index our dropdown stores. The folder is
    recorded so ui/LivelyApi.qml can rebuild that path."""
    folder = entry.get("folder")
    items = []
    if folder and listdir is not None:
        try:
            items = sorted(listdir(folder))
        except Exception:
            items = []
    out["items"] = items
    out["livelyFolder"] = folder or ""
    chosen = entry.get("value")
    out["value"] = items.index(chosen) if chosen in items else 0
    return out


def lively_control_to_ours(entry, listdir=None):
    """One LivelyProperties.json control -> one of ours. None means skip it."""
    if not isinstance(entry, dict):
        return None
    kind = _LIVELY_CONTROL_MAP.get(str(entry.get("type", "")).strip().lower())
    if kind is None:
        return None
    out = {"type": kind, "value": entry.get("value")}
    if entry.get("text") is not None:
        out["label"] = entry["text"]
    for field in _LIVELY_PASSTHROUGH:
        if entry.get(field) is not None:
            out[field] = entry[field]
    if str(entry.get("type", "")).strip().lower() == "folderdropdown":
        return _folder_control(entry, out, listdir)
    return out


def lively_props_to_schema(raw, listdir=None):
    """A whole LivelyProperties.json. An unknown control is skipped, never fatal."""
    schema = {}
    if not isinstance(raw, dict):
        return schema
    for key, entry in raw.items():
        converted = lively_control_to_ours(entry, listdir)
        if converted is not None:
            schema[key] = converted
    return schema
