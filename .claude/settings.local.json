{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash -n scripts/luminos-verify)",
      "Bash(env -i PATH=/usr/local/bin:/usr/bin HOME=/home/shawn /bin/sh -c '/home/shawn/luminos-os/scripts/luminos-verify --mcp --quiet')",
