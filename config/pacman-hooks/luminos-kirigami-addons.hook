# [CHANGE: claude-code | 2026-10-11] DECISION 140 (Phase 3).
# Installed at /etc/pacman.d/hooks/luminos-kirigami-addons.hook. Warns when stock
# kirigami-addons replaces the Luminos fork (pkgrel -<n>.<m>), which would bring back
# the single bordered FormCard with dividers instead of Nexus ConnectedRects.
# This only WARNS; it changes nothing.
# Rebuild: cd ~/luminos-os/packages/kirigami-addons-luminos && bump pkgver/sha256 && makepkg -f
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = kirigami-addons

[Action]
Description = Checking kirigami-addons is still the Luminos-patched build (-1.x)...
When = PostTransaction
Exec = /usr/bin/bash -c 'v=$(pacman -Q kirigami-addons 2>/dev/null); case "$v" in *-[0-9].[0-9]|*-[0-9].[0-9][0-9]) echo "luminos: OK $v is the patched build";; *) printf "\n%s\n%s\n%s\n%s\n\n" "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" "!!! LUMINOS WARNING: kirigami-addons is now STOCK ($v), not the -1.x fork." "!!! FormCard pages are back to one bordered card with dividers (no ConnectedRects)." "!!! Rebuild ~/luminos-os/packages/kirigami-addons-luminos for the new pkgver (DECISION 140).";; esac; exit 0'
