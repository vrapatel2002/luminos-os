# [CHANGE: claude-code | 2026-11-09] DECISION 182 (Files redesign).
# Installed at /etc/pacman.d/hooks/luminos-dolphin.hook. When stock dolphin replaces
# the Luminos-patched build (pkgrel -<n>.<m>), the Luminos Files look silently goes
# back to the KDE look. This only WARNS; it changes nothing and never blocks the transaction.
# Rebuild: cd ~/luminos-os/packages/dolphin-luminos && bump pkgver/sha256 && makepkg -si
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = dolphin

[Action]
Description = Checking dolphin is still the Luminos-patched build (-<n>.<m>)...
When = PostTransaction
Exec = /usr/bin/bash -c 'v=$(pacman -Q dolphin 2>/dev/null); case "$v" in *-[0-9]*.[0-9]*) echo "luminos: OK $v is the patched build";; *) printf "\n%s\n%s\n%s\n\n" "!!! LUMINOS WARNING: dolphin is now STOCK ($v), not the -<n>.<m> fork." "!!! The Luminos Files look (sidebar discs, View panel, menus) is back to stock." "!!! Rebuild ~/luminos-os/packages/dolphin-luminos for the new pkgver (DECISION 182).";; esac; exit 0'
