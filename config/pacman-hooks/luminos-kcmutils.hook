# [CHANGE: claude-code | 2026-10-12] DECISION 140 (ScrollViewKCM list card).
# Installed at /etc/pacman.d/hooks/luminos-kcmutils.hook. Warns when stock
# kcmutils replaces the Luminos fork (pkgrel -<n>.<m>), which would bring back
# the full-width list band and separator lines instead of the Nexus list card.
# This only WARNS; it changes nothing.
# Rebuild: cd ~/luminos-os/packages/kcmutils-luminos && bump pkgver/sha256 && makepkg -f
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = kcmutils

[Action]
Description = Checking kcmutils is still the Luminos-patched build (-1.x)...
When = PostTransaction
Exec = /usr/bin/bash -c 'v=$(pacman -Q kcmutils 2>/dev/null); case "$v" in *-[0-9].[0-9]|*-[0-9].[0-9][0-9]) echo "luminos: OK $v is the patched build";; *) printf "\n%s\n%s\n%s\n%s\n\n" "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" "!!! LUMINOS WARNING: kcmutils is now STOCK ($v), not the -1.x fork." "!!! ScrollViewKCM lists are back to a full-width band with separator lines (no Nexus list card)." "!!! Rebuild ~/luminos-os/packages/kcmutils-luminos for the new pkgver (DECISION 140).";; esac; exit 0'
