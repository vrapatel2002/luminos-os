# [CHANGE: claude-code | 2026-10-12] DECISION 140 (phase 6: Keyboard empty states).
# Installed at /etc/pacman.d/hooks/luminos-plasma-desktop.hook. Warns when stock
# plasma-desktop replaces the Luminos fork (pkgrel -<n>.<m>), which would bring back
# the empty Keyboard Layouts box instead of the Nexus empty states.
# This only WARNS; it changes nothing.
# Rebuild: cd ~/luminos-os/packages/plasma-desktop-luminos && bump pkgver/sha256 && makepkg -f
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = plasma-desktop

[Action]
Description = Checking plasma-desktop is still the Luminos-patched build (-1.x)...
When = PostTransaction
Exec = /usr/bin/bash -c 'v=$(pacman -Q plasma-desktop 2>/dev/null); case "$v" in *-[0-9].[0-9]|*-[0-9].[0-9][0-9]) echo "luminos: OK $v is the patched build";; *) printf "\n%s\n%s\n%s\n%s\n\n" "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" "!!! LUMINOS WARNING: plasma-desktop is now STOCK ($v), not the -1.x fork." "!!! the Keyboard page Layouts list is back to an empty black box (no Nexus empty states)." "!!! Rebuild ~/luminos-os/packages/plasma-desktop-luminos for the new pkgver (DECISION 140).";; esac; exit 0'
