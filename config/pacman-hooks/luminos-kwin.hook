# [CHANGE: claude-code | 2026-11-12] DECISION 184 (Frosted overview box).
# Installed at /etc/pacman.d/hooks/luminos-kwin.hook. When stock kwin replaces
# the Luminos-patched build (pkgrel -<n>.<m>), the Frosted overview box silently goes
# back to the KDE look. This only WARNS; it changes nothing and never blocks the transaction.
# Rebuild: cd ~/luminos-os/packages/kwin-luminos && bump pkgver/sha256 && makepkg -si
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = kwin

[Action]
Description = Checking kwin is still the Luminos-patched build (-<n>.<m>)...
When = PostTransaction
Exec = /usr/bin/bash -c 'v=$(pacman -Q kwin 2>/dev/null); case "$v" in *-[0-9]*.[0-9]*) echo "luminos: OK $v is the patched build";; *) printf "\n%s\n%s\n%s\n\n" "!!! LUMINOS WARNING: kwin is now STOCK ($v), not the -<n>.<m> fork." "!!! The Frosted overview box (Meta+W) is back to stock." "!!! Rebuild ~/luminos-os/packages/kwin-luminos for the new pkgver (DECISION 184).";; esac; exit 0'
