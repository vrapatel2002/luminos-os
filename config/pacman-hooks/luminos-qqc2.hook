# [CHANGE: claude-code | 2026-10-10] DECISION 139 (Phase 2 switch).
# Installed at /etc/pacman.d/hooks/luminos-qqc2.hook. When stock qqc2-desktop-style replaces
# the Luminos-patched build (pkgrel 1.x), every Kirigami/QQC2 switch silently goes back to the
# KDE look. This only WARNS; it changes nothing and never blocks the transaction.
# Rebuild: cd ~/luminos-os/packages/qqc2-desktop-style-luminos && bump pkgver/sha256 && makepkg -si
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = qqc2-desktop-style

[Action]
Description = Checking qqc2-desktop-style is still the Luminos-patched build (-1.x)...
When = PostTransaction
Exec = /usr/bin/bash -c 'v=$(pacman -Q qqc2-desktop-style 2>/dev/null); case "$v" in *-1.[0-9]|*-1.[0-9][0-9]) echo "luminos: OK $v is the patched build";; *) printf "\n%s\n%s\n%s\n%s\n\n" "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" "!!! LUMINOS WARNING: qqc2-desktop-style is now STOCK ($v), not the -1.x fork." "!!! Kirigami/QQC2 switches are back to the KDE look, not the Material 3 (Nexus) switch." "!!! Rebuild ~/luminos-os/packages/qqc2-desktop-style-luminos for the new pkgver (DECISION 139).";; esac; exit 0'
