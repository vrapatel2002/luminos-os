# [CHANGE: claude-code | 2026-10-11] DECISION 140 (Phase 3, Darkly fork).
# Installed at /etc/pacman.d/hooks/luminos-darkly.hook. When a stock darkly (AUR pkgrel 1) replaces the
# Luminos-patched build (pkgrel 1.x), QtWidgets apps (Dolphin, Kate, Konsole) lose the Nexus rows,
# M3 slider and M3 radio. This only WARNS; it changes nothing and never blocks the transaction.
# Rebuild: cd ~/luminos-os/packages/darkly-luminos && bump pkgver/sha256 && makepkg -f && sudo pacman -U
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = darkly

[Action]
Description = Checking darkly is still the Luminos-patched build (-1.x)...
When = PostTransaction
Exec = /usr/bin/bash -c 'v=$(pacman -Q darkly 2>/dev/null); case "$v" in *-1.[0-9]|*-1.[0-9][0-9]) echo "luminos: OK $v is the patched build";; *) printf "\n%s\n%s\n%s\n%s\n\n" "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" "!!! LUMINOS WARNING: darkly is now STOCK ($v), not the -1.x fork." "!!! QtWidgets apps lost the Nexus rows / M3 slider / M3 radio." "!!! Rebuild ~/luminos-os/packages/darkly-luminos for the new pkgver (DECISION 140).";; esac; exit 0'
