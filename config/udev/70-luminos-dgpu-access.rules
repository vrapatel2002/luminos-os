# 70-luminos-dgpu-access.rules
# [CHANGE: claude-code | 2026-07-03] DECISION 25 — dGPU access gate (default-deny)
#
# The NVIDIA driver creates /dev/nvidia* world-open (0666), so ANY app can grab the
# discrete GPU with no permission check. This rule flips those nodes to root:dgpu 0660.
# User `shawn` is deliberately NOT a member of `dgpu`, so normal apps are denied and
# fall back to the AMD iGPU. Only apps launched through luminos-gpu-launch / dgpu-exec
# (setgid dgpu) get egid=dgpu and can open the dGPU.
#
# KILL SWITCH (instant restore of old world-open behavior):
#     sudo chmod 0666 /dev/nvidia*
# PERMANENT DISABLE:
#     sudo rm /etc/udev/rules.d/70-luminos-dgpu-access.rules && sudo udevadm control --reload
#
# Note: root-owned services (nvidia-powerd, luminos-power/Conductor) bypass DAC and are
# unaffected. Display is driven by the AMD iGPU, so the desktop does not need these nodes.

KERNEL=="nvidiactl",        GROUP="dgpu", MODE="0660"
KERNEL=="nvidia[0-9]*",     GROUP="dgpu", MODE="0660"
KERNEL=="nvidia-modeset",   GROUP="dgpu", MODE="0660"
KERNEL=="nvidia-uvm",       GROUP="dgpu", MODE="0660"
KERNEL=="nvidia-uvm-tools", GROUP="dgpu", MODE="0660"

# [CHANGE: claude-code | 2026-09-20] BUG-184 — the gate had a door nobody had tried.
#
# The rules above cover the NVIDIA driver's OWN nodes. They do not cover the DRM
# render node the same card exposes: /dev/dri/renderD128 (driver `nvidia`, the
# AMD 780M is renderD129) comes up 0666 root:render, so any process could open
# the discrete GPU through DRM without ever touching /dev/nvidia*. Chromium and
# Mesa both ENUMERATE every render node at startup, and enumerating this one is
# an open() on a card that is meant to be asleep.
#
# Matched by DRIVER rather than by node name: renderD128/129 are numbered in
# probe order, and pinning the NVIDIA rule to a number would silently move to
# the iGPU the day the probe order changes. This is a real device-model node
# (unlike /dev/nvidia*, which nvidia-modprobe mknod()s — see the DECISION 25
# amendment), so a udev rule genuinely fires for it.
#
# KILL SWITCH:  sudo chmod 0666 /dev/dri/renderD128
SUBSYSTEM=="drm", KERNEL=="renderD[0-9]*", DRIVERS=="nvidia", GROUP="dgpu", MODE="0660"
