[Desktop Entry]
# [CHANGE: claude-code | 2026-07-04] Collapse to the single dialog path — one
# "Run on GPU..." action that opens luminos-gpu-launch (the styled picker). The
# old direct AMD / NVIDIA actions (and luminos-nvidia-run) are gone; the picker
# is the one door to the dGPU.
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/x-executable;application/x-elf;application/x-sharedlib;
Actions=gpu_ask;
X-KDE-Priority=TopLevel

[Desktop Action gpu_ask]
Name=Run on GPU...
Icon=video-display
Exec=luminos-gpu-launch %f
