{
    "bar": {
        "workspaces": {
            "maxWindowIcons": 8,
            "showWindows": true
        }
    },
    "dashboard": {
        "showOnHover": true
    },
    "launcher": {
        "showOnHover": true,
        "useFuzzy": {
            "apps": false
        }
    },
    "session": {
        "commands": {
            "hibernate": [
                "systemctl",
                "suspend"
            ],
            "logout": [
                "qdbus6",
                "org.kde.Shutdown",
                "/Shutdown",
                "logout"
            ],
            "reboot": [
                "qdbus6",
                "org.kde.Shutdown",
                "/Shutdown",
                "logoutAndReboot"
            ],
            "shutdown": [
                "qdbus6",
                "org.kde.Shutdown",
                "/Shutdown",
                "logoutAndShutdown"
            ]
        },
        "icons": {
            "hibernate": "bedtime"
        }
    }
}
