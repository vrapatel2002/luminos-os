# uwsm environment, Hyprland session only — [CHANGE: claude-code | 2026-08-04]
#
# Belt-and-braces duplicate of the `env = AQ_DRM_DEVICES,...` line in hyprland.conf.
#
# Why both: hyprland.conf's `env` is applied by Hyprland itself while it parses its config, which
# is fine, but uwsm builds the session environment BEFORE the compositor is exec'd. Setting it
# here guarantees the variable is present no matter which one wins the race, and it also covers
# anything uwsm starts alongside the compositor.
#
# This file is sourced by uwsm ONLY for the Hyprland session, so it cannot affect the Plasma
# session in any way.
#
# ⚠️ DO NOT change this to a /dev/dri/by-path/... value. It looks more "correct" and it is what
# was here first, but it CRASHED THE SESSION — aquamarine splits AQ_DRM_DEVICES on ':' and PCI
# paths are full of colons, so the path was shredded into three nonexistent devices and the
# compositor aborted with "Found no gpus to use". See BUG-094.
#
# Also do not hardcode /dev/dri/card2: colon-free, but the number is enumeration order and the
# NVIDIA dGPU enumerates FIRST on this machine (card1), so a stale number would pin the
# compositor to the dGPU — the exact outcome the pinning exists to prevent.
#
# /dev/dri/luminos-igpu is a colon-free alias from /etc/udev/rules.d/99-luminos-gpu-alias.rules,
# matched on the PCI address. Stable AND parseable.
export AQ_DRM_DEVICES=/dev/dri/luminos-igpu
