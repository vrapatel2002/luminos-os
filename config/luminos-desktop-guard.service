# [CHANGE: claude-code | 2026-09-14] BUG-158
# Install to ~/.config/systemd/user/ and: systemctl --user enable luminos-desktop-guard
# Re-asserts the current KDE activity so the desktop containment (and with it the
# org.luminos.livewallpaper video) is placed on a screen at every login.
[Unit]
Description=Luminos desktop/activity guard (BUG-158 live wallpaper)
After=plasma-plasmashell.service
PartOf=plasma-workspace.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/luminos-desktop-guard
RemainAfterExit=yes

[Install]
WantedBy=plasma-workspace.target
