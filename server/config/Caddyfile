# --- Bazarr :8450 -------------------------------------------------------------
# [CHANGE: claude-code | 2026-09-13] DECISION 98.
# Gate from the header of this file was run before adding it: from 127.0.0.1 with no
# credentials, /api/system/status and /api/series both return 401, a wrong X-API-KEY
# returns 401, and the unauthenticated index does NOT contain the API key (grep -c = 0).
# Only the SPA shell is served anonymously; every data route demands the key or a session.
luminos-server.tail1fd435.ts.net:8450 {
	import tsname
	import proxy 6767
}
100.82.125.26:8450, 192.168.2.61:8450, 192.168.2.62:8450 {
	tls internal
	import proxy 6767
}

# --- Jellyfin plain-HTTP front :8095 (BUG-227 / DECISION 168) ----------------------------------------
# nftables redirects incoming tcp/8096 here (table inet luminos_jfshim), so the Roku/tablet/phone keep their
# saved http://<server>:8096 address. Jellyfin itself still listens on 8096 for loopback.
http://:8095 {
	import jellyfin
}

