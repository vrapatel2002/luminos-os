# The offline page deliberately carries NO Jellyfin API key. A key in a URL would
# be a permanent, non-expiring credential sitting in browser history and in any
# proxy log, and this process has no login of its own to hide it behind. Instead
# it hands you off to Jellyfin, where your own session is what authorises the
# download. That is also why there is no "download" button here: the hub cannot
# read Jellyfin's key database (luminoshub is not in the jellyfin group, on
# purpose), and giving it that access to save two taps is a bad trade.
#
# [CHANGE: claude-code | 2026-09-13] Rebuilt on the shared token set. This page
# is almost entirely typography, so it is the one place the type scale has to
# carry the whole design on its own.
OFFLINE = """<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#080706">
<meta name="color-scheme" content="dark">
<title>Take it with you</title>
<link rel="stylesheet" href="/app.css">
<!-- ROUTES: served at /offline on :443. It shares hub.js only to have the Jellyfin
     port filled in; there is nothing here to poll. -->
</head><body>
<div class="air"></div>
<div class="wrap">
 <a class="back" href="/">&larr; Luminos</a>

 <div class="top"><span class="mark">Luminos <em>/ Offline</em></span>
  <span class="clock">no live data on this page</span></div>

 <!-- No live data at all, so the type scale carries the whole screen alone. The
      display size here is the same one the hub uses for its rate, deliberately:
      one product, one voice, whether or not there is a number to print. -->
 <h1 class="title">TAKE IT<br><em>WITH YOU</em></h1>
 <p class="lede">Copy a film or an episode onto this phone <b>now</b>, so it plays
  later with no signal at all &mdash; a flight, a tunnel, a hotel with bad wifi.</p>

 <ol class="steps">
  <li><span class="h">Open it in Jellyfin</span>
   Use the button below, then find the film or episode and open its page.</li>
  <li><span class="h">Press the download arrow</span>
   On the item's page, beside Play. For a series, open a single
   <em>episode</em> &mdash; a whole season will not download as one piece.</li>
  <li><span class="h">Watch it from Downloads</span>
   In the Jellyfin app it lands under <b>Downloads</b> and plays with the network
   switched off. In a browser it saves as an ordinary video file &mdash; play that
   in VLC or mpv.</li>
 </ol>

 <a class="cta" data-port="__JF__" href="#">Open Jellyfin
  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><line x1="4" y1="12" x2="19" y2="12"/>
   <polyline points="13 6 19 12 13 18"/></svg></a>

 <p class="note"><b>Do it before you lose signal.</b> The file copies across the
  network while you wait; nothing downloads later on its own. A film is usually
  2&ndash;30 GB, so start it on wifi and give it time, and check the phone has room.</p>

 <p class="note">The server sends files in resumable pieces, so a connection that
  drops part-way picks up where it stopped instead of starting again.</p>

 <div class="foot"><span>works over the tailnet</span><span>you need not be home</span></div>
</div>
<script src="/lum.js"></script>
<script src="/app.js"></script>
</body></html>
"""


class Handler(BaseHTTPRequestHandler):
    server_version = "luminos-hub"

    def log_message(self, *a):
        pass

    # [CHANGE: claude-code | 2026-09-13] `cache` is a parameter now. Everything on this
    # site is no-store except the fonts, which are immutable content-addressed binaries
    # and the only thing worth letting a phone on mobile data keep.
    def _send(self, code, body, ctype, cache="no-store"):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Content-Security-Policy", CSP)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Cache-Control", cache)
        self.end_headers()
        self.wfile.write(body)

    def _send_file(self, path, ctype, cache):
        try:
            with open(path, "rb") as f:
                body = f.read()
        except OSError:
            return self._send(404, "not found", "text/plain")
        self._send(200, body, ctype, cache)

    def _send_art(self, path):
        # Five parts exactly: '', 'art', app, id, variant. Anything else is not a
        # request this route understands.
        parts = path.split("/")
        if len(parts) != 5 or parts[2] not in ART_DIRS or parts[4] not in ART_VARIANTS:
            return self._send(404, "not found", "text/plain")
        try:
            ident = int(parts[3])
        except ValueError:
            return self._send(404, "not found", "text/plain")
        if ident < 0:
            return self._send(404, "not found", "text/plain")
        self._send_file(f"{ART_DIRS[parts[2]]}/{ident}/{parts[4]}.jpg",
                        "image/jpeg", "private, max-age=3600")

    def _render(self, template):
        for token, app in (("__SEERR__", "jellyseerr"), ("__JF__", "jellyfin"),
                           ("__NZB__", "nzbget"), ("__SPACE__", "space"),
                           ("__RAD__", "radarr"), ("__SON__", "sonarr"),
                           ("__PROW__", "prowlarr"), ("__BAZ__", "bazarr")):
            template = template.replace(token, str(PUBLIC[app]))
        return template

    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        if path in ("/", "/index.html"):
            self._send(200, self._render(PAGE), "text/html; charset=utf-8")
        elif path in ("/offline", "/offline/"):
            self._send(200, self._render(OFFLINE), "text/html; charset=utf-8")
        elif path == "/api/summary":
            self._send(200, json.dumps(summary()), "application/json")
        elif path == "/healthz":
            self._send(200, "ok", "text/plain")
        elif path in STATIC:
            # no-store, not a max-age: a deploy has to be visible on the next pull
            # to refresh, and 40 KB over the LAN is not worth a cache-busting scheme.
            name, ctype = STATIC[path]
            self._send_file(f"{WEB_DIR}/{name}", ctype, "no-store")
        elif path.startswith("/fonts/") and path[7:] in FONTS:
            self._send_file(f"{FONT_DIR}/{path[7:]}", "font/woff2",
                            "public, max-age=31536000, immutable")
        elif path.startswith("/art/"):
            self._send_art(path)
        else:
            self._send(404, "not found", "text/plain")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=8100)
    ap.add_argument("--bind", default="127.0.0.1")
    a = ap.parse_args()
    srv = ThreadingHTTPServer((a.bind, a.port), Handler)
    print(f"luminos-hub on http://{a.bind}:{a.port}", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
