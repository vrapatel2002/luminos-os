   <a class="tile hero" id="l-seerr" href="#">
     <span class="ic">&#128269;</span><div class="nm">Find something to watch</div>
     <div class="ds">Search a film or show &rarr; it downloads itself</div></a>
   <a class="tile" id="l-jf" href="#"><span class="ic">&#127916;</span>
     <div class="nm">Watch</div><div class="ds">Jellyfin</div></a>
   <a class="tile" id="l-rad" href="#"><span class="ic">&#127909;</span>
     <div class="nm">Movies</div><div class="ds">Radarr</div></a>
