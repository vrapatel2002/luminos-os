#!/usr/bin/env python3
"""[CHANGE: claude-code | 2026-08-27]
One page that leads to everything else on the media server, built for a phone.

Why this exists rather than a page of bookmarks: the interesting numbers -- free
space, what is downloading, what arrived recently -- all live behind API keys.
A static HTML page would have to carry those keys in JavaScript, which hands them
to anything that can load the page. So this process holds the keys, talks to
Sonarr/Radarr/NZBGet itself, and serves the browser nothing but the answers.

It binds to 127.0.0.1 ONLY. It is reachable exclusively through Caddy, which
terminates TLS and is the single front door. Do not bind it to 0.0.0.0 -- it has
no authentication of its own, on purpose: everything it exposes is read-only
summary data, and the front door is what does the gating. Read-only and
unauthenticated are the same fact; if a write ever lands here, the second half
of that sentence stops being true and this file needs a door.

  luminos-hub                 # serve on 127.0.0.1:8100
  luminos-hub --port 8100

[CHANGE: claude-code | 2026-09-13] Rebuilt page. The markup, CSS and JS were
thrown away rather than restyled; the API knowledge above them was kept. CSS and
JS now live in real files served at /app.css and /app.js so the page can run
under a Content-Security-Policy with no 'unsafe-inline' -- see server/assets/web/.
"""
import argparse
import base64
import json
import os
import shutil
import subprocess
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

MEDIA = "/srv/media"
NZBGET_CONF = "/var/lib/nzbget/nzbget.conf"

# [CHANGE: claude-code | 2026-09-13] Self-hosted faces, served from /fonts.
# The names are a whitelist rather than a sanitised path join: the set never changes at
# runtime, and a whitelist makes directory traversal impossible by construction instead
# of relying on getting the escaping right. See server/assets/fonts/README.md.
FONT_DIR = "/usr/local/share/luminos/fonts"
FONTS = ("archivo-500.woff2", "archivo-800.woff2",
         "jetbrainsmono-400.woff2", "jetbrainsmono-800.woff2")

# [CHANGE: claude-code | 2026-09-13] The design system, on disk.
#
# luminos-hub answers on :443 and luminos-space on :8446. Those are different
# ORIGINS, so the two pages cannot share one <link> -- `style-src 'self'` would
# block the cross-origin fetch, and relaxing it to allow the other port would
# undo the point of having the policy. Both processes therefore serve the same
# bytes from the same file. Same whitelist shape as FONTS.
WEB_DIR = "/usr/local/share/luminos/web"
#
# [CHANGE: claude-code | 2026-09-15] Three scripts now, not one. lum.js is the
# shared half -- DOM helpers, keyed list rendering, number formatting -- and is
# byte-identical on both ports for the same reason app.css is. gl.js is the
# WebGL1 renderer for the two drives and is hub-only; it is hand-written rather
# than a vendored three.js, so `script-src 'self'` is untouched.
STATIC = {
    "/app.css": ("app.css", "text/css; charset=utf-8"),
    "/lum.js": ("lum.js", "application/javascript; charset=utf-8"),
    "/gl.js": ("gl.js", "application/javascript; charset=utf-8"),
    "/app.js": ("hub.js", "application/javascript; charset=utf-8"),
}

# [CHANGE: claude-code | 2026-09-13] Artwork, read off disk.
#
# The arrs already have every poster locally, but their own /MediaCover route
# 302s to /login without a session -- proxying it would mean putting an API key
# in the browser, which is exactly what this process exists to avoid. So the
# files are read directly. luminoshub is in the `media` group and the files are
# 0664, so no privilege change was needed.
#
# Both the app and the variant are membership tests against fixed tuples and the
# id goes through int(), so no part of the request reaches a path join as text.
# /art/../../etc/passwd fails at `".." not in ART_DIRS`, not at an escaping rule.
ART_DIRS = {
    "radarr": "/var/lib/radarr/MediaCover",
    "sonarr": "/var/lib/sonarr/MediaCover",
}
ART_VARIANTS = ("poster-250", "fanart-180")
ART_DEFAULT = "poster-250"

# [CHANGE: claude-code | 2026-09-13] Both disks, not just one.
#
# This used to call shutil.disk_usage(MEDIA) alone, so the 458 GB external was
# invisible and the page understated free space by roughly 400 GB. The shape is
# copied from luminos-space's live_disks(), ismount() guard included: without it
# an unmounted /srv/external reports the ROOT filesystem's figures and the page
# would cheerfully offer space that is not there.
#
# They are listed rather than pooled on purpose. DECISION 91: the external is a
# USB disk with no readable SMART, expected to fail without warning. One merged
# bar would say the two are interchangeable. They are not.
LIBRARY_DISKS = (
    # mountpoint, what to call it, whether it is the one that can vanish
    (MEDIA, "internal", False),
    ("/srv/external", "external", True),
)

# Ports Caddy publishes each service on. The host is taken from the request, so
# the same page works over the LAN address and the tailnet address without
# knowing which one the phone used.
#
# Every app gets its own port rather than a sub-path of this one. Sub-paths were
# tried and abandoned: Radarr/Sonarr/Prowlarr do have a urlBase setting, but it only
# rewrites the UI shell -- their login page stays at /login and their API stays at
# /api/ no matter what it is set to. Three apps all wanting /login on one hostname
# is a collision with no clean fix. Jellyfin, Jellyseerr and luminos-space emit
# root-absolute URLs and have no base-path setting at all. So: one port each.
PUBLIC = {
    "jellyfin": 8443,
    "jellyseerr": 8444,
    "nzbget": 8445,
    "space": 8446,
    "radarr": 8447,
    "sonarr": 8448,
    "prowlarr": 8449,
    "bazarr": 8450,
}

# [CHANGE: claude-code | 2026-09-13] No inline script, no inline style, no third
# party, nothing framed. default-src 'none' means anything added later has to be
# allowed deliberately rather than inheriting permission.
CSP = ("default-src 'none'; style-src 'self'; script-src 'self'; font-src 'self'; "
       "img-src 'self' data:; connect-src 'self'; form-action 'none'; "
       "frame-ancestors 'none'; base-uri 'none'")

_cache = {"at": 0.0, "data": None}
_lock = threading.Lock()


def _cfg_value(path, pattern):
    try:
        out = subprocess.run(["grep", "-oP", pattern, path],
                             capture_output=True, text=True, timeout=10)
        return out.stdout.strip().splitlines()[0] if out.stdout.strip() else ""
    except Exception:
        return ""


def api_key(app):
    return _cfg_value(f"/var/lib/{app}/config.xml", "(?<=<ApiKey>)[^<]+")


def arr(app, port, ver, path, timeout=8):
    # The API lives at the root even if urlBase is set -- urlBase only rewrites the
    # UI shell. Prowlarr is v1 while Radarr and Sonarr are v3; asking Prowlarr for v3
    # returns 404 with a perfectly valid key, which reads like an auth failure and
    # is not one.
    key = api_key(app)
    if not key:
        return None
    req = urllib.request.Request(f"http://127.0.0.1:{port}/api/{ver}/{path}",
                                 headers={"X-Api-Key": key})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or b"null")
    except Exception:
        return None


def nzbget_status():
    user = _cfg_value(NZBGET_CONF, r"^ControlUsername=\K.*")
    pw = _cfg_value(NZBGET_CONF, r"^ControlPassword=\K.*")
    if not user:
        return None
    auth = base64.b64encode(f"{user}:{pw}".encode()).decode()
    req = urllib.request.Request(
        "http://127.0.0.1:6789/jsonrpc",
        data=json.dumps({"method": "status"}).encode(),
        headers={"Authorization": f"Basic {auth}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=8) as r:
            return (json.loads(r.read()) or {}).get("result")
    except Exception:
        return None


def human(n):
    n = float(n or 0)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024:
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PB"


def live_disks():
    """Mounted library disks, deduplicated by device.

    The dedupe is not paranoia: if /srv/external is unmounted its directory sits
    on the root filesystem, which would otherwise be counted as a second drive.
    """
    seen, out = set(), []
    for root, name, risky in LIBRARY_DISKS:
        try:
            if not os.path.ismount(root):
                continue
            dev = os.stat(root).st_dev
        except OSError:
            continue
        if dev in seen:
            continue
        seen.add(dev)
        out.append((root, name, risky))
    return out


def art_url(app, ident):
    """A poster URL, but only if the file is really there.

    12 of the 16 ids in the arrs' MediaCover trees belong to titles with no files
    at all, and history rows can outlive the item they refer to. Checking here
    means the browser is never handed a URL that is going to 404.
    """
    if not isinstance(ident, int) or ident < 0 or app not in ART_DIRS:
        return None
    if os.path.exists(f"{ART_DIRS[app]}/{ident}/{ART_DEFAULT}.jpg"):
        return f"/art/{app}/{ident}/{ART_DEFAULT}"
    return None


def build_summary():
    # [CHANGE: claude-code | 2026-09-13] Raw byte counts alongside the formatted
    # strings. The page formats the raw numbers itself so a value can move between
    # polls instead of snapping; the strings are what make a curl of this endpoint
    # readable by a person.
    disks = []
    for root, name, risky in live_disks():
        total, used, free = shutil.disk_usage(root)
        disks.append({
            "name": name, "risky": risky,
            "total": total, "used": used, "free": free,
            "totalh": human(total), "usedh": human(used), "freeh": human(free),
        })

    queue = []
    for app, port, ver in (("radarr", 7878, "v3"), ("sonarr", 8989, "v3")):
        q = arr(app, port, ver, "queue?pageSize=50")
        for rec in (q or {}).get("records", []) or []:
            nbytes = rec.get("size") or 0
            left = rec.get("sizeleft") or 0
            status = str(rec.get("status") or "").lower()
            queue.append({
                "title": str(rec.get("title") or "?")[:300],
                "bytes": nbytes,
                "left": left,
                "pct": round(100 * (nbytes - left) / nbytes, 1) if nbytes else 0.0,
                "eta": rec.get("timeleft") or "",
                "held": status in ("paused", "delay"),
                "app": app,
            })

    # [CHANGE: claude-code | 2026-09-13] Grouped by title, and the [:70] truncation
    # is gone.
    #
    # The truncation fired on 125 of the 224 release names on this box and cut away
    # exactly the quality information that tells two releases of one episode apart.
    #
    # The grouping is the bigger change. A flat list of the last eight imports is
    # eight rows of the same series in a row, because that is how a season arrives.
    # Grouping turns those into one line that says what it is and how much of it
    # showed up. includeSeries/includeMovie give the real human title in the same
    # request, so this costs no extra API call -- and the newest release name is
    # still carried, underneath, where it does not shout.
    recent = []
    for app, port, id_key, obj_key, kind in (
            ("radarr", 7878, "movieId", "movie", "film"),
            ("sonarr", 8989, "seriesId", "series", "tv")):
        include = "includeMovie=true" if app == "radarr" else "includeSeries=true"
        hist = arr(app, port, "v3", "history?pageSize=25&sortKey=date"
                                    f"&sortDirection=descending&eventType=3&{include}")
        groups = {}
        for rec in (hist or {}).get("records", []) or []:
            ident = rec.get(id_key)
            if ident not in groups:
                # Records arrive newest-first, so the first one seen for an id is
                # the one whose date and release name should represent the group.
                obj = rec.get(obj_key) or {}
                groups[ident] = {
                    "title": str(obj.get("title") or rec.get("sourceTitle") or "?")[:120],
                    "kind": kind,
                    "when": rec.get("date") or "",
                    "last": str(rec.get("sourceTitle") or "")[:300],
                    "count": 0,
                    "art": art_url(app, ident),
                }
            groups[ident]["count"] += 1
        recent.extend(groups.values())
    recent.sort(key=lambda r: r["when"], reverse=True)

    ng = nzbget_status() or {}
    return {
        "disks": disks,
        "queue": queue[:8],
        "recent": recent[:6],
        "speed": int(ng.get("DownloadRate") or 0),
        "paused": bool(ng.get("DownloadPaused")),
        "at": time.strftime("%H:%M"),
    }


def summary():
    with _lock:
        if _cache["data"] and time.time() - _cache["at"] < 10:
            return _cache["data"]
    data = build_summary()
    with _lock:
        _cache["at"], _cache["data"] = time.time(), data
    return data


# [CHANGE: claude-code | 2026-09-13] The page, rebuilt from nothing.
#
# What it used to be: eight equal tiles in an auto-fit grid, each with an emoji,
# above two lists. Eight equal tiles say all eight matter equally, which is false
# -- one of them is where you actually watch things and three are administrative
# panels you open twice a year.
#
# What it is now, top to bottom: the one number that answers "is it doing
# anything", then how much room is left, then what is moving, then what arrived,
# then a way through to everything else. That last part is deliberately last and
# deliberately quiet.
#
# Every element the script writes into already exists here. The script sets
# .textContent and SVG geometry and never assembles markup, so a release name
# cannot become HTML no matter what it contains -- and every release name on this
# box was chosen by a stranger.
#
# Icons are inline SVG. No icon font and no emoji: emoji render as somebody
# else's artwork at somebody else's idea of the right colour, and change shape
# per phone.
PAGE = """<!doctype html>
