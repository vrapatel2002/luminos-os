<script>
// Built here rather than baked in, so the same page works whether the phone came
// in on the LAN address or the tailnet one.
const host = location.hostname;
function link(id, port){ document.getElementById(id).href = 'https://' + host + ':' + port + '/'; }
link('l-seerr','__SEERR__'); link('l-jf','__JF__');   link('l-nzb','__NZB__');
link('l-space','__SPACE__'); link('l-rad','__RAD__'); link('l-son','__SON__');
link('l-prow','__PROW__');

function esc(s){const d=document.createElement('div');d.textContent=s;return d.innerHTML}

async function load(){
  let d;
  try { d = await (await fetch('/api/summary',{cache:'no-store'})).json(); }
  catch(e){ document.getElementById('sub').textContent='server unreachable'; return; }

  document.getElementById('sub').textContent =
     d.paused ? 'downloads paused' : (d.speed==='idle' ? 'idle' : 'downloading ' + d.speed);
  document.getElementById('diskbar').style.width = d.disk.pct + '%';
  document.getElementById('diskused').textContent = d.disk.used + ' used';
  document.getElementById('diskfree').textContent = d.disk.free + ' free';
  document.getElementById('nzbds').textContent = d.paused ? 'paused' : d.speed;
  document.getElementById('at').textContent = d.at;

  const q = document.getElementById('queue');
  q.innerHTML = d.queue.length ? d.queue.map(function(r){
    return '<div class="card"><div class="t">'+esc(r.title)+'</div>'
         + '<div class="qbar"><i style="width:'+r.pct+'%"></i></div>'
         + '<div class="meta"><span>'+r.pct+'%</span><span>'+esc(r.size)+'</span>'
         + '<span>'+esc(r.eta)+'</span><span>'+esc(r.app)+'</span></div></div>';
  }).join('') : '<div class="empty">nothing downloading</div>';

  const c = document.getElementById('recent');
  c.innerHTML = d.recent.length ? d.recent.map(function(r){
    return '<div class="card"><div class="t">'+esc(r.title)+'</div>'
         + '<div class="meta"><span>'+esc(r.kind)+'</span><span>'+esc(r.when)+'</span></div></div>';
  }).join('') : '<div class="empty">nothing recent</div>';
}
load(); setInterval(load, 15000);
document.body.addEventListener('click', function(e){ if(e.target===document.body) load(); });
</script></body></html>"""


class Handler(BaseHTTPRequestHandler):
    server_version = "luminos-hub"

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        if path in ("/", "/index.html"):
            page = PAGE
            for token, app in (("__SEERR__", "jellyseerr"), ("__JF__", "jellyfin"),
                               ("__NZB__", "nzbget"), ("__SPACE__", "space"),
                               ("__RAD__", "radarr"), ("__SON__", "sonarr"),
                               ("__PROW__", "prowlarr")):
                page = page.replace(token, str(PUBLIC[app]))
            self._send(200, page, "text/html; charset=utf-8")
        elif path == "/api/summary":
            self._send(200, json.dumps(summary()), "application/json")
        elif path == "/healthz":
            self._send(200, "ok", "text/plain")
        else:
            self._send(404, "not found", "text/plain")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=8100)
    ap.add_argument("--bind", default="127.0.0.1")
    a = ap.parse_args()
    srv = ThreadingHTTPServer((a.bind, a.port), Handler)
    print(f"luminos-hub on http://{a.bind}:{a.port}", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
