#!/usr/bin/env python3
"""[CHANGE: claude-code | 2026-08-27]
One page that leads to everything else on the media server, built for a phone.

Why this exists rather than a page of bookmarks: the interesting numbers -- free
space, what is downloading, what arrived recently -- all live behind API keys.
A static HTML page would have to carry those keys in JavaScript, which hands them
to anything that can load the page. So this process holds the keys, talks to
Sonarr/Radarr/NZBGet itself, and serves the browser nothing but the answers.

It binds to 127.0.0.1 ONLY. It is reachable exclusively through Caddy, which
terminates TLS and is the single front door. Do not bind it to 0.0.0.0 -- it has
no authentication of its own, on purpose: everything it exposes is read-only
summary data, and the front door is what does the gating.

  luminos-hub                 # serve on 127.0.0.1:8100
  luminos-hub --port 8100
"""
import argparse
import base64
import json
import shutil
import subprocess
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

MEDIA = "/srv/media"
NZBGET_CONF = "/var/lib/nzbget/nzbget.conf"

# Ports Caddy publishes each service on. The host is taken from the request, so
# the same page works over the LAN address and the tailnet address without
# knowing which one the phone used.
#
# Every app gets its own port rather than a sub-path of this one. Sub-paths were
# tried and abandoned: Radarr/Sonarr/Prowlarr do have a urlBase setting, but it only
# rewrites the UI shell -- their login page stays at /login and their API stays at
# /api/ no matter what it is set to. Three apps all wanting /login on one hostname
# is a collision with no clean fix. Jellyfin, Jellyseerr and luminos-space emit
# root-absolute URLs and have no base-path setting at all. So: one port each.
PUBLIC = {
    "jellyfin": 8443,
    "jellyseerr": 8444,
    "nzbget": 8445,
    "space": 8446,
    "radarr": 8447,
    "sonarr": 8448,
    "prowlarr": 8449,
}

_cache = {"at": 0.0, "data": None}
_lock = threading.Lock()


def _cfg_value(path, pattern):
    try:
        out = subprocess.run(["grep", "-oP", pattern, path],
                             capture_output=True, text=True, timeout=10)
        return out.stdout.strip().splitlines()[0] if out.stdout.strip() else ""
    except Exception:
        return ""


def api_key(app):
    return _cfg_value(f"/var/lib/{app}/config.xml", "(?<=<ApiKey>)[^<]+")


def arr(app, port, ver, path, timeout=8):
    # The API lives at the root even if urlBase is set -- urlBase only rewrites the
    # UI shell. Prowlarr is v1 while Radarr and Sonarr are v3; asking Prowlarr for v3
    # returns 404 with a perfectly valid key, which reads like an auth failure and
    # is not one.
    key = api_key(app)
    if not key:
        return None
    req = urllib.request.Request(f"http://127.0.0.1:{port}/api/{ver}/{path}",
                                 headers={"X-Api-Key": key})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or b"null")
    except Exception:
        return None


def nzbget_status():
    user = _cfg_value(NZBGET_CONF, r"^ControlUsername=\K.*")
    pw = _cfg_value(NZBGET_CONF, r"^ControlPassword=\K.*")
    if not user:
        return None
    auth = base64.b64encode(f"{user}:{pw}".encode()).decode()
    req = urllib.request.Request(
        "http://127.0.0.1:6789/jsonrpc",
        data=json.dumps({"method": "status"}).encode(),
        headers={"Authorization": f"Basic {auth}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=8) as r:
            return (json.loads(r.read()) or {}).get("result")
    except Exception:
        return None


def human(n):
    n = float(n or 0)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024:
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PB"


def build_summary():
    total, used, free = shutil.disk_usage(MEDIA)

    queue = []
    for app, port, ver in (("radarr", 7878, "v3"), ("sonarr", 8989, "v3")):
        q = arr(app, port, ver, "queue?pageSize=50")
        for rec in (q or {}).get("records", []) or []:
            size = rec.get("size") or 0
            left = rec.get("sizeleft") or 0
            queue.append({
                "title": rec.get("title", "?"),
                "pct": round(100 * (size - left) / size, 1) if size else 0.0,
                "size": human(size),
                "eta": rec.get("timeleft") or "-",
                "state": rec.get("status") or "",
                "app": app,
            })

    recent = []
    for m in (arr("radarr", 7878, "v3", "history?pageSize=8&sortKey=date&sortDirection=descending"
                  "&eventType=3") or {}).get("records", []) or []:
        recent.append({"title": m.get("sourceTitle", "?")[:70], "kind": "movie",
                       "when": (m.get("date") or "")[:10]})
    for s in (arr("sonarr", 8989, "v3", "history?pageSize=8&sortKey=date&sortDirection=descending"
                  "&eventType=3") or {}).get("records", []) or []:
        recent.append({"title": s.get("sourceTitle", "?")[:70], "kind": "tv",
                       "when": (s.get("date") or "")[:10]})
    recent.sort(key=lambda r: r["when"], reverse=True)

    ng = nzbget_status() or {}
    speed = ng.get("DownloadRate", 0) or 0

    return {
        "disk": {"total": human(total), "used": human(used), "free": human(free),
                 "pct": round(100 * used / total, 1) if total else 0},
        "queue": queue[:8],
        "recent": recent[:8],
        "speed": f"{speed / 1e6:.1f} MB/s" if speed else "idle",
        "paused": bool(ng.get("DownloadPaused")),
        "at": time.strftime("%H:%M"),
    }


def summary():
    with _lock:
        if _cache["data"] and time.time() - _cache["at"] < 10:
            return _cache["data"]
    data = build_summary()
    with _lock:
        _cache["at"], _cache["data"] = time.time(), data
    return data


PAGE = """<!doctype html>
