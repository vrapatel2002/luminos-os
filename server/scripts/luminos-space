class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "luminos-space"

    def _auth(self):
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        return secrets.compare_digest((q.get("token") or [""])[0], self.server.token)

    # [CHANGE: claude-code | 2026-09-13] This handler sent no security headers of
    # its own at all -- not one -- and it is the half of the product that can
    # delete things. It relied entirely on Caddy, which is one config edit away
    # from not being true.
    def _send(self, code, body, ctype="application/json", cache="no-store"):
        raw = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Content-Security-Policy", CSP)
        self.send_header("X-Content-Type-Options", "nosniff")
        # no-referrer matters more here than anywhere: the token is in the query
        # string, and a Referer header would hand it to anything this page links to.
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Cache-Control", cache)
        self.end_headers()
        self.wfile.write(raw)

    def _send_file(self, path, ctype, cache):
        try:
            with open(path, "rb") as f:
                body = f.read()
        except OSError:
            return self._send(404, json.dumps({"error": "not found"}))
        self._send(200, body, ctype, cache)

    def _json(self, fn):
        try:
            return self._send(200, json.dumps(fn()))
        except Exception as e:
            return self._send(500, json.dumps({"error": "%s: %s" % (type(e).__name__, e)}))

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        # [CHANGE: claude-code | 2026-09-13] The stylesheet, the script and the fonts
        # are served before the token check, deliberately. They carry no library data
        # -- they are the identical bytes the hub already serves unauthenticated on
        # :443 -- and gating them would mean putting the token into a <link> href and
        # a @font-face src, i.e. into more URLs than it is in now. Fewer copies of the
        # token is the safer direction. Everything below this block still needs it.
        if path in STATIC:
            name, ctype = STATIC[path]
            return self._send_file("%s/%s" % (WEB_DIR, name), ctype, "no-cache")
        if path.startswith("/fonts/"):
            name = path[7:]
            if name not in FONTS:
                return self._send(404, json.dumps({"error": "not found"}))
            return self._send_file("%s/%s" % (FONT_DIR, name), "font/woff2",
                                   "public, max-age=31536000, immutable")
        if not self._auth():
            if path == "/":
                return self._send(403, "add ?token=... to the URL", "text/plain")
            return self._send(403, json.dumps({"error": "bad token"}))
        if path == "/":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if path == "/request":
            return self._send(200, REQUEST, "text/html; charset=utf-8")
        if path == "/api/data":
            return self._json(gather)
        if path == "/api/downloads":
            return self._json(downloads)
        if path == "/api/search":
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            term = (q.get("q") or [""])[0].strip()
            if not term:
                return self._send(200, json.dumps({"results": []}))
            return self._json(lambda: seerr_search(term))
        self._send(404, json.dumps({"error": "not found"}))

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        if not self._auth():
            return self._send(403, json.dumps({"ok": False, "message": "bad token"}))
        n = int(self.headers.get("Content-Length") or 0)
        try:
            req = json.loads(self.rfile.read(n) or b"{}")
            if path == "/api/delete":
                kind = req.get("kind")
                if kind == "season":
                    out = delete_season(int(req["id"]), int(req["season"]))
                elif kind == "movie":
                    out = delete_movie(int(req["id"]))
                elif kind == "episode":
                    out = delete_episode(int(req["id"]))
                else:
                    out = {"ok": False, "message": "unknown kind"}
            elif path == "/api/download-action":
                out = download_action(req.get("action"), req.get("id"))
            elif path == "/api/request":
                out = seerr_request(req.get("kind"), req.get("id"))
            else:
                return self._send(404, json.dumps({"error": "not found"}))
        except Exception as e:
            out = {"ok": False, "message": "%s: %s" % (type(e).__name__, e)}
        self._send(200, json.dumps(out))

    def log_message(self, fmt, *args):
        pass


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=8099)
    # [CHANGE: claude-code | 2026-09-02] Loopback by default. DECISION 90.
    # This used to be a hardcoded 0.0.0.0, which put a delete button for the whole
    # library on every interface with only a URL token in front of it. Caddy already
    # proxies it on :8446 with TLS and supplies that token itself, so nothing needs
    # to reach port 8099 from off-box.
    ap.add_argument("--bind", default="127.0.0.1")
    ap.add_argument("--print-url", action="store_true")
    a = ap.parse_args()

    t = token()
    url = "http://%s:%d/?token=%s" % (lan_ip(), a.port, t)
    if a.print_url:
        print(url)
        return

    srv = http.server.ThreadingHTTPServer((a.bind, a.port), Handler)
    srv.token = t
    print("luminos-space on port %d\nopen this in Chrome:\n\n  %s\n" % (a.port, url))
    sys.stdout.flush()
    srv.serve_forever()


main()
