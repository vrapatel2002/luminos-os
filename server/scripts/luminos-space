#!/usr/bin/env python3
"""[CHANGE: claude-code | 2026-08-08]
A small web view of what the media library is using, plus live control of the downloads.

Filelight shows every directory on the disk. This shows the things that actually grow --
movies, TV seasons, individual episodes -- and lets you remove them from a browser, and
pause or cancel anything that is downloading.

The part that matters: DELETING A FILE HERE MAY FREE NOTHING, and this tool is built
around that. Sonarr and Radarr import by hardlink, so a season sitting in the library
is usually the *same bytes* as a copy under the downloads directory -- one inode, two
names. Removing the library name drops the link count to 1 and frees zero. On this
server that affects ~370 GB, so a tool that reported apparent size would be lying in
the only situation where you care.

So every file is stat'ed for (st_dev, st_ino), twins are located in the downloads tree
by inode rather than by guessing at names, and the figure shown is what will really come
back. A row that frees less than its size says so.

Deletes go through the Sonarr/Radarr API, never straight to the filesystem, so their
databases stay consistent. Deleting a season also UNMONITORS it, and deleting a single
episode unmonitors that episode -- otherwise Sonarr notices the gap within minutes and
downloads it all over again.

  luminos-space                  # serve on 127.0.0.1:8099, prints the URL with its token
  luminos-space --port 9000
  luminos-space --bind 0.0.0.0   # only if you really mean it
  luminos-space --print-url      # show the URL of a server already configured

The token is generated once into /var/lib/luminos/space-token and required on every
request. It is a second lock, not the only one: as of DECISION 90 this binds to
LOOPBACK by default and Caddy fronts it on :8446 with TLS, so the token is no longer
all that stands between the LAN and a delete button.
"""
import argparse
import base64
import http.server
import json
import os
import re
import secrets
import shutil
import socket
import sys
import threading
import time
import urllib.parse
import urllib.request

SONARR = "http://127.0.0.1:8989/api/v3"
RADARR = "http://127.0.0.1:7878/api/v3"
NZBGET_CONF = "/var/lib/nzbget/nzbget.conf"
DOWNLOADS = "/srv/media/downloads"
MEDIA = "/srv/media"
TOKEN_FILE = "/var/lib/luminos/space-token"

_twin_cache = {"built": 0.0, "map": {}}
_cache_lock = threading.Lock()


# ---------------------------------------------------------------- plumbing

def api_key(app):
    # [CHANGE: claude-code | 2026-09-02] Read the file directly. DECISION 90.
    # This used to shell out to `sudo -n grep`, which was the main reason the whole
    # service ran as root. It never needed to: /var/lib/*/config.xml is mode 0664
    # owned by <app>:media, so group 'media' -- which this service is in -- can just
    # read it. luminos-hub has always done it this way.
    path = "/var/lib/%s/config.xml" % app
    try:
        with open(path) as f:
            m = re.search(r"<ApiKey>([^<]+)</ApiKey>", f.read())
    except OSError as e:
        sys.exit("could not read %s: %s" % (path, e))
    if not m:
        sys.exit("no <ApiKey> in %s" % path)
    return m.group(1)


def call(base, key, path, method="GET", body=None, timeout=180):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(base + path, data=data, method=method,
                                 headers={"X-Api-Key": key,
                                          "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as f:
        raw = f.read()
    return json.loads(raw) if raw else None


_NZB_CREDS = {}


def nzb_conf(key):
    # [CHANGE: claude-code | 2026-09-02] Read the file directly. DECISION 90.
    # Was `sudo -n sed`. nzbget.conf is 0640 nzbget:nzbget and holds the Usenet
    # password, so unlike config.xml it genuinely is not group-readable -- access
    # comes from a POSIX ACL granting this service user read, the same one-line
    # grant luminoshub already has. Still cached: the download panel polls every few
    # seconds and this file never changes while the service is running.
    if key not in _NZB_CREDS:
        val = ""
        try:
            with open(NZBGET_CONF) as f:
                for line in f:
                    m = re.match(r"^%s\s*=\s*(.*)$" % re.escape(key), line)
                    if m:
                        val = m.group(1).strip()
                        break
        except OSError:
            # Deliberately not fatal: the disk-usage view is the main feature and
            # works without NZBGet. Only the download panel degrades.
            val = ""
        _NZB_CREDS[key] = val
    return _NZB_CREDS[key]


def nzb_rpc(method, params=None, timeout=45):
    """NZBGet JSON-RPC. Always POST: `pausedownload` over GET returns an empty body
    and quietly does nothing, which looks exactly like success."""
    user = nzb_conf("ControlUsername") or "nzbget"
    pw = nzb_conf("ControlPassword")
    port = nzb_conf("ControlPort") or "6789"
    auth = base64.b64encode(("%s:%s" % (user, pw)).encode()).decode()
    body = json.dumps({"method": method, "params": params or []}).encode()
    req = urllib.request.Request("http://127.0.0.1:%s/jsonrpc" % port, data=body,
                                 headers={"Content-Type": "application/json",
                                          "Authorization": "Basic " + auth})
    with urllib.request.urlopen(req, timeout=timeout) as f:
        return json.loads(f.read()).get("result")


def token():
    if os.path.exists(TOKEN_FILE):
        t = open(TOKEN_FILE).read().strip()
        if t:
            return t
    t = secrets.token_urlsafe(18)
    os.makedirs(os.path.dirname(TOKEN_FILE), exist_ok=True)
    with open(TOKEN_FILE, "w") as f:
        f.write(t)
    os.chmod(TOKEN_FILE, 0o600)
    return t


def lan_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("192.168.2.1", 1))
        return s.getsockname()[0]
    except Exception:
        return "127.0.0.1"
    finally:
        s.close()


# ---------------------------------------------------------------- hardlinks

def twin_map(max_age=300):
    """inode -> [paths] for everything under the downloads tree.

    Only metadata is read, so this is cheap even on a spinning disk, but it is
    cached anyway because the page rebuilds it on every load.
    """
    with _cache_lock:
        if time.time() - _twin_cache["built"] < max_age and _twin_cache["map"]:
            return _twin_cache["map"]
        m = {}
        for dp, _, fn in os.walk(DOWNLOADS, onerror=lambda e: None):
            for name in fn:
                p = os.path.join(dp, name)
                try:
                    st = os.stat(p)
                except OSError:
                    continue
                if st.st_nlink > 1:
                    m.setdefault((st.st_dev, st.st_ino), []).append(p)
        _twin_cache["map"] = m
        _twin_cache["built"] = time.time()
        return m


def weigh(paths):
    """Return (apparent_bytes, freed_bytes, twin_paths).

    freed_bytes counts a file only when deleting the library copy *and* every twin
    we know about would drop its link count to zero. If some other name elsewhere
    still points at the inode, the space does not come back and we must not claim it.
    """
    twins = twin_map()
    apparent = freed = 0
    found = []
    for p in paths:
        try:
            st = os.stat(p)
        except OSError:
            continue
        apparent += st.st_size
        mine = twins.get((st.st_dev, st.st_ino), [])
        found.extend(mine)
        if st.st_nlink <= 1 + len(mine):
            freed += st.st_size
    return apparent, freed, found


# ---------------------------------------------------------------- data

def gather():
    sk, rk = api_key("sonarr"), api_key("radarr")

    series_rows = []
    for s in call(SONARR, sk, "/series"):
        files = call(SONARR, sk, "/episodefile?seriesId=%d" % s["id"]) or []
        if not files:
            continue
        eps = {e.get("episodeFileId"): e
               for e in (call(SONARR, sk, "/episode?seriesId=%d" % s["id"]) or [])
               if e.get("episodeFileId")}
        by_season = {}
        for f in files:
            by_season.setdefault(f["seasonNumber"], []).append(f)

        seasons = []
        for sn in sorted(by_season):
            ep_rows = []
            for f in sorted(by_season[sn],
                            key=lambda x: eps.get(x["id"], {}).get("episodeNumber", 0)):
                e = eps.get(f["id"], {})
                apparent, freed, twins = weigh([f["path"]])
                ep_rows.append({"fileId": f["id"],
                                "episode": e.get("episodeNumber", 0),
                                "title": e.get("title", ""),
                                "bytes": apparent, "frees": freed,
                                "twins": len(twins)})
            monitored = next((x["monitored"] for x in s["seasons"]
                              if x["seasonNumber"] == sn), False)
            seasons.append({"season": sn, "episodes": len(ep_rows),
                            "bytes": sum(x["bytes"] for x in ep_rows),
                            "frees": sum(x["frees"] for x in ep_rows),
                            "monitored": monitored, "eps": ep_rows})

        series_rows.append({"id": s["id"], "title": s["title"],
                            "bytes": sum(x["bytes"] for x in seasons),
                            "frees": sum(x["frees"] for x in seasons),
                            "seasons": seasons})

    movie_rows = []
    for m in call(RADARR, rk, "/movie"):
        if not m.get("hasFile"):
            continue
        mf = m.get("movieFile") or {}
        paths = [mf["path"]] if mf.get("path") else []
        apparent, freed, twins = weigh(paths)
        movie_rows.append({"id": m["id"], "title": m["title"], "year": m.get("year"),
                           "bytes": apparent, "frees": freed, "twins": len(twins)})

    series_rows.sort(key=lambda r: -r["bytes"])
    movie_rows.sort(key=lambda r: -r["bytes"])
    du = shutil.disk_usage(MEDIA)
    return {"series": series_rows, "movies": movie_rows,
            "disk": {"total": du.total, "used": du.used, "free": du.free}}


def group_paused(g):
    """Is this queue item paused?

    Two signals, both needed. `Status == "PAUSED"` is the definitive one, but it lags:
    pausing the item that is actively downloading takes 3-6s to land, because NZBGet
    first drains its open connections, and it reads DOWNLOADING for that whole window.
    `PausedSizeMB` covering the entire remainder is the early signal -- it flips within
    ~3s. On its own PausedSizeMB is NOT a pause flag: it is the par2 repair set, which
    every healthy group holds back (measured ~1.6 of 21.9 GB), hence the >= remaining
    test rather than > 0.
    """
    left = g.get("RemainingSizeMB", 0)
    return g.get("Status") == "PAUSED" or (left > 0 and g.get("PausedSizeMB", 0) >= left)


def downloads():
    try:
        st = nzb_rpc("status") or {}
        groups = nzb_rpc("listgroups") or []
    except Exception as e:
        return {"error": "%s: %s" % (type(e).__name__, e), "items": []}
    items = []
    for g in groups:
        total = g.get("FileSizeMB", 0) * 1048576
        left = g.get("RemainingSizeMB", 0) * 1048576
        status = g.get("Status", "")
        items.append({"id": g.get("NZBID"), "name": g.get("NZBName", ""),
                      "bytes": total, "done": max(0, total - left),
                      "status": status,
                      "paused": group_paused(g),
                      "health": g.get("Health", 0) / 10.0})
    du = shutil.disk_usage(MEDIA)
    return {"globalPaused": bool(st.get("DownloadPaused")),
            "rate": st.get("DownloadRate", 0),
            "remaining": st.get("RemainingSizeMB", 0) * 1048576,
            "free": du.free, "items": items}


def download_action(action, nzb_id=None):
    if action == "pauseall":
        nzb_rpc("pausedownload")
        return {"ok": True, "message": "all downloads paused"}
    if action == "resumeall":
        nzb_rpc("resumedownload")
        return {"ok": True, "message": "downloads resumed"}
    if nzb_id is None:
        return {"ok": False, "message": "no download id given"}
    cmd = {"pause": "GroupPause", "resume": "GroupResume",
           "delete": "GroupDelete", "top": "GroupMoveTop"}.get(action)
    if not cmd:
        return {"ok": False, "message": "unknown action"}
    nzb_id = int(nzb_id)
    # Look before as well as after. editqueue returns success for a command that
    # matched no group at all, so "gone afterwards" only means anything if it was
    # actually there beforehand -- otherwise a wrong id reads as a completed delete.
    def find(gs):
        return [g for g in (gs or []) if g.get("NZBID") == nzb_id]
    if not find(nzb_rpc("listgroups")):
        return {"ok": False, "message": "no download with id %d in the queue" % nzb_id}
    nzb_rpc("editqueue", [cmd, 0, "", [nzb_id]])
    # editqueue is applied asynchronously. Pausing the item that is actively
    # downloading took a measured 3-6s to land, so poll across that window instead of
    # reading once -- a single eager read reports a working pause as a failure.
    def settled(g):
        if action == "pause":
            return group_paused(g)
        if action == "resume":
            return not group_paused(g)
        return True
    got, still = None, []
    for _ in range(20):
        still = find(nzb_rpc("listgroups"))
        if action == "delete":
            if not still:
                break
        elif still and settled(still[0]):
            got = still[0].get("Status")
            break
        got = still[0].get("Status") if still else None
        time.sleep(0.5)
    if action == "delete":
        return {"ok": not still,
                "message": "download cancelled" if not still else "it is still in the queue"}
    if not still:
        return {"ok": False, "message": "%s: it vanished from the queue" % action}
    if not settled(still[0]):
        return {"ok": False, "message": "%s did not take -- still %s" % (action, got)}
    if action in ("pause", "resume"):
        # Report the pause state, not the raw Status: a just-paused item still reads
        # DOWNLOADING while its connections drain, and "pause -> DOWNLOADING" looks
        # like the command failed when it did not.
        return {"ok": True, "message": "paused" if action == "pause" else "resumed"}
    return {"ok": True, "message": "%s -> %s" % (action, got)}


# ---------------------------------------------------------------- deletion

def drop_twins(paths_before):
    """Remove download-tree names sharing an inode with something we just deleted.

    Inodes are captured *before* the API delete, because afterwards the library path
    is gone and there is nothing left to match on.
    """
    removed = 0
    for p in paths_before:
        for t in p["twins"]:
            try:
                os.remove(t)
                removed += 1
            except OSError:
                pass
    for dp, dn, fn in os.walk(DOWNLOADS, topdown=False, onerror=lambda e: None):
        if dp != DOWNLOADS and not os.listdir(dp):
            try:
                os.rmdir(dp)
            except OSError:
                pass
    with _cache_lock:
        _twin_cache["built"] = 0.0
    return removed


def snapshot(paths):
    twins = twin_map()
    out = []
    for p in paths:
        try:
            st = os.stat(p)
        except OSError:
            continue
        out.append({"path": p, "twins": twins.get((st.st_dev, st.st_ino), [])})
    return out


def _unmonitor_episodes(sk, episode_ids):
    if episode_ids:
        call(SONARR, sk, "/episode/monitor", "PUT",
             {"episodeIds": episode_ids, "monitored": False})


def delete_season(series_id, season):
    sk = api_key("sonarr")
    files = [f for f in (call(SONARR, sk, "/episodefile?seriesId=%d" % series_id) or [])
             if f["seasonNumber"] == season]
    if not files:
        return {"ok": False, "message": "no files for that season"}

    before = shutil.disk_usage(MEDIA).free
    snap = snapshot([f["path"] for f in files])
    for f in files:
        call(SONARR, sk, "/episodefile/%d" % f["id"], "DELETE")

    # Unmonitor, or Sonarr treats the season as missing and grabs it all back.
    s = call(SONARR, sk, "/series/%d" % series_id)
    for x in s["seasons"]:
        if x["seasonNumber"] == season:
            x["monitored"] = False
    call(SONARR, sk, "/series/%d" % series_id, "PUT", s)

    twins = drop_twins(snap)
    time.sleep(1.5)
    freed = shutil.disk_usage(MEDIA).free - before
    return {"ok": True, "message":
            "deleted %d episode(s), removed %d duplicate copy(ies), unmonitored S%02d "
            "- %.2f GB freed" % (len(files), twins, season, freed / 1e9)}


def delete_episode(file_id):
    sk = api_key("sonarr")
    f = call(SONARR, sk, "/episodefile/%d" % file_id)
    if not f:
        return {"ok": False, "message": "no such file"}

    before = shutil.disk_usage(MEDIA).free
    snap = snapshot([f["path"]])
    eps = [e["id"] for e in (call(SONARR, sk, "/episode?seriesId=%d" % f["seriesId"]) or [])
           if e.get("episodeFileId") == file_id]
    call(SONARR, sk, "/episodefile/%d" % file_id, "DELETE")
    _unmonitor_episodes(sk, eps)

    twins = drop_twins(snap)
    time.sleep(1.5)
    freed = shutil.disk_usage(MEDIA).free - before
    return {"ok": True, "message":
            "deleted the episode, removed %d duplicate copy(ies), unmonitored it "
            "- %.2f GB freed" % (twins, freed / 1e9)}


def delete_movie(movie_id):
    rk = api_key("radarr")
    m = call(RADARR, rk, "/movie/%d" % movie_id)
    mf = m.get("movieFile") or {}
    if not mf.get("path"):
        return {"ok": False, "message": "that movie has no file"}

    before = shutil.disk_usage(MEDIA).free
    snap = snapshot([mf["path"]])
    call(RADARR, rk, "/moviefile/%d" % mf["id"], "DELETE")
    m = call(RADARR, rk, "/movie/%d" % movie_id)
    m["monitored"] = False
    call(RADARR, rk, "/movie/%d" % movie_id, "PUT", m)

    twins = drop_twins(snap)
    time.sleep(1.5)
    freed = shutil.disk_usage(MEDIA).free - before
    return {"ok": True, "message":
            "deleted the file, removed %d duplicate copy(ies), unmonitored - %.2f GB freed"
            % (twins, freed / 1e9)}


