const TOKEN = new URLSearchParams(location.search).get('token') || '';
const gb = b => (b/1e9).toFixed(2) + ' GB';
const esc = s => String(s).replace(/[&<>"]/g, c =>
  ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const open = new Set();   // which rows are expanded, so a refresh does not collapse them

