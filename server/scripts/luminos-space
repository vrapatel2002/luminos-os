  m.textContent=t; m.classList.remove('hidden');
  clearTimeout(window._t); window._t=setTimeout(()=>m.classList.add('hidden'),9000); }

function btn(label, cls, data){
  const attrs = Object.entries(data).map(([k,v])=>'data-'+k+'="'+esc(v)+'"').join(' ');
  return '<button class="'+cls+'" '+attrs+'>'+label+'</button>';
}

// ---------------- downloads
async function loadDl(){
  const r = await fetch('/api/downloads?token='+encodeURIComponent(TOKEN));
  if(!r.ok){ document.getElementById('dl').textContent='bad or missing token'; return; }
  const d = await r.json();
  if(d.error){ document.getElementById('dl').innerHTML =
     '<div class="empty">cannot reach NZBGet: '+esc(d.error)+'</div>'; return; }

  document.getElementById('dlrate').innerHTML = d.items.length
    ? '<span style="color:var(--dim)">'+(d.rate/1e6).toFixed(2)+' MB/s &middot; '
      +gb(d.remaining)+' left</span>' : '';
  const ab = document.getElementById('allbtn');
  ab.textContent = d.globalPaused ? 'resume all' : 'pause all';
  ab.className = d.globalPaused ? 'on' : '';
  ab.dataset.act = d.globalPaused ? 'resumeall' : 'pauseall';
  ab.dataset.kind = 'dl';

  if(!d.items.length){ document.getElementById('dl').innerHTML =
    '<div class="empty">nothing downloading</div>'; return; }

  let h='';
  for(const it of d.items){
    const pct = it.bytes ? (it.done/it.bytes*100) : 0;
    h += '<div class="row"><span style="width:13px"></span><span class="name">'
      + esc(it.name)
      + (it.paused ? ' <span class="pausedtag">&#10073;&#10073; PAUSED</span>' : '')
      + (it.health < 100 ? ' <span class="note">health '+it.health.toFixed(0)+'%</span>' : '')
      + '</span>'
      + '<span class="barwrap"><span class="bar'+(it.paused?'':' go')
      + '" style="width:'+pct.toFixed(1)+'%"></span></span>'
      + '<span class="sz">'+gb(it.done)+' / '+gb(it.bytes)+'</span>'
      + '<span class="act">'
      + btn(it.paused?'resume':'pause','', {kind:'dl', act: it.paused?'resume':'pause', id: it.id})
      + btn('top','', {kind:'dl', act:'top', id: it.id})
      + btn('cancel','del', {kind:'dl', act:'delete', id: it.id, label: it.name})
      + '</span></div>';
  }
  document.getElementById('dl').innerHTML = h;
}

// ---------------- library
async function loadLib(){
  const r = await fetch('/api/data?token='+encodeURIComponent(TOKEN));
  if(!r.ok){ document.getElementById('app').textContent='bad or missing token'; return; }
  const d = await r.json();
  const pct = (d.disk.used/d.disk.total*100).toFixed(0);
  document.getElementById('disk').innerHTML =
    '<b>'+gb(d.disk.free)+'</b> free of '+gb(d.disk.total)+' &middot; '+pct+'% used';

  const max = Math.max(1, ...d.series.map(s=>s.bytes), ...d.movies.map(m=>m.bytes));
  const bar = b => '<span class="barwrap"><span class="bar" style="width:'
                   +(b/max*100).toFixed(1)+'%"></span></span>';
  const warn = o => o.bytes>o.frees
    ? ' <span class="note">frees only '+gb(o.frees)+'</span>' : '';

  let h = '<h2>TV shows</h2>';
  for(const s of d.series){
    const sk='s'+s.id;
    h += '<div class="row"><span class="caret" data-tog="'+sk+'">'
      +  (open.has(sk)?'&#9662;':'&#9656;')+'</span>'
      +  '<span class="name">'+esc(s.title)+'</span>'+bar(s.bytes)
      +  '<span class="sz">'+gb(s.bytes)+'</span><span class="act"></span></div>'
      +  '<div id="'+sk+'"'+(open.has(sk)?'':' class="hidden"')+'>';
    for(const se of s.seasons){
      const ek=sk+'e'+se.season;
      h += '<div class="row lvl2"><span class="caret" data-tog="'+ek+'">'
        +  (open.has(ek)?'&#9662;':'&#9656;')+'</span>'
        +  '<span class="name">Season '+se.season+' &middot; '+se.episodes+' ep'
        +  (se.monitored?'':' &middot; not monitored')+warn(se)+'</span>'+bar(se.bytes)
        +  '<span class="sz">'+gb(se.bytes)+'</span><span class="act">'
        +  btn('delete season','del',{kind:'season', id:s.id, season:se.season,
              label:s.title+' Season '+se.season, frees:se.frees})
        +  '</span></div><div id="'+ek+'"'+(open.has(ek)?'':' class="hidden"')+'>';
      for(const ep of se.eps){
        h += '<div class="row lvl3"><span style="width:13px"></span>'
          +  '<span class="name">E'+String(ep.episode).padStart(2,'0')+' '
          +  esc(ep.title)+warn(ep)+'</span>'+bar(ep.bytes)
          +  '<span class="sz">'+gb(ep.bytes)+'</span><span class="act">'
          +  btn('delete','del',{kind:'episode', id:ep.fileId,
                label:s.title+' S'+se.season+'E'+ep.episode, frees:ep.frees})
          +  '</span></div>';
      }
      h += '</div>';
    }
    h += '</div>';
  }

  h += '<h2>Movies</h2>';
  for(const m of d.movies){
    h += '<div class="row"><span style="width:13px"></span><span class="name">'
      +  esc(m.title)+' <span style="color:var(--dim)">('+(m.year||'')+')</span>'
      +  warn(m)+'</span>'+bar(m.bytes)
      +  '<span class="sz">'+gb(m.bytes)+'</span><span class="act">'
      +  btn('delete','del',{kind:'movie', id:m.id, label:m.title, frees:m.frees})
      +  '</span></div>';
  }
  if(!d.movies.length) h += '<div class="empty">no movies with files</div>';
  document.getElementById('app').innerHTML = h;
}

// ---------------- one listener for every button, so no inline quoting to get wrong
document.addEventListener('click', async ev => {
  const t = ev.target.closest('[data-tog],button');
  if(!t) return;

  if(t.dataset.tog){
    const k=t.dataset.tog, el=document.getElementById(k);
    if(open.has(k)) open.delete(k); else open.add(k);
    el.classList.toggle('hidden');
    t.innerHTML = open.has(k) ? '\u25BE' : '\u25B8';
    return;
  }
  const d = t.dataset;
  if(d.kind === 'dl'){
    if(d.act==='delete' && !confirm('Cancel this download?\n\n'+d.label)) return;
    const r = await fetch('/api/download-action?token='+encodeURIComponent(TOKEN),{
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({action:d.act, id:d.id?Number(d.id):null})});
    say((await r.json()).message); loadDl(); return;
  }
  if(d.kind==='season' || d.kind==='movie' || d.kind==='episode'){
    if(!confirm('Delete '+d.label+'?\n\nThis frees '
        +(Number(d.frees)/1e9).toFixed(2)+' GB and cannot be undone.')) return;
    say('deleting '+d.label+'...');
    const r = await fetch('/api/delete?token='+encodeURIComponent(TOKEN),{
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({kind:d.kind, id:Number(d.id),
                            season: d.season?Number(d.season):0})});
    say((await r.json()).message);
    loadLib(); loadDl();
  }
});

loadLib(); loadDl();
setInterval(loadDl, 5000);
</script>
"""


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "luminos-space"

    def _auth(self):
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        return secrets.compare_digest((q.get("token") or [""])[0], self.server.token)

    def _send(self, code, body, ctype="application/json"):
        raw = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def _json(self, fn):
        try:
            return self._send(200, json.dumps(fn()))
        except Exception as e:
            return self._send(500, json.dumps({"error": "%s: %s" % (type(e).__name__, e)}))

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if not self._auth():
            if path == "/":
                return self._send(403, "add ?token=... to the URL", "text/plain")
            return self._send(403, json.dumps({"error": "bad token"}))
        if path == "/":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if path == "/api/data":
            return self._json(gather)
        if path == "/api/downloads":
            return self._json(downloads)
        self._send(404, json.dumps({"error": "not found"}))

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        if not self._auth():
            return self._send(403, json.dumps({"ok": False, "message": "bad token"}))
        n = int(self.headers.get("Content-Length") or 0)
        try:
            req = json.loads(self.rfile.read(n) or b"{}")
            if path == "/api/delete":
                kind = req.get("kind")
                if kind == "season":
                    out = delete_season(int(req["id"]), int(req["season"]))
                elif kind == "movie":
                    out = delete_movie(int(req["id"]))
                elif kind == "episode":
                    out = delete_episode(int(req["id"]))
                else:
                    out = {"ok": False, "message": "unknown kind"}
            elif path == "/api/download-action":
                out = download_action(req.get("action"), req.get("id"))
            else:
                return self._send(404, json.dumps({"error": "not found"}))
        except Exception as e:
            out = {"ok": False, "message": "%s: %s" % (type(e).__name__, e)}
        self._send(200, json.dumps(out))

    def log_message(self, fmt, *args):
        pass


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=8099)
    # [CHANGE: claude-code | 2026-09-02] Loopback by default. DECISION 90.
    # This used to be a hardcoded 0.0.0.0, which put a delete button for the whole
    # library on every interface with only a URL token in front of it. Caddy already
    # proxies it on :8446 with TLS and supplies that token itself, so nothing needs
    # to reach port 8099 from off-box.
    ap.add_argument("--bind", default="127.0.0.1")
    ap.add_argument("--print-url", action="store_true")
    a = ap.parse_args()

    t = token()
    url = "http://%s:%d/?token=%s" % (lan_ip(), a.port, t)
    if a.print_url:
        print(url)
        return

    srv = http.server.ThreadingHTTPServer((a.bind, a.port), Handler)
    srv.token = t
    print("luminos-space on port %d\nopen this in Chrome:\n\n  %s\n" % (a.port, url))
    sys.stdout.flush()
    srv.serve_forever()


main()
