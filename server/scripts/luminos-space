# from image.tmdb.org, and §6.2 rules out a third-party asset fetch whether the browser
# makes it or this process proxies it -- either way the page stops working when the
# internet does, and TMDB learns each time it is opened. The search itself has to reach
# TMDB (there is no local index of films that do not exist here yet); decoration does
# not have to. So the results are typographic: title, year, medium, and whether it is
# already here, which is the one fact that stops a pointless request.
REQUEST = """<!doctype html>
