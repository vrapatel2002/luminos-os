#!/usr/bin/env python3
# [CHANGE: claude | 2026-10-18] DECISION 150: phone at home = full quality, away = 8 Mbps.
# The Pixel always reaches Jellyfin over Tailscale (100.x), so Jellyfin calls it "remote" even on the home wifi
# and DECISION 142's cap hit it at home. Home = a `tailscale ping` to the phone comes back over a 192.168.2.x
# address (direct on the house network). Peer endpoint lists are not exposed, so the ping is the only reliable test.
# Offline, relayed (DERP) or any other path = away = capped.
import json, subprocess, urllib.request
PHONE_IP, HOME_LIMIT, AWAY_LIMIT = "100.77.43.36", 0, 8000000
J = "http://127.0.0.1:8096/System/Configuration"
TOKEN = open("/root/.jellyfin-token").read().strip()

def phone_home():
    st = json.loads(subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, check=True).stdout)
    if not any(PHONE_IP in (p.get("TailscaleIPs") or []) and p.get("Online") for p in st["Peer"].values()):
        return False
    r = subprocess.run(["tailscale", "ping", "-c", "3", "--timeout", "2s", PHONE_IP], capture_output=True, text=True)
    return "via 192.168.2." in r.stdout

def api(method, body=None):
    r = urllib.request.Request(J, method=method, data=body, headers={"X-Emby-Token": TOKEN, "Content-Type": "application/json"})
    with urllib.request.urlopen(r, timeout=10) as f: return f.read()

want = HOME_LIMIT if phone_home() else AWAY_LIMIT
cfg = json.loads(api("GET"))
if cfg.get("RemoteClientBitrateLimit") != want:
    cfg["RemoteClientBitrateLimit"] = want
    api("POST", json.dumps(cfg).encode())
    print(f"RemoteClientBitrateLimit -> {want} ({'home' if want == HOME_LIMIT else 'away'})")
