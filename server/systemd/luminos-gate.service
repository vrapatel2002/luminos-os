# /etc/systemd/system/luminos-gate.service
# [CHANGE: cowork | 2026-11-13] DECISION 187 -- admin sign-in in front of the hub (:443) and
# the Space page (:8446). Caddy forward_auth -> 127.0.0.1:8101. Runs as the existing
# luminosspace account so it can reuse the Space page's read-only Jellyfin key; the HMAC
# secret is its own 0600 file. Only `shawn` (LUMINOS_GATE_ALLOW) gets through.
[Unit]
Description=Luminos admin gate (Jellyfin-admin sign-in for hub + Space)
Documentation=file:/home/shawn/luminos-os/server/DECISIONS.md
After=network.target jellyfin.service
Wants=jellyfin.service

[Service]
Type=simple
User=luminosspace
Group=luminosspace
Environment=LUMINOS_GATE_ALLOW=shawn
ExecStart=/usr/local/bin/luminos-gate
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
ReadWritePaths=/var/lib/luminos/gate-secret
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
