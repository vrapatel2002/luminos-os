#!/usr/bin/env python3
"""luminos-lid — a closed lid sleeps. No app, service or code can veto it.

[CHANGE: claude-code | 2026-06-03] original: udev-triggered, blanked the eDP panel
    and deliberately kept the system awake.
[CHANGE: claude-code | 2026-09-14] rewritten: it suspends, and it watches the lid
    switch directly instead of via udev.

Why not just let PowerDevil or logind do it:

  * PowerDevil's lid action is vetoable. Any app holding a PolicyAgent inhibition
    — Chrome's "Playing audio", a page's Video Wake Lock — makes it abort with
    "Unsatisfied policies, the action has been aborted". Those inhibitions are
    invisible to `systemd-inhibit --list`, so the machine just silently stays up.
  * logind can't rescue it: while Plasma runs, PowerDevil holds a *block*
    inhibitor on handle-lid-switch, so logind's HandleLidSwitch never fires.
  * The old udev rule could never have worked. On this kernel the lid is
    PNP0C0D:00 on subsystem 'platform', not LID0 on 'button', and ACPI lid
    transitions go out over netlink, not as udev uevents.

So this reads the physical switch off its evdev node, which nothing can intercept,
and suspends with -i, which ignores every inhibitor there is. PowerDevil still
handles the ordinary case gracefully; this is the backstop for when it is overruled.

[CHANGE: claude-code | 2026-09-15] It now LOCKS before it suspends.
    The first version did not, and the machine woke straight onto a live desktop.
    Root cause was `LockOnResume=false` in kscreenlockerrc (set long ago, harmless
    only because the box never used to sleep) — that is fixed separately. But the
    lock is not left depending on a KDE checkbox that was already found switched
    off once: `loginctl lock-sessions` is called here first, so the guarantee lives
    in the same place as the sleep guarantee.
    Ordering is safe even with -i: `-i` is `--check-inhibitors=no`, a *client-side*
    check, so logind still honours kwin's "Ensuring that the screen gets locked
    before going to sleep" delay inhibitor.

[CHANGE: claude-code | 2026-11-06] v3: it keeps trying until the machine is asleep.
    v2 fired one suspend per close and never looked back: an aborted attempt (the SD reader's
    mmc0 wakeup source, routinely) left it awake with the lid shut, and a spontaneous wake
    had nothing to put it back. v3 reads the switch as a LEVEL (EVIOCGSW) and retries on
    BACKOFF, never giving up. A resume shows as BOOTTIME−MONOTONIC growing; nothing fires for
    GRACE s after one, because switch state can lag the wake and a real lid-open must never
    be fought. A real sleep restarts the backoff; service start counts as a resume.
    `systemctl suspend -i` returns when logind queues the request, not when asleep, so an
    accepted attempt holds the next until suspend_stats changes or SLEEP_WAIT s pass.
"""

import fcntl, os, re, select, subprocess, sys, time
from contextlib import suppress
from dataclasses import dataclass, replace
from enum import Enum
from pathlib import Path

SW_LID, SW_MAX = 0x00, 0x10
SW_BYTES = (SW_MAX + 7) // 8
EVIOCGSW = (2 << 30) | (SW_BYTES << 16) | (ord("E") << 8) | 0x1b  # _IOC(_IOC_READ, 'E', 0x1b, len)

# Absolute paths: this runs as root, PATH is not its to trust.
LOGINCTL, SYSTEMCTL = "/usr/bin/loginctl", "/usr/bin/systemctl"

BACKOFF = (2.0, 5.0, 10.0, 30.0)
GRACE = 5.0
RESUME_JUMP = 2.0  # BOOTTIME−MONOTONIC growth that counts as having been asleep
SLEEP_WAIT = 60.0  # longest an issued sleep may hold back the next action


@dataclass(frozen=True)
class State:
    closed_since: float | None = None
    attempts: int = 0
    last_try: float | None = None


class Action(Enum):
    NONE = "none"
    LOCK_AND_SLEEP = "lock_and_sleep"
    SLEEP = "sleep"


def decide(now: float, lid_closed: bool, resumed_at: float | None, st: State) -> tuple[Action, State]:
    if not lid_closed:
        return Action.NONE, State()
    if resumed_at is not None and now - resumed_at < GRACE:
        return Action.NONE, st
    if st.attempts == 0:
        return Action.LOCK_AND_SLEEP, State(closed_since=now, attempts=1, last_try=now)
    if resumed_at is not None and resumed_at > st.last_try:
        st = replace(st, attempts=1)  # it really slept: backoff starts over
    if now - st.last_try >= BACKOFF[min(st.attempts - 1, 3)]:
        return Action.SLEEP, replace(st, attempts=st.attempts + 1, last_try=now)
    return Action.NONE, st


def log(msg):
    print(f"luminos-lid: {msg}", flush=True)


def lid_event_node():
    """Resolve 'Lid Switch' to /dev/input/eventN by name — the number can move."""
    devices = Path("/proc/bus/input/devices").read_text()
    match = re.search(r'N: Name="Lid Switch".*?H: Handlers=(.*)', devices, re.S)
    if not match:
        sys.exit("luminos-lid: no input device named 'Lid Switch'")
    handler = next(h for h in match.group(1).split() if h.startswith("event"))
    return Path("/dev/input") / handler


def lid_is_closed(fd):
    state = bytearray(SW_BYTES)
    fcntl.ioctl(fd, EVIOCGSW, state, True)
    return bool(state[0] & (1 << SW_LID))


def boottime():
    return time.clock_gettime(time.CLOCK_BOOTTIME)


def asleep_seconds():
    return boottime() - time.clock_gettime(time.CLOCK_MONOTONIC)


def suspend_stats():
    return [Path(f"/sys/power/suspend_stats/{name}").read_text() for name in ("success", "fail")]


def run(*cmd):
    """True if it worked. A failure is only logged: the next pass of the loop is the retry."""
    try:
        subprocess.run(cmd, timeout=180, check=True)
        return True
    except (OSError, subprocess.SubprocessError) as e:
        log(f"failed: {e}")
        return False


def act(action, attempt):
    if action is Action.LOCK_AND_SLEEP:
        log(f"lid closed — locking, then suspending (attempt {attempt})")
        run(LOGINCTL, "lock-sessions")
    else:
        log(f"lid still closed and awake — suspending again (attempt {attempt})")
    return run(SYSTEMCTL, "suspend", "-i")


def main():
    node = lid_event_node()
    log(f"v3 watching {node}")
    fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK)
    st, resumed_at, asleep = State(), boottime(), asleep_seconds()
    stats_before, give_up = None, 0.0
    while True:
        select.select([fd], [], [], 1.0)
        with suppress(BlockingIOError):
            os.read(fd, 4096)
        now, was_asleep, asleep = boottime(), asleep, asleep_seconds()
        if asleep - was_asleep > RESUME_JUMP:
            resumed_at = now
            log(f"resumed after {asleep - was_asleep:.0f} s asleep")
        closed = lid_is_closed(fd)
        if not closed:
            give_up = 0.0  # opening the lid ends any wait
        elif now < give_up and suspend_stats() == stats_before:
            continue  # an accepted sleep is still in flight
        action, st = decide(now, closed, resumed_at, st)
        if action is not Action.NONE:
            stats_before = suspend_stats()
            give_up = boottime() + SLEEP_WAIT if act(action, st.attempts) else 0.0


if __name__ == "__main__":
    main()
