#!/usr/bin/env bash
# luminos-ubuntu-persist — re-affirm the Ubuntu (Yaru) look at each login so a stray
# "Global Theme" apply (which blanks ColorScheme/Icons/cursor) can't leave the desktop
# stuck on Breeze. No sudo, no prompts — only writes the user's own KDE config keys and
# does a best-effort live re-apply. Idempotent; safe to run any number of times.
#
# Installed as a systemd --user oneshot (luminos-ubuntu-look.service), started at login.
# [CHANGE: claude-code | 2026-07-22]
#
# [CHANGE: claude-code | 2026-07-26] BUG-088 — three defects made this script report success
# while the desktop was visibly Breeze:
#   1. It never disabled KDE's Global-Theme auto-switcher (kdeglobals [KDE] AutomaticLookAndFeel
#      + AutomaticLookAndFeelOnIdle, served by the `lookandfeelautoswitcher` kded module). That
#      daemon re-applies a whole Look-and-Feel package on a *5 second idle* timer, so the look
#      was reset on every lock/idle — long before any login-time heal could matter.
#   2. It wrote ColorScheme=Yaru BEFORE calling plasma-apply-colorscheme, which then answers
#      "already set as the theme for the current session" and exits 0 *without writing the
#      [Colors:*] blocks*. Name said Yaru, payload stayed Breeze Dark.
#   3. Its drift check read only the scheme NAME, so once (2) happened it saw "Yaru" and
#      declared victory forever. It now checks an actual colour value.
#
# [CHANGE: claude-code | 2026-10-10] DECISION 139 phase 2 — the look is now Caelestia colours +
# YAMIS monochrome icons, not Yaru. Rewritten so that:
#   * the icon/GTK-icon heal runs on EVERY login (it used to sit behind the colour gate, which
#     exits on ColorScheme=Caelestia, so it never ran);
#   * a blanked/Breeze colour scheme heals to Caelestia via luminos-kde-caelestia-theme --apply,
#     never to Yaru (which clobbered Caelestia);
#   * GTK settings.ini is edited key-by-key (gtk-theme-name/cursor stay as configured), and
#     fonts are never written here (luminos-kde-caelestia-theme owns them).
set -uo pipefail

export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
REPO="${LUMINOS_REPO:-$HOME/luminos-os}"

SCHEME=Caelestia
# Monochrome YAMIS — same value as scripts/luminos-ubuntu-look ICON_THEME
# (luminos-windowstyle-check asserts they agree).
ICONS=yet-another-monochrome-icon-set
log() { echo "luminos-ubuntu-persist: $*"; }

# 0. Kill the actual cause. KDE's day/night + on-idle Global Theme switcher re-applies a whole
#    Look-and-Feel package (colours, icons, cursor, widget style, Plasma style, decoration).
#    AutomaticLookAndFeelOnIdle defaults TRUE, so it must be written explicitly (BUG-088).
kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel       false
kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeelOnIdle false
qdbus6 org.kde.kded6 /kded org.kde.kded6.unloadModule lookandfeelautoswitcher >/dev/null 2>&1 || true

# 1. Icons (Qt) — always. kdedefaults/kdeglobals is aligned too: kde-gtk-config was observed
#    syncing GTK from that file instead of the user file.
if [[ "$(kreadconfig6 --file kdeglobals --group Icons --key Theme)" != "$ICONS" ]]; then
	log "Qt icon theme drifted — healing to $ICONS"
	kwriteconfig6 --file kdeglobals --group Icons --key Theme "$ICONS"
	/usr/lib/plasma-changeicons "$ICONS" >/dev/null 2>&1 || true
fi
kwriteconfig6 --file "$HOME/.config/kdedefaults/kdeglobals" --group Icons --key Theme "$ICONS"

# 2. Icons (GTK) — always, one key per file, in place (keeps comments and the other keys;
#    the repo copies in config/gtk-*/ are meant to stay byte-identical).
for v in gtk-3.0 gtk-4.0; do
	ini="$HOME/.config/$v/settings.ini"
	[[ -f "$ini" ]] || printf '[Settings]\n' >"$ini"
	if ! grep -qx "gtk-icon-theme-name=$ICONS" "$ini"; then
		log "$v icon theme drifted — healing to $ICONS"
		if grep -q '^gtk-icon-theme-name=' "$ini"; then sed -i "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$ICONS/" "$ini"
		else sed -i "/^\[Settings\]/a gtk-icon-theme-name=$ICONS" "$ini"; fi
	fi
done
[[ "$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null)" == "'$ICONS'" ]] || \
	gsettings set org.gnome.desktop.interface icon-theme "$ICONS" 2>/dev/null || true

# 3. Colours — only heal a blank-out / Breeze fallback, and heal it to Caelestia. Any other
#    named scheme is a deliberate user choice and is left alone.
cur="$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null || true)"
case "$cur" in
	""|Breeze*|breeze*)
		log "colour scheme is '${cur:-<blank>}' — healing to $SCHEME"
		python3 "$REPO/scripts/luminos-kde-caelestia-theme" --apply >/dev/null 2>&1 \
			|| log "warn: luminos-kde-caelestia-theme --apply failed (run it by hand)" ;;
	*) ;;
esac

# Report what is actually true on disk, not what we attempted (BUG-088/089).
final_icons="$(kreadconfig6 --file kdeglobals --group Icons --key Theme 2>/dev/null || true)"
final_gtk3="$(kreadconfig6 --file "$HOME/.config/gtk-3.0/settings.ini" --group Settings --key gtk-icon-theme-name 2>/dev/null || true)"
final_gtk4="$(kreadconfig6 --file "$HOME/.config/gtk-4.0/settings.ini" --group Settings --key gtk-icon-theme-name 2>/dev/null || true)"
final_scheme="$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null || true)"
if [[ "$final_icons" == "$ICONS" && "$final_gtk3" == "$ICONS" && "$final_gtk4" == "$ICONS" \
   && -n "$final_scheme" && "$final_scheme" != Breeze* ]]; then
	log "OK — scheme '$final_scheme', Qt + GTK icons '$ICONS' (read back)."
else
	log "FAILED — scheme='$final_scheme', icons='$final_icons', gtk3='$final_gtk3', gtk4='$final_gtk4' (want $ICONS)" >&2
	exit 1
fi
