#!/usr/bin/env bash
# luminos-dgpu-watch — name the process that wakes, or holds, the discrete GPU.
# [CHANGE: claude-code | 2026-09-03]
# [CHANGE: cowork | 2026-09-19] BUG-182: powerd filter removed, --once/--daemon,
#                               holder identity (user/cmdline/fd-open-time), HOLDER- exits.
#
# WHY THIS EXISTS
#   "Something is using the dGPU but nvidia-smi shows nothing" is unanswerable after
#   the fact: Linux keeps no per-process GPU history, and a client vanishes from
#   nvidia-smi the moment it exits. So we have to be watching when it happens.
#
# HOW IT WORKS
#   Reads /sys/.../power/runtime_status, a plain sysfs string that does NOT resume the
#   card — unlike nvidia-smi, which must wake it to answer. It NEVER runs nvidia-smi.
#   Every tick it walks /proc/*/fd for handles on the NVIDIA nodes and reports each
#   holder the first time it is seen, and again when it lets go.
#
# ⚠️ IT NO LONGER SKIPS nvidia-powerd  [CHANGE: cowork | 2026-09-19]
#   The old version dropped nvidia-powerd from every report, on the stated grounds that
#   it "holds the handles for the entire uptime by design". BUG-182 measured that claim
#   and it is FALSE: on 2026-09-19 powerd's 11 handles on /dev/nvidia0 were opened at
#   23:18:51, hours into an uptime that began at 13:26 — so it opens and closes, and
#   the open is an event worth catching. Filtering it hid the only holder there was.
#   `--quiet-powerd` restores the old behaviour if it ever becomes noise.
#
# CONTEXT (BUG-103, and the render-node inversion documented in chrome-luminos)
#   On this box the dGPU enumerates FIRST:  renderD128 = NVIDIA,  renderD129 = AMD.
#   So anything defaulting to "renderD128" — libva, ffmpeg, Vulkan device 0 — lands on
#   the discrete card. That is the usual culprit, not a runaway process.
#   Also logs the ACPI platform profile, because a profile write wakes the card through
#   ACPI NVPCF with no process holding anything at all (BUG-161) — if you see a WOKE
#   with no HOLDER+ beside it, look at the PROFILE line.
#
# ⚠️ A WOKE WITH NO HOLDER+ AND NO PROFILE LINE IS USUALLY A CONFIG-SPACE READ.
#   [CHANGE: cowork | 2026-09-20] Caught live: `sudo lspci -vnn -s 65:00.0` at 23:57:43
#   woke the card on the exact second, while targeting the *AMD* card — `lspci` still
#   enumerates the whole bus, and `-v` reads config space, which resumes a D3cold device.
#   Nothing opens a device node, so this watcher sees the wake and no holder. Same class as
#   BUG-151's finding that `lspci -s 01:00.0` flipped the card D3cold->D0 just by asking.
#   Cross-check a holderless wake against `journalctl` for lspci / lshw / inxi / hwinfo /
#   sensors / a bare root nvidia-smi in that second.
#
# USAGE
#   sudo luminos-dgpu-watch                    # watch until Ctrl-C
#   sudo luminos-dgpu-watch -d 3600            # watch for one hour
#   sudo luminos-dgpu-watch -l /var/log/luminos/dgpu-watch.log
#   sudo luminos-dgpu-watch --once             # one snapshot of who holds it, then exit
#   sudo systemctl start luminos-dgpu-watch    # background, TEMPORARY debug unit
#
# Read-only. Touches no configuration and never contacts the GPU.

set -uo pipefail

DGPU_PCI=0000:01:00.0
PMDIR=/sys/bus/pci/devices/$DGPU_PCI/power
PM=$PMDIR/runtime_status
PROFILE=/sys/firmware/acpi/platform_profile
INTERVAL=0.5
DURATION=0
LOGFILE=
HEARTBEAT=600
ONCE=0
QUIET_POWERD=0

while [ $# -gt 0 ]; do
	case $1 in
	-d | --duration) DURATION=$2; shift 2 ;;
	-i | --interval) INTERVAL=$2; shift 2 ;;
	-l | --log) LOGFILE=$2; shift 2 ;;
	-b | --heartbeat) HEARTBEAT=$2; shift 2 ;;
	--once) ONCE=1; shift ;;
	--quiet-powerd) QUIET_POWERD=1; shift ;;
	-h | --help) sed -n '2,45p' "$0"; exit 0 ;;
	*) echo "unknown argument: $1 (try --help)" >&2; exit 2 ;;
	esac
done

[ -r "$PM" ] || { echo "cannot read $PM — is the dGPU at $DGPU_PCI?" >&2; exit 1; }

say() {
	local line="$*"
	if [ -n "$LOGFILE" ]; then
		printf '%s\n' "$line" | tee -a "$LOGFILE"
	else
		printf '%s\n' "$line"
	fi
}
ts() { date '+%Y-%m-%d %H:%M:%S'; }

# MUST RUN AS ROOT — not a nicety. Every sanctioned dGPU client goes through the setgid
# dgpu-exec gate (DECISION 25), which leaves egid != rgid; the kernel marks such a
# process non-dumpable and /proc/<pid>/fd flips to root:root 0500. Measured: glxgears
# rendering on the RTX 4050 was completely invisible to a scan running as shawn. An
# unprivileged watcher is blind to precisely the processes it is meant to catch.
if [ "$(id -u)" -ne 0 ]; then
	say "REFUSING TO RUN UNPRIVILEGED — dGPU clients are non-dumpable behind the setgid"
	say "gate, so as your user this watcher sees nothing and would report a clean idle GPU"
	say "while a process is actively rendering on it.  Re-run:  sudo $0 $*"
	exit 1
fi

# One `find -lname` walks every /proc/*/fd in a single process. The naive version —
# readlink per fd — forks thousands of times per scan and reliably misses a short wake.
# Emits: "<pid> <fdnum> <node>" per handle.
holders_raw() {
	find /proc/[0-9]*/fd -maxdepth 1 -type l \
		\( -lname '/dev/dri/renderD128' -o -lname '/dev/dri/card1' \
		-o -lname '/dev/nvidia' -o -lname '/dev/nvidia[0-9]*' \
		-o -lname '/dev/nvidiactl' -o -lname '/dev/nvidia-uvm*' \
		-o -lname '/dev/nvidia-modeset' \) \
		-printf '%h %f %l\n' 2>/dev/null |
		while read -r dir fdnum node; do
			pid=${dir#/proc/}; pid=${pid%/fd}
			printf '%s %s %s\n' "$pid" "$fdnum" "$node"
		done
}

# Collapse to one line per pid+node, with a count. Key is "pid:node".
holder_keys() { holders_raw | awk '{print $1":"$3}' | sort | uniq -c | awk '{print $2" "$1}'; }

# Full identity for a pid — the "who", asked once, when the holder first appears.
# The fd open time is the "when": /proc/<pid>/fd timestamps are real open-times on this
# kernel (BUG-182 verified it by re-listing twice unchanged while low fds kept boot time),
# which is how we date a handle that was opened long before we started watching.
describe() {
	local pid=$1 node=$2 fdnum=$3
	local comm user cmd opened
	comm=$(cat "/proc/$pid/comm" 2>/dev/null || echo '?')
	user=$(stat -c '%U' "/proc/$pid" 2>/dev/null || echo '?')
	cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | cut -c1-160)
	[ -n "$cmd" ] || cmd="[$comm]"
	opened=$(stat -c '%y' "/proc/$pid/fd/$fdnum" 2>/dev/null | cut -d. -f1)
	printf '%s(%s) user=%s node=%s opened=%s cmd=%s' \
		"$comm" "$pid" "$user" "$node" "${opened:-?}" "$cmd"
}

snapshot() {
	local any=0 key pid node n fdnum
	while read -r key n; do
		[ -n "$key" ] || continue
		pid=${key%%:*}; node=${key#*:}
		[ "$QUIET_POWERD" = 1 ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = nvidia-powerd ] && continue
		fdnum=$(holders_raw | awk -v p="$pid" -v nd="$node" '$1==p && $3==nd {print $2; exit}')
		say "$(ts)  HOLDER   $(describe "$pid" "$node" "$fdnum")  fds=$n"
		any=1
	done <<<"$(holder_keys)"
	[ "$any" = 0 ] && say "$(ts)  HOLDER   none — nothing holds any NVIDIA node"
	return 0
}

counters() {
	local a s
	a=$(cat "$PMDIR/runtime_active_time" 2>/dev/null || echo 0)
	s=$(cat "$PMDIR/runtime_suspended_time" 2>/dev/null || echo 0)
	printf 'active=%ss suspended=%ss' "$((a / 1000))" "$((s / 1000))"
}

say "$(ts)  START    state=$(cat "$PM")  $(counters)  profile=$(cat $PROFILE 2>/dev/null)"
say "$(ts)  START    poll=${INTERVAL}s  renderD128=NVIDIA renderD129=AMD  (never runs nvidia-smi)"
snapshot
if [ "$ONCE" = 1 ]; then exit 0; fi
say "----------------------------------------------------------------------"

started=$SECONDS
prev=$(cat "$PM" 2>/dev/null)
prev_profile=$(cat $PROFILE 2>/dev/null)
prev_susp=$(cat "$PMDIR/runtime_suspended_time" 2>/dev/null || echo 0)
wake_start=$SECONDS
last_beat=$SECONDS
declare -A SEEN    # key "pid:node" -> epoch first seen
# [CHANGE: cowork | 2026-09-20] BUG-182: keying arrivals on pid+node alone made a RE-OPEN
# invisible. nvidia-powerd dropped and re-acquired its 11 handles at 00:07:39 and the log said
# nothing, because its pid and node had not changed. The re-open is the event we are hunting
# (it is a candidate wake path), so the fd open time is tracked separately and a change in it
# is reported as HOLDER~.
declare -A OPENED  # key "pid:node" -> fd open time as last seen

while :; do
	[ "$DURATION" -gt 0 ] && [ $((SECONDS - started)) -ge "$DURATION" ] && break
	now=$(cat "$PM" 2>/dev/null) || break

	# --- holders: arrivals and departures -------------------------------------
	declare -A CUR=()
	while read -r key n; do
		[ -n "$key" ] || continue
		CUR["$key"]=$n
		if [ -z "${SEEN[$key]:-}" ]; then
			SEEN["$key"]=$SECONDS
			pid=${key%%:*}; node=${key#*:}
			if [ "$QUIET_POWERD" = 1 ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = nvidia-powerd ]; then
				continue
			fi
			fdnum=$(holders_raw | awk -v p="$pid" -v nd="$node" '$1==p && $3==nd {print $2; exit}')
			say "$(ts)  HOLDER+  $(describe "$pid" "$node" "$fdnum")  fds=$n  gpu=$now"
		fi
	done <<<"$(holder_keys)"

	for key in "${!SEEN[@]}"; do
		if [ -z "${CUR[$key]:-}" ]; then
			say "$(ts)  HOLDER-  ${key%%:*} released ${key#*:} after $((SECONDS - SEEN[$key]))s"
			unset 'SEEN[$key]' 'OPENED[$key]'
			continue
		fi
		# same pid, same node, NEW open time = it closed and re-opened between two ticks
		pid=${key%%:*}; node=${key#*:}
		fdnum=$(holders_raw | awk -v p="$pid" -v nd="$node" '$1==p && $3==nd {print $2; exit}')
		[ -n "$fdnum" ] || continue
		op=$(stat -c '%y' "/proc/$pid/fd/$fdnum" 2>/dev/null | cut -d. -f1)
		[ -n "$op" ] || continue
		if [ -z "${OPENED[$key]:-}" ]; then
			OPENED["$key"]=$op
		elif [ "$op" != "${OPENED[$key]}" ]; then
			say "$(ts)  HOLDER~  $(cat /proc/$pid/comm 2>/dev/null)($pid) RE-OPENED $node  was=${OPENED[$key]} now=$op  gpu=$now"
			OPENED["$key"]=$op
		fi
	done

	# --- power edges -----------------------------------------------------------
	if [ "$now" = active ] && [ "$prev" != active ]; then
		# capture the sleep length BEFORE resetting the marker, or it always reads 0s
		say "$(ts)  ### WOKE   (slept $((SECONDS - wake_start))s)  $(counters)"
		wake_start=$SECONDS
	elif [ "$now" = suspended ] && [ "$prev" = active ]; then
		say "$(ts)  ### SLEPT  (awake $((SECONDS - wake_start))s)  $(counters)"
	fi

	# --- profile writes wake the card through ACPI NVPCF, holding nothing (BUG-161)
	cur_profile=$(cat $PROFILE 2>/dev/null)
	if [ "$cur_profile" != "$prev_profile" ]; then
		say "$(ts)  PROFILE  $prev_profile -> $cur_profile   (a profile write wakes the dGPU, BUG-161)"
		prev_profile=$cur_profile
	fi

	# --- heartbeat: proves the watcher is alive and shows whether it ever slept --
	if [ $((SECONDS - last_beat)) -ge "$HEARTBEAT" ]; then
		cur_susp=$(cat "$PMDIR/runtime_suspended_time" 2>/dev/null || echo 0)
		say "$(ts)  BEAT     state=$now  $(counters)  slept_since_last=$(( (cur_susp - prev_susp) / 1000 ))s  holders=${#SEEN[@]}"
		prev_susp=$cur_susp
		last_beat=$SECONDS
	fi

	prev=$now
	sleep "$INTERVAL"
done

say "----------------------------------------------------------------------"
say "$(ts)  STOP     $(counters)"
