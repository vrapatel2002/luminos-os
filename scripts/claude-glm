#!/usr/bin/env bash
# claude-glm — Claude Code on GLM-5.3 (Abliteration). Plain `claude` stays on the Max plan.
# [CHANGE: cowork | 2026-10-22] DECISION 156. Only THIS process gets the env; nothing global changes.
set -eu
KEYFILE="$HOME/.config/luminos/abliteration.env"
[ -f "$KEYFILE" ] || { echo "No Abliteration key yet — run: luminos-glm-key" >&2; exit 1; }
. "$KEYFILE"
unset ANTHROPIC_API_KEY
# Through luminos-glm-proxy (127.0.0.1:4141), like the GLM desktop window: it turns images into text
# descriptions (GLM-5.3 is text-only, BUG-209) and adds the local-tool rules (BUG-208).
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
systemctl --user start luminos-glm-proxy 2>/dev/null || true
export ANTHROPIC_BASE_URL="http://127.0.0.1:4141"
export ANTHROPIC_AUTH_TOKEN="$GLM_LOCAL_TOKEN"
export ANTHROPIC_MODEL="abliterated-model-large-v2"       # GLM-5.3 (real id; proxy passes it through)
export ANTHROPIC_DEFAULT_OPUS_MODEL="abliterated-model-large-v2"
export ANTHROPIC_DEFAULT_SONNET_MODEL="abliterated-model-large-v2"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="abliterated-model"   # cheap, sees images
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# DECISION 162: the same app-control server the GLM window gets (GLM only; plain `claude` doesn't load it).
MCPCFG="$HOME/.cache/luminos-glm/desktop-mcp.json"; mkdir -p "${MCPCFG%/*}"
printf '{"mcpServers":{"luminos-desktop":{"command":"/usr/bin/python3","args":["%s/luminos-os/scripts/luminos-desktop-mcp"]}}}\n' "$HOME" > "$MCPCFG"
exec "$HOME/.local/bin/claude" --mcp-config "$MCPCFG" "$@"
