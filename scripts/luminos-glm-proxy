#!/usr/bin/env python3
# luminos-glm-proxy — local name translator between Claude Desktop (3P mode) and Abliteration.
# [CHANGE: cowork | 2026-10-22] DECISION 156.
# WHY: Claude Desktop drops any inferenceModels entry whose name is not an Anthropic model
# ("is not an Anthropic model and was removed"), and Abliteration 404s every claude-* name.
# So the app is given Claude-shaped names and this proxy swaps them for the real model:
#   *haiku*  -> abliterated-model          (cheap, reads images)
#   anything else -> abliterated-model-large-v2  (GLM-5.3)
# It also swaps the auth: the app holds only a local token; the real ak_ key stays here.
# Listens on 127.0.0.1 only. Streams responses through chunk by chunk (SSE).
import http.client, json, os, sys, ssl
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler

import importlib.util
_vp = os.path.join(os.path.dirname(os.path.realpath(__file__)), "luminos-vision.py")
_spec = importlib.util.spec_from_file_location("luminos_vision", _vp)
vision = importlib.util.module_from_spec(_spec); _spec.loader.exec_module(vision)

PORT = int(os.environ.get("GLM_PROXY_PORT", "4141"))
UP_HOST = "api.abliteration.ai"
ENVF = os.path.expanduser("~/.config/luminos/abliteration.env")

def load_env():
    d = {}
    for line in open(ENVF):
        if "=" in line:
            k, v = line.strip().split("=", 1); d[k] = v
    return d

CFG = load_env()
REAL_KEY = CFG["ABLITERATION_API_KEY"]
LOCAL_TOKEN = CFG.get("GLM_LOCAL_TOKEN", "")

# BUG-208: GLM-5.3 is offered the local MCP tools but never picks them on its own (0 calls in 3
# sessions, while host-shell got 223). Claude follows CLAUDE.md's "use mempalace / code-review-graph"
# rules; GLM doesn't. So when those tools are in the request, append this FIXED note to the system
# prompt. It is identical on every request, so prompt caching keeps working.
NUDGE_MARK = "[luminos-glm-proxy tool note]"
NUDGE = NUDGE_MARK + """ REQUIRED tool rules for this laptop (these tools are real and connected):
1. At the START of every new task, your FIRST tool call must be mcp__mempalace__mempalace_search with 2-5 keywords for the topic. Use what it returns.
2. BEFORE you edit, refactor or explain any .go or .py file, call a code-review-graph tool on it first (mcp__code-review-graph__get_impact_radius_tool or mcp__code-review-graph__query_graph_tool) to see what depends on it. Do not rely on grep alone.
3. After adding files or changing imports, call mcp__code-review-graph__build_or_update_graph_tool.
4. After a major change, save it with mcp__mempalace__mempalace_add_drawer (wing luminos-os, room decisions), then read it back with mcp__mempalace__mempalace_get_drawer.
5. To run commands directly on this laptop (outside the sandbox) use mcp__host-shell__run_command.
6. You cannot see images yourself. To SEE THE SCREEN, run `luminos-screenshot` with mcp__host-shell__run_command
   (options: `--window` = only the active window, `--ask "question"` = also answer a question about it). It prints a
   detailed text description of what is on the display plus the saved image path. Any image in this chat (pasted, or
   read from a file) has already been replaced by a text description for you.
7. To SEE AND CONTROL OTHER APPS use the mcp__luminos-desktop__* tools: list_windows, focus_window, close_window,
   launch_app, open_url; ui_tree(app or window title) lists an app's buttons/menus/fields as refs e1, e2...; then
   ui_click / ui_set_text / ui_read on those refs; press_keys ("ctrl+s") and type_text for the focused window;
   screenshot for a text description. Prefer ui_tree + ui_click over keyboard guesses; check the result with
   ui_tree or screenshot after each step. Never close or type into a window you did not open unless asked.
8. SEVERAL MODELS AT ONCE: start helper workers on the laptop with mcp__host-shell__run_command:
   `luminos-worker <glm|glm-cheap|opus|sonnet|haiku|fable> [--tools ...] [--cwd DIR] "<brief>"` (JSON out; continue
   one with `--resume <session_id>`). opus/sonnet/haiku/fable are real Claude on Shawn's Max plan. To run several
   AT THE SAME TIME write a jobs file (one "<model> <brief>" per line) and run `luminos-worker --batch jobs.txt`
   (one JSON line per job). A worker's "models_used" shows the real model it ran on.
9. OTHER CHATS: `luminos-chats list`, `luminos-chats read <id>`, `luminos-chats send <id> "msg"` (send works for
   terminal/worker chats; desktop-window chats are read-only).
10. SKILLS: use the Skill tool. Shawn's own skills (build, llm-council, prompt-engineer, deep-research,
   skill-creator) come from the luminos-skills plugin — if /build is missing, tell him to upload
   ~/luminos-os/config/glm/luminos-skills.plugin in Customize → Plugins.
If one of these tools is listed as deferred, load it with ToolSearch first."""

def add_nudge(j):
    names = [t.get("name", "") for t in (j.get("tools") or []) if isinstance(t, dict)]
    blob = " ".join(names)
    if "mempalace" not in blob and "code-review-graph" not in blob and "ToolSearch" not in blob and "host-shell" not in blob and "luminos-desktop" not in blob:
        return False
    sysp = j.get("system")
    if isinstance(sysp, str):
        if NUDGE_MARK in sysp: return False
        j["system"] = [{"type": "text", "text": sysp}, {"type": "text", "text": NUDGE}]
    elif isinstance(sysp, list):
        if any(NUDGE_MARK in (b.get("text") or "") for b in sysp if isinstance(b, dict)): return False
        sysp.append({"type": "text", "text": NUDGE})
    else:
        j["system"] = [{"type": "text", "text": NUDGE}]
    return True

REAL = ("abliterated-model", "abliterated-model-large-v2", "abliterated-model-large")
def map_model(name):
    n = (name or "").lower()
    if n in REAL: return n
    return "abliterated-model" if "haiku" in n else "abliterated-model-large-v2"

HOP = {"host", "content-length", "connection", "authorization", "x-api-key",
       "accept-encoding", "transfer-encoding", "keep-alive"}

class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def log_message(self, fmt, *a):
        sys.stderr.write("%s\n" % (fmt % a))

    def _auth_ok(self):
        if not LOCAL_TOKEN:
            return True
        got = self.headers.get("authorization", "").removeprefix("Bearer ").strip() \
              or self.headers.get("x-api-key", "").strip()
        return got == LOCAL_TOKEN

    def _send_json(self, code, obj):
        b = json.dumps(obj).encode()
        self.send_response(code); self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(b))); self.end_headers(); self.wfile.write(b)

    def do_GET(self):
        if self.path.split("?")[0] in ("/health", "/"):
            return self._send_json(200, {"ok": True})
        if self.path.split("?")[0] == "/v1/models":
            ids = ["claude-opus-4-5", "claude-haiku-4-5"]
            return self._send_json(200, {"data": [{"id": i, "type": "model", "display_name": i} for i in ids],
                                         "has_more": False})
        self._send_json(404, {"type": "error", "error": {"type": "not_found_error", "message": self.path}})

    def do_POST(self):
        if not self._auth_ok():
            return self._send_json(401, {"type": "error", "error": {"type": "authentication_error", "message": "bad local token"}})
        body = self.rfile.read(int(self.headers.get("content-length", 0) or 0))
        asked = None
        try:
            j = json.loads(body)
            if isinstance(j, dict) and "model" in j:
                asked = j["model"]; j["model"] = map_model(asked)
                # BUG-209: GLM-5.3 is text-only (images -> HTTP 400). Swap each image for a description.
                if j["model"] == "abliterated-model-large-v2" and vision.has_images(j):
                    st = vision.strip_images(j, do_describe=not self.path.startswith("/v1/messages/count_tokens"))
                    sys.stderr.write("vision: %d image(s) described, %d from cache\n" % (st["images"], st["cached"]))
                if self.path.startswith("/v1/messages") and not self.path.startswith("/v1/messages/count_tokens"):
                    nudged = add_nudge(j)
                    tn = [t.get("name","") for t in (j.get("tools") or []) if isinstance(t, dict)]
                    sys.stderr.write("tools=%d mcp_local=%d toolsearch=%s nudge=%s\n" % (len(tn),
                        sum(1 for n in tn if "mempalace" in n or "code-review-graph" in n), "ToolSearch" in tn, nudged))
                body = json.dumps(j).encode()
        except Exception:
            pass
        hdrs = {k: v for k, v in self.headers.items() if k.lower() not in HOP}
        hdrs["authorization"] = "Bearer " + REAL_KEY
        hdrs["content-length"] = str(len(body))
        conn = http.client.HTTPSConnection(UP_HOST, 443, timeout=900, context=ssl.create_default_context())
        try:
            conn.request("POST", self.path, body=body, headers=hdrs)
            r = conn.getresponse()
        except Exception as e:
            return self._send_json(502, {"type": "error", "error": {"type": "api_error", "message": "upstream: %s" % e}})
        sys.stderr.write("POST %s model %s -> %s : %s\n" % (self.path, asked, map_model(asked) if asked else "-", r.status))
        self.send_response(r.status)
        for k, v in r.getheaders():
            if k.lower() not in ("transfer-encoding", "connection", "content-length", "content-encoding"):
                self.send_header(k, v)
        self.send_header("transfer-encoding", "chunked"); self.end_headers()
        try:
            while True:
                chunk = r.read1(65536) if hasattr(r, "read1") else r.read(4096)
                if not chunk:
                    break
                self.wfile.write(b"%x\r\n%s\r\n" % (len(chunk), chunk)); self.wfile.flush()
            self.wfile.write(b"0\r\n\r\n"); self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            conn.close()

if __name__ == "__main__":
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), H)
    sys.stderr.write("luminos-glm-proxy on 127.0.0.1:%d\n" % PORT)
    srv.serve_forever()
