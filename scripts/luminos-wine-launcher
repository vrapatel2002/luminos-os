#!/bin/bash
# Luminos Wine Launcher
# Shows GPU selector before every Wine app
# [CHANGE: gemini-cli | 2026-05-11]
# Usage: luminos-wine-launcher <exe> [args...]

EXE="$1"
shift
ARGS="$@"
APP_NAME=$(basename "$EXE" .exe)

# ---- Path A gate: loose installer → offer its own isolated prefix ----
# When the file-manager hands us a bare .exe/.msi (no isolated WINEPREFIX, and
# the file lives outside any per-app prefix), it's usually an installer the user
# just downloaded. Offer to give it its OWN Wine space so uninstall is one clean
# step later. Calls FROM a generated per-app launcher already set
# WINEPREFIX=~/.local/share/wineprefixes/... → skip the prompt and just run.
# [CHANGE: claude-code | 2026-07-08]
_PFX="${WINEPREFIX:-$HOME/.wine}"
case "$_PFX::$EXE" in
  "$HOME/.local/share/wineprefixes/"*) : ;;                       # already isolated → run
  *::"$HOME/.local/share/wineprefixes/"*) : ;;                    # exe inside a prefix → run
  *)
    if printf '%s' "$EXE" | grep -qiE '\.(exe|msi)$'; then
      ACT="$(kdialog --title "Open Windows program" \
        --menu "How should Luminos open '$(basename "$EXE")'?" \
        install "Install as its own isolated app (recommended)" \
        run     "Run once in the shared space" 2>/dev/null)" || exit 0
      [ "$ACT" = "install" ] && exec /usr/local/bin/luminos-wine-install "$EXE"
    fi
    ;;
esac

# Show GPU selection dialog
GPU_CHOICE=$(kdialog \
  --title "Luminos — $APP_NAME" \
  --menu "Select GPU for $APP_NAME:" \
  "igpu" "AMD Radeon 780M (Cool & Silent)" \
  "nvidia" "NVIDIA RTX 4050 (Games & AI)" \
  2>/dev/null)

# Handle cancel
if [ -z "$GPU_CHOICE" ]; then
  exit 0
fi

if [ "$GPU_CHOICE" = "igpu" ]; then
  export DRI_PRIME=0
  export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.json
  # [CHANGE: claude-code | 2026-08-05] restored from the installed copy, which
  # had these and the repo copy had lost them.
  export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
  export WINEDLLOVERRIDES="d3d11=b;d3d10core=b;d3d9=b;dxgi=b"
  notify-send "HIVE" \
    "$APP_NAME running on AMD iGPU (cool mode)" \
    --icon=dialog-information

elif [ "$GPU_CHOICE" = "nvidia" ]; then
  export DRI_PRIME=1
  export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
  export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/60_nvidia.json
  # [CHANGE: claude-code | 2026-08-05] BUG-103: removed
  #   echo "on" > /sys/bus/pci/devices/0000:01:00.0/power/control
  # `on` does not merely wake the card, it DISABLES runtime power management for
  # the device, and nothing anywhere wrote `auto` back — so the RTX 4050 stayed
  # awake burning ~1.6 W forever, long after the app exited. All three launchers
  # end in `exec`, so there was no "after" in which to restore it.
  # No wake is needed: with power/control=auto the nvidia driver takes a runtime-PM
  # reference when a device node is opened, so the card comes up on demand and
  # re-suspends by itself ~18 s after the last close. Measured 2026-08-05.
  notify-send "HIVE" \
    "$APP_NAME running on NVIDIA RTX 4050" \
    --icon=dialog-information
fi

# Launch the Wine app
# [CHANGE: claude-code | 2026-08-18] BUG-136: the NVIDIA branch set every env var
# correctly but then ran a bare `exec wine`, so the process never passed through the
# DECISION 25 setgid gate. /dev/nvidia0 and /dev/nvidiactl are root:dgpu 0660 and the
# dgpu group is deliberately empty, so the NVIDIA Vulkan ICD could not open them and
# every Wine app silently fell back to the Radeon 780M. luminos-gpu-launch has always
# done this; this launcher was the one that was missed.
# v2, not v1: v1 raises only the effective gid and bash drops it at startup (BUG-102).
if [ "$GPU_CHOICE" = "nvidia" ]; then
  exec dgpu-exec-v2 wine "$EXE" $ARGS
fi
exec wine "$EXE" $ARGS
