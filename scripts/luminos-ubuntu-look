#!/usr/bin/env bash
# luminos-ubuntu-look — apply an Ubuntu (Yaru) look to KDE Plasma without switching to GNOME.
# Sets icons + cursor + fonts + a Ubuntu-orange color scheme, points GTK apps at Yaru, then
# re-syncs the login/lock screens. Idempotent — safe to re-run. Reversible (see --revert).
#
# Requires (install first): yaru-icon-theme yaru-gtk-theme ttf-ubuntu-font-family
#
# [CHANGE: claude-code | 2026-07-22]
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"

# [CHANGE: claude-code | 2026-10-10] DECISION 139 phase 2 (icons): single-colour icons like Nexus.
# YAMIS (AUR yamis-icon-theme-git) recolours to the KDE text colour (ColorScheme-Text).
ICON_THEME=yet-another-monochrome-icon-set
CURSOR_THEME=Yaru
COLOR_SCHEME=Yaru
# [CHANGE: claude-code | 2026-10-10] DECISION 139 phase 2: KDE font keys are owned by
# luminos-kde-caelestia-theme (Google Sans Flex). This script no longer writes them.
GTK_FONT="Google Sans Flex 10"

log() { echo "luminos-ubuntu-look: $*"; }
# set_ini file key value — replace "key=..." in place, or add it under [Settings]. Keeps everything else.
set_ini() { if grep -q "^$2=" "$1"; then sed -i "s|^$2=.*|$2=$3|" "$1"; else sed -i "/^\[Settings\]/a $2=$3" "$1"; fi; }

apply() {
	# 1. Install the Ubuntu-orange color scheme into the user's KDE dir.
	local dest="$HOME/.local/share/color-schemes"
	mkdir -p "$dest"
	install -m644 "$REPO_DIR/share/color-schemes/Yaru.colors" "$dest/Yaru.colors"

	# 2. Color scheme (live, via D-Bus to the running session).
	# [CHANGE: claude-code | 2026-10-10] DECISION 139: Caelestia (luminos-kde-caelestia-theme) owns
	# the colours now. Only fall back to Yaru when the scheme is blank/Breeze, never over a named one.
	local cur; cur="$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null || true)"
	case "$cur" in
		""|Breeze*|breeze*) plasma-apply-colorscheme "$COLOR_SCHEME" 2>/dev/null || \
			kwriteconfig6 --file kdeglobals --group General --key ColorScheme "$COLOR_SCHEME" ;;
		*) log "colour scheme '$cur' kept (not overriding with $COLOR_SCHEME)" ;;
	esac

	# 2b. Icon fallback chain — Yaru ships with only "Humanity,hicolor" as fallback and Humanity
	# isn't installed, so any icon Yaru lacks renders as a broken "?" placeholder. Point the gaps at
	# Papirus (near-complete) → breeze (KDE app icons) → hicolor. Idempotent; re-applied here so a
	# `yaru-icon-theme` package update (which rewrites index.theme) can't reintroduce the "?" icons.
	#
	# [CHANGE: claude-code | 2026-07-26] BUG-090. Two fixes:
	#   - "Humanity" was left at the FRONT of the chain even though it is not installed. Every
	#     icon miss then logged `Icon theme "Humanity" not found` — 58 times in one day.
	#   - This used `kwriteconfig6`, which rewrites the file with its groups sorted, burying
	#     [Icon Theme] at line 651 of 789. The freedesktop Icon Theme spec requires [Icon Theme]
	#     to be the FIRST group. Use the order-preserving helper instead.
	for t in Yaru Yaru-dark; do
		[[ -f "/usr/share/icons/$t/index.theme" ]] || continue
		sudo -n python3 "$REPO_DIR/scripts/luminos-icon-inherits.py" \
			"/usr/share/icons/$t/index.theme" "Papirus,breeze,hicolor" || \
			log "warn: could not set the icon fallback chain for $t"
	done
	sudo -n gtk-update-icon-cache -f /usr/share/icons/Yaru 2>/dev/null || true  # [CHANGE: claude-code | 2026-10-10] -n: never hang
	# [CHANGE: claude-code | 2026-10-10] YAMIS ships Inherits=...,Cosmic,... (not installed) —
	# same fix, same helper; config/pacman-hooks/luminos-yamis-icons.hook re-applies it on upgrade.
	local ym=/usr/share/icons/yet-another-monochrome-icon-set
	if [[ -f "$ym/index.theme" ]]; then
		sudo -n python3 "$REPO_DIR/scripts/luminos-icon-inherits.py" "$ym/index.theme" \
			"Papirus-Dark,breeze-dark,Adwaita,hicolor" || log "FAIL: YAMIS fallback chain not set (sudo -n needs passwordless sudo)"
		sudo -n gtk-update-icon-cache -f -q "$ym" 2>/dev/null || log "warn: YAMIS icon cache not refreshed"
	else log "warn: $ym missing — install yamis-icon-theme-git"; fi

	# 3. Icons — plasma-changeicons applies live; fall back to config write.
	local changeicons=""
	if command -v plasma-changeicons >/dev/null 2>&1; then changeicons="$(command -v plasma-changeicons)";
	elif [[ -x /usr/lib/plasma-changeicons ]]; then changeicons=/usr/lib/plasma-changeicons; fi
	[[ -n "$changeicons" ]] && "$changeicons" "$ICON_THEME" 2>/dev/null || true
	kwriteconfig6 --file kdeglobals --group Icons --key Theme "$ICON_THEME"

	# 4. Cursor (Yaru cursors ship inside yaru-icon-theme).
	plasma-apply-cursortheme "$CURSOR_THEME" 2>/dev/null || \
		kwriteconfig6 --file kcminputrc --group Mouse --key cursorTheme "$CURSOR_THEME"

	# 5. Fonts: not touched here any more (see GTK_FONT note).  [CHANGE: claude-code | 2026-10-10]

	# 6. GTK apps. [CHANGE: claude-code | 2026-10-10] Edited key-by-key in place — the old whole-file
	# rewrite replaced adw-gtk3-dark/prefer-dark with Yaru/light and dropped every other key
	# (config/gtk-*/settings.ini in the repo must stay byte-identical to the live files).
	# Icons + font always; the Yaru GTK theme only when the Yaru colour scheme is actually live.
	local yaru=0; [[ "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)" == "$COLOR_SCHEME" ]] && yaru=1
	for v in gtk-3.0 gtk-4.0; do
		local ini="$HOME/.config/$v/settings.ini"
		mkdir -p "$(dirname "$ini")"; [[ -f "$ini" ]] || printf '[Settings]\n' >"$ini"
		set_ini "$ini" gtk-icon-theme-name "$ICON_THEME"
		set_ini "$ini" gtk-font-name "$GTK_FONT"
		if [[ $yaru -eq 1 ]]; then
			set_ini "$ini" gtk-theme-name Yaru
			set_ini "$ini" gtk-cursor-theme-name "$CURSOR_THEME"
		fi
	done
	if command -v gsettings >/dev/null 2>&1; then
		[[ $yaru -eq 1 ]] && gsettings set org.gnome.desktop.interface gtk-theme "Yaru" 2>/dev/null
		gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME" 2>/dev/null || true
		gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR_THEME" 2>/dev/null || true
		gsettings set org.gnome.desktop.interface font-name "$GTK_FONT" 2>/dev/null || true
	fi

	# 7. Re-sync login + lock screens to the current wallpaper.
	if command -v luminos-theme-sync >/dev/null 2>&1; then
		sudo -n luminos-theme-sync || log "warn: theme-sync failed (run it manually with sudo)"
	fi

	log "applied: icons=$(kreadconfig6 --file kdeglobals --group Icons --key Theme), scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme). Some apps update on next launch."
}

revert() {
	# [CHANGE: claude-code | 2026-10-10] Undo the ICON part of this look consistently (Qt, kdedefaults,
	# GTK, gsettings) back to the pre-Nexus Papirus-Dark. Colours are left to their owner.
	local t=Papirus-Dark v
	/usr/lib/plasma-changeicons "$t" >/dev/null 2>&1 || true
	kwriteconfig6 --file kdeglobals --group Icons --key Theme "$t"
	kwriteconfig6 --file "$HOME/.config/kdedefaults/kdeglobals" --group Icons --key Theme "$t"
	for v in gtk-3.0 gtk-4.0; do [[ -f "$HOME/.config/$v/settings.ini" ]] && set_ini "$HOME/.config/$v/settings.ini" gtk-icon-theme-name "$t"; done
	gsettings set org.gnome.desktop.interface icon-theme "$t" 2>/dev/null || true
	log "reverted icons → $t (Qt + GTK, read back: $(kreadconfig6 --file kdeglobals --group Icons --key Theme))."
	log "NOTE: luminos-ubuntu-persist (login) re-heals icons to $ICON_THEME — set its ICONS too, or it comes back."
	log "Colours: luminos-kde-caelestia-theme (undo: ~/.local/share/luminos-kde-backup/restore-kde-config)."
	log "Window style (Darkly/frame/icon key): undo with  luminos-windowstyle revert"
}

case "${1:-apply}" in
	apply)  apply ;;
	--revert|revert) revert ;;
	*) echo "usage: $0 [apply|--revert]"; exit 2 ;;
esac
