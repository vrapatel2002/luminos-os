#!/usr/bin/env python3
# [CHANGE: claude-code | 2026-09-02] Wake the media server. DECISION 89.
#
# Deliberately stdlib-only. `wakeonlan` and `etherwake` both exist as packages,
# but installing either on the G14 means touching pacman while 213 upgrades are
# pending, and one of those bumps kirigami and reverts the desktop look
# (DECISION 72). A magic packet is 102 bytes; it does not justify that risk.
#
# A magic packet must reach the server's BROADCAST address, not its unicast IP:
# the machine is off, so nothing will answer ARP for 192.168.2.62 and a unicast
# packet has nowhere to go. That is the single most common reason WoL "doesn't
# work". It also means this only works from the same LAN -- broadcast does not
# cross the tailnet, so this cannot wake the box from outside the house.
#
#   luminos-wake-server            # send the packet
#   luminos-wake-server --wait     # send, then wait for SSH to answer

import argparse
import socket
import subprocess
import sys
import time

MAC = "c0:3e:ba:29:2d:c8"     # enp2s0, the wire. NOT the wifi MAC.
BROADCAST = "192.168.2.255"
HOST = "192.168.2.61"


def magic_packet(mac: str) -> bytes:
    raw = bytes.fromhex(mac.replace(":", "").replace("-", ""))
    if len(raw) != 6:
        raise ValueError(f"not a MAC address: {mac}")
    return b"\xff" * 6 + raw * 16


def send(mac: str, dest: str) -> None:
    pkt = magic_packet(mac)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        # Ports 9 and 7 are both conventional; some NICs listen on only one.
        for port in (9, 7):
            s.sendto(pkt, (dest, port))
    print(f"sent magic packet for {mac} to {dest}:9 and :7 ({len(pkt)} bytes)")


def already_up(host: str) -> bool:
    return subprocess.run(
        ["ping", "-c1", "-W1", host],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode == 0


def wait_for(host: str, timeout: int = 180) -> bool:
    print(f"waiting up to {timeout}s for {host} to answer...")
    start = time.monotonic()
    while time.monotonic() - start < timeout:
        if already_up(host):
            print(f"up after {time.monotonic() - start:.0f}s")
            return True
        time.sleep(3)
    print(f"still not answering after {timeout}s", file=sys.stderr)
    return False


def main() -> int:
    ap = argparse.ArgumentParser(description="Wake the Luminos media server.")
    ap.add_argument("--wait", action="store_true", help="block until it responds")
    ap.add_argument("--mac", default=MAC)
    ap.add_argument("--broadcast", default=BROADCAST)
    args = ap.parse_args()

    if already_up(HOST):
        print(f"{HOST} is already up -- nothing to do")
        return 0

    send(args.mac, args.broadcast)
    if args.wait:
        return 0 if wait_for(HOST) else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
