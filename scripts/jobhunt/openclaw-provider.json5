// Point OpenClaw at the local GPU LLM instead of a cloud API.
// [CHANGE: claude-code | 2026-08-05] Phase 0b — jobhunt infrastructure.
//
// Apply with:  openclaw config patch --file scripts/jobhunt/openclaw-provider.json5
// (add --dry-run first; patch is a single validated write, objects merge)
//
// WHY api: "openai-completions" — llama-cpp-python's server speaks the OpenAI
// wire format, so OpenClaw needs no special adapter. baseUrl must include /v1.
//
// WHY a dummy apiKey — the local server has NO auth (that is why it binds to
// 127.0.0.1 only). OpenClaw still wants the field populated, so this is a
// placeholder, not a secret. Do not treat it as one.
//
// WHY the model id is an alias and not a path — llm-server.sh passes
// --model_alias, so swapping the 7B for a 4B does not break this config.
{
  models: {
    mode: "merge",
    providers: {
      luminos: {
        // PORT 8082 IS THE PROXY, NOT THE MODEL SERVER (8081). Pointing this
        // straight at 8081 works for plain chat and then silently breaks every
        // tool call — the model's <tool_call> text arrives as prose and the agent
        // hangs waiting on a result it never asked for. See toolcall-proxy.py.
        baseUrl: "http://127.0.0.1:8082/v1",
        apiKey: "local-no-auth",
        api: "openai-completions",
        models: [
          {
            id: "luminos-local",
            name: "Gemma 4 E4B (local, fast, 24k ctx)",
            // MUST match llm-server.sh's CTX. OpenClaw assumes 200k for unknown
            // models and would build a prompt 8x larger than the server's window.
            //
            // This is a floor, not a preference. OpenClaw's system prompt plus
            // tool schemas TOKENIZE to 19929 on an empty session — note its own
            // preflight estimate says 9456, which is less than half the truth, so
            // trust the 400 from the server and not the estimate.
            contextWindow: 24576,
            maxTokens: 2048,
          },
          {
            id: "luminos-local-moe",
            name: "Gemma 4 26B A4B MoE (local, 24k ctx)",
            contextWindow: 24576,
            maxTokens: 4096,
          },
          {
            // [CHANGE: claude-code | 2026-08-17] 36864 -> 16384. Not a downgrade:
            // 36k only loaded with 13 of 33 layers on the CPU and ran at 7.13
            // tok/s, so a full context was hours of generation. 16k fits entirely
            // on the card and runs at 36.7. This number must match LLM_CTX3 in
            // jobhunt-llm.service — OpenClaw trims history to whatever is here,
            // so setting it higher than the server just means the server truncates
            // silently instead.
            id: "luminos-dolphin",
            name: "Dolphin 3.0 Llama 3.1 8B (local, uncensored, 16k ctx)",
            contextWindow: 16384,
            maxTokens: 2048,
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      model: {
        primary: "luminos/luminos-local",
      },
      compaction: {
        maxHistoryShare: 0.8,
        reserveTokens: 2048,
        reserveTokensFloor: 0,
        keepRecentTokens: 4096,
        recentTurnsPreserve: 4,
        truncateAfterCompaction: true,
        memoryFlush: {
          enabled: false,
        },
      },
    },
  },
  // [CHANGE: claude-code | 2026-08-17] Cut the tool list from 28 to 11.
  //
  // WHY, measured with the model's OWN tokenizer (not OpenClaw's estimate, which
  // is less than half the truth). OpenClaw re-sends its instructions plus every
  // tool's JSON schema on EVERY turn. On Gemma, 24576 window, budget 17612:
  //   28 tools -> 15956 tokens of fixed overhead ->  1656 left for the chat
  //   11 tools ->  9944 tokens of fixed overhead ->  7668 left for the chat
  // 4.6x more room. The saving is bigger than the schemas alone because the
  // system prompt LISTS the tools too (32224 -> 28330 chars).
  //
  // THIS IS WHY COMPACTION LOOKED BROKEN. Compaction can only shrink the
  // conversation history — it cannot touch the system prompt or the tool
  // schemas, which were 91% of the budget. So OpenClaw hit
  // "Context overflow: prompt too large for the model (precheck)" and errored
  // instead of compacting. Across 32 recorded sessions, compaction had fired
  // exactly ONCE. See BUG-135.
  //
  // WHY `deny` AND NOT `allow`/`profile`: deny always wins and is unambiguous.
  // `tools.profile` sets a base allowlist that `allow` then modifies, and the
  // docs do not say whether `allow` widens or narrows it. Blunt on purpose.
  //
  // KEPT (11): read, write, edit, apply_patch, exec, process, web_search,
  //   web_fetch, memory_search, memory_get, session_status.
  // Verified by driving a real turn and reading the trajectory back, not by
  // trusting the config: `openclaw agent --agent main -m "..."` then reading
  // `context.compiled` in ~/.openclaw/agents/main/sessions/*.trajectory.jsonl.
  tools: {
    deny: [
      // 5868 chars — the single biggest tool, 19% of the whole block.
      // Reminders and scheduled wake-ups. Luminos already has systemd timers.
      "cron",
      // Restart/reconfigure/update the OpenClaw process from inside a chat.
      // Removing it means the agent cannot restart itself — do it from a shell.
      "gateway",
      // Send messages out over a chat channel. NO channel is connected (see
      // LUMINOS_STATUS Phase 0b), so this was pure overhead.
      "message",
      // Control paired phones/desktops: camera, screen, location, notifications.
      // No nodes are paired.
      "nodes",
      // Runs Ollama models on paired nodes. AGENTS.md bans Ollama outright.
      "node_inference",
      // Sub-agents and cross-session reads. A 6 GB card holds ONE model; a
      // sub-agent would fight the parent for the same VRAM. Cost of removal:
      // no delegation, no reading other chats. Both were unusable anyway.
      "sessions_spawn", "sessions_list", "sessions_send", "sessions_history",
      "sessions_yield", "subagents", "agents_list",
      // Proposes reusable skills. Authoring feature, not a chat feature.
      "skill_workshop",
      // Long-horizon goal tracking. Useful for multi-hour autonomous runs,
      // which is not what this box does.
      "create_goal", "update_goal", "get_goal",
      // Text to speech. No audio path configured.
      "tts",
    ],
  },
}
