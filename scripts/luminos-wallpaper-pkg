"""Luminous KDE Plasma live-wallpaper plugin — package/manifest layer."""

from __future__ import annotations

import os.path

_KNOWN_PROP_TYPES = {"slider", "color", "dropdown", "textbox", "checkbox", "file", "button", "label"}

def validate_properties(schema: dict) -> tuple[dict, list[str]]:
    ok: dict = {}
    skipped: list[str] = []
    try:
        pairs = list(schema.items())
    except AttributeError:
        return {}, []
    for key, val in pairs:
        try:
            if isinstance(val, dict) and val.get("type") in _KNOWN_PROP_TYPES:
                ok[key] = val
            else:
                skipped.append(key)
        except Exception:
            skipped.append(key)
    return ok, skipped


def merge_props(schema: dict, saved: dict) -> dict:
    result: dict = {}
    try:
        keys = list(schema.keys())
    except AttributeError:
        return result
    safe_saved = saved if isinstance(saved, dict) else {}
    for key in keys:
        if key in safe_saved:
            result[key] = safe_saved[key]
        else:
            entry = schema[key]
            try:
                result[key] = entry["value"] if isinstance(entry, dict) else None
            except (KeyError, TypeError):
                result[key] = None
    return result


def _path_safe(path: str) -> bool:
    try:
        if not isinstance(path, str):
            return False
        if '\x00' in path:
            return False
        if path.startswith('~') or path.startswith('\\\\'):
            return False
        if os.path.isabs(path):
            return False
        return '..' not in path.replace('\\', '/').split('/')
    except Exception:
        return False


def parse_manifest(d: dict) -> tuple[dict | None, list[str]]:
    errors: list[str] = []
    try:
        if not isinstance(d, dict):
            return None, ["input is not a dict"]
    except Exception:
        return None, ["input is not a dict"]

    for key in ("id", "title", "type", "entry"):
        if key not in d:
            errors.append(f"missing required key: {key}")
    if errors:
        return None, errors

    for field in ("entry", "preview"):
        val = d.get(field)
        if val is not None and not _path_safe(val):
            errors.append(f"unsafe path in '{field}': {val!r}")
    if errors:
        return None, errors

    manifest = {
        "id": d["id"],
        "title": d["title"],
        "type": d["type"],
        "entry": d["entry"],
        "interactive": d.get("interactive", False),
        "source": d.get("source", "native"),
        "version": d.get("version", 1),
        "preview": d.get("preview"),
        "properties": d.get("properties"),
    }
    return manifest, []


if __name__ == "__main__":
    import argparse, json, sys

    ap = argparse.ArgumentParser(prog="luminos_wallpaper_pkg")
    sub = ap.add_subparsers(dest="cmd")

    vp = sub.add_parser("validate")
    vp.add_argument("manifest")

    ip = sub.add_parser("import-lively")
    ip.add_argument("lively_info")
    ip.add_argument("pkg_id")

    args = ap.parse_args()

    if args.cmd == "validate":
        with open(args.manifest) as f:
            manifest, errors = parse_manifest(json.load(f))
        print(json.dumps({"ok": manifest is not None, "errors": errors}))
        sys.exit(0 if manifest is not None else 1)
    elif args.cmd == "import-lively":
        with open(args.lively_info) as f:
            print(json.dumps(lively_to_manifest(json.load(f), args.pkg_id), indent=2))
        sys.exit(0)
    else:
        ap.print_help()
        sys.exit(1)
