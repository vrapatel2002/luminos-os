#!/usr/bin/env python3
"""What the live wallpaper actually costs, as numbers.  SPEC §9.

[CHANGE: claude-code | 2026-09-19] DECISION 119
SPDX-License-Identifier: GPL-3.0-or-later

    luminos-wallpaper-cost [seconds]        (default 10)

"Lighter than Chromium" is a claim until someone measures it, and the measurement
has to be repeatable by the person who doubts it. Run this on the box.

What it reports, and what each number honestly means:

  chromium mapped  Is libQt6WebEngineCore in plasmashell's maps? This is the one
                   unambiguous answer here — the browser engine is either paged
                   into the shell or it is not. DECISION 112 is what made it
                   possible for it not to be.
  PSS              Proportional set size of plasmashell from smaps_rollup, which
                   divides shared libraries by how many processes map them. RSS
                   double-counts and is why a shell can look like it owns a
                   gigabyte it shares with everything else.
  CPU              Jiffies over the sample window, as a percentage of ONE core.

  This measures plasmashell, which is the desktop AND the wallpaper. It cannot
  separate them, and it does not pretend to: what it gives you is the same number
  before and after a change, taken the same way.
"""
import os, sys, time

_HZ = os.sysconf("SC_CLK_TCK") or 100
_BASELINE = (
    "BUG-083, 2026-07-24, web mode with Chromium: ~24% of a core visible, ~810 MB RSS.\n"
    "  DECISION 113 replaced the bundled effects with native QML; DECISION 112 made\n"
    "  the browser engine load only if web mode is actually selected."
)


def pids_named(name):
    out = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            comm = open("/proc/%s/comm" % entry).read().strip()
        except OSError:
            continue
        if comm == name:
            out.append(entry)
    return out


def maps_contain(pid, needle):
    try:
        with open("/proc/%s/maps" % pid) as fh:
            return any(needle in line for line in fh)
    except OSError:
        return None


def pss_kb(pid):
    try:
        for line in open("/proc/%s/smaps_rollup" % pid):
            if line.startswith("Pss:"):
                return int(line.split()[1])
    except OSError:
        pass
    return None


def jiffies(pid):
    try:
        parts = open("/proc/%s/stat" % pid).read().rsplit(") ", 1)[1].split()
    except (OSError, IndexError):
        return None
    return int(parts[11]) + int(parts[12])          # utime + stime


def wallpaper_config():
    """The wallpaper's own settings, straight from the containment config."""
    path = os.path.expanduser("~/.config/plasma-org.kde.plasma.desktop-appletsrc")
    wanted = ("WallpaperMode", "QmlScene", "AudioReactive", "SceneProperties")
    found = {}
    try:
        for line in open(path, errors="replace"):
            key, _, value = line.partition("=")
            if key.strip() in wanted:
                found.setdefault(key.strip(), value.strip())
    except OSError:
        return {}
    return found


def sample(pid, seconds):
    start = jiffies(pid)
    if start is None:
        return None
    time.sleep(seconds)
    end = jiffies(pid)
    return None if end is None else (end - start) * 100.0 / (_HZ * seconds)


def main(argv):
    seconds = 10
    if len(argv) > 1:
        try:
            seconds = max(1, min(120, int(argv[1])))
        except ValueError:
            print("usage: luminos-wallpaper-cost [seconds]")
            return 2

    pids = pids_named("plasmashell")
    if not pids:
        print("plasmashell is not running — nothing to measure.")
        return 1
    pid = pids[0]

    cfg = wallpaper_config()
    print("plasmashell pid %s" % pid)
    print("  mode           %s / scene %s"
          % (cfg.get("WallpaperMode", "?"), cfg.get("QmlScene", "?")))
    print("  audio          %s" % cfg.get("AudioReactive", "false"))

    web = maps_contain(pid, "libQt6WebEngineCore")
    print("  chromium       %s" % ("MAPPED — web mode is loaded" if web
                                   else "not mapped" if web is False else "unreadable"))
    for lib in ("libcava", "libaubio", "libpipewire"):
        if maps_contain(pid, lib):
            print("  audio stack    %s mapped" % lib)

    pss = pss_kb(pid)
    print("  PSS            %s" % ("%.0f MB" % (pss / 1024.0) if pss else "unreadable"))
    print("  sampling CPU for %ds ..." % seconds)
    cpu = sample(pid, seconds)
    print("  CPU            %s" % ("%.1f%% of one core" % cpu if cpu is not None else "unreadable"))

    print("\nfor comparison:\n  %s" % _BASELINE)
    print("\nThis is plasmashell as a whole — the desktop AND the wallpaper. It cannot")
    print("separate them. Take it the same way before and after a change and the")
    print("difference is the thing you changed.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
