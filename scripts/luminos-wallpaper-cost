#!/usr/bin/env python3
"""What the live wallpaper actually costs, as numbers.  SPEC §9.

[CHANGE: claude-code | 2026-09-19] DECISION 119 — the reasoning lives there.
SPDX-License-Identifier: GPL-3.0-or-later

    luminos-wallpaper-cost [seconds]        (default 10)

"Lighter than Chromium" is a claim until someone measures it, and the measurement
has to be repeatable by whoever doubts it. Run this on the box. It reports whether
libQt6WebEngineCore is mapped into plasmashell at all (the one unambiguous answer
here), PSS rather than RSS — RSS double-counts shared libraries, which is why a
shell can look like it owns a gigabyte it shares — and CPU as a percentage of one
core. It measures plasmashell — desktop AND wallpaper — and cannot separate them.
"""
import os, sys, time

_HZ = os.sysconf("SC_CLK_TCK") or 100
_CONFIG = "~/.config/plasma-org.kde.plasma.desktop-appletsrc"
_PLUGIN = "org.luminos.livewallpaper"
_DEFAULTS = {"WallpaperMode": "image", "QmlScene": "shader",
             "AudioReactive": "false", "SceneProperties": "{}",
             # Same default as config/main.xml: freeze whenever the desktop is hidden.
             "ObscurePolicy": "2"}
_BASELINE = (
    "BUG-083, 2026-07-24, web mode with Chromium: ~24% of a core visible, ~810 MB RSS.\n"
    "  DECISION 113 replaced the bundled effects with native QML; DECISION 112 made\n"
    "  the browser engine load only if web mode is actually selected."
)


def pids_named(name):
    out = []
    for entry in os.listdir("/proc"):
        try:
            if entry.isdigit() and open("/proc/%s/comm" % entry).read().strip() == name:
                out.append(entry)
        except OSError:
            continue
    return out

def maps_contain(pid, needle):
    try:
        with open("/proc/%s/maps" % pid) as fh:
            return any(needle in line for line in fh)
    except OSError:
        return None

def pss_kb(pid):
    try:
        for line in open("/proc/%s/smaps_rollup" % pid):
            if line.startswith("Pss:"):
                return int(line.split()[1])
    except OSError:
        pass
    return None

def jiffies(pid):
    try:
        parts = open("/proc/%s/stat" % pid).read().rsplit(") ", 1)[1].split()
    except (OSError, IndexError):
        return None
    return int(parts[11]) + int(parts[12])          # utime + stime

def sample(pid, seconds):
    start = jiffies(pid)
    if start is None:
        return None
    time.sleep(seconds)
    end = jiffies(pid)
    return None if end is None else (end - start) * 100.0 / (_HZ * seconds)


def wallpaper_config():
    """OUR plugin's settings only. The file also holds other containments and the
    lock screen, and taking the first match found anywhere in it is how you end up
    reporting the lock screen's wallpaper as the desktop's."""
    found, group = {}, ""
    try:
        for line in open(os.path.expanduser(_CONFIG), errors="replace"):
            group = line.strip() if line.startswith("[") else group
            key, sep, value = line.partition("=")
            if sep and _PLUGIN in group and key.strip() in _DEFAULTS:
                found.setdefault(key.strip(), value.strip())
    except OSError:
        return {}
    return found

def setting(cfg, key):
    """An absent key is not unknown — it means the default was never changed.
    Printing "?" made a perfectly normal config look like a failed read."""
    return cfg[key] if key in cfg else "%s  (default, never set)" % _DEFAULTS[key]

def audio_line(pid):
    """libpipewire is mapped into plasmashell whether or not the wallpaper uses
    audio — KDE needs it for volume and screencasting — so seeing it proves
    nothing. libcava is pulled in by nothing else here, so it is the decisive one."""
    if maps_contain(pid, "libcava"):
        return "libcava mapped — the wallpaper's audio path is live"
    return ("libcava not mapped — no wallpaper audio (libpipewire may be mapped "
            "anyway; KDE uses it for volume and screencasting)")

def chromium_line(pid):
    mapped = maps_contain(pid, "libQt6WebEngineCore")
    if mapped is None:
        return "unreadable"
    return "MAPPED — web mode is loaded" if mapped else "not mapped"


def report(pid, cfg, seconds):
    print("plasmashell pid %s" % pid)
    for key in ("WallpaperMode", "QmlScene", "AudioReactive"):
        print("  %-14s %s" % (key.replace("Wallpaper", "").lower(), setting(cfg, key)))
    print("  chromium       %s" % chromium_line(pid))
    print("  audio stack    %s" % audio_line(pid))
    pss = pss_kb(pid)
    print("  PSS            %s" % ("%.0f MB" % (pss / 1024.0) if pss else "unreadable"))
    policy = str(setting(cfg, "ObscurePolicy"))
    print("  freeze policy  %s" % _FREEZE.get(policy, policy))
    print("  sampling CPU for %ds ..." % seconds)
    cpu = sample(pid, seconds)
    print("  CPU            %s" % ("%.1f%% of one core" % cpu if cpu is not None else "unreadable"))
    frozen_note(cpu, policy)


# A wallpaper frozen by ObscurePolicy costs nothing, and "0.0% of one core" next to
# Chromium's 24% reads as a triumph. It is not a measurement of anything. Say so
# rather than letting the number flatter us. [CHANGE: claude-code | 2026-09-19] BUG-177
_FREEZE = {
    "0": "0 — never freeze",
    "1": "1 — freeze only under a FULLSCREEN window",
    "2": "2 — freeze whenever the desktop is hidden (the default)",
}

def frozen_note(cpu, policy):
    if cpu is None or cpu >= 0.5 or policy == "0":
        return
    print("")
    print("  ^ that is a FROZEN sample, not a cost.")
    print("    Freeze policy %s stops the wallpaper whenever anything is maximized over" % policy)
    print("    the desktop \u2014 including the terminal you are reading this in. 0% is what")
    print("    the policy is FOR; it is not comparable to the Chromium figure below,")
    print("    which was measured with the wallpaper visible.")
    print("    To measure the real cost: un-cover the desktop, or set")
    print("    \"Stop rendering when hidden\" to Never, and run this again.")

def footer(cfg):
    if cfg.get("WallpaperMode", _DEFAULTS["WallpaperMode"]) != "qml":
        print("\nNOTE: mode is not 'qml', so this is a BASELINE — none of the native QML")
        print("      work (audio, per-scene settings, runtime shaders) is running here.")
        print("      Switch to Native QML and run this again to compare like with like.")
    print("\nfor comparison:\n  %s" % _BASELINE)
    print("  The 810 MB there is RSS, which is NOT the same measure as the PSS above —")
    print("  RSS double-counts shared libraries. The CPU percentages ARE comparable.")
    print("\nThis is plasmashell as a whole. Take it the same way before and after a")
    print("change, and the difference is the thing you changed.")

def main(argv):
    seconds = 10
    if len(argv) > 1:
        try:
            seconds = max(1, min(120, int(argv[1])))
        except ValueError:
            print("usage: luminos-wallpaper-cost [seconds]")
            return 2
    pids = pids_named("plasmashell")
    if not pids:
        print("plasmashell is not running — nothing to measure.")
        return 1
    cfg = wallpaper_config()
    report(pids[0], cfg, seconds)
    footer(cfg)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
