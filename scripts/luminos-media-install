#!/bin/bash
# Install / check / remove Luminos Media and make it the default for photos and videos.
# [CHANGE: claude-code | 2026-11-08]  DECISION 180
#   luminos-media-install            build shim, install, set defaults (asks sudo for /usr/local)
#   luminos-media-install --check    report what is installed and which types point where
#   luminos-media-install --uninstall  remove it and restore the defaults saved at install
set -u
REPO="$(cd "$(dirname "$0")/.." && pwd)"
BIN=/usr/local/bin/luminos-media
SHIM_DIR=/usr/local/lib/luminos
SHIM=$SHIM_DIR/libluminos-vaapi-igpu.so
DESK=$HOME/.local/share/applications/luminos-media.desktop
SAVE=$HOME/.local/share/luminos/media-defaults.prior
mimes() { sed -n 's/^MimeType=//p' "$REPO/config/luminos-media.desktop" | tr ';' '\n' | grep .; }

check() {
    local bad=0
    for f in "$BIN" "$SHIM" "$DESK"; do [ -e "$f" ] && echo "  ok   $f" || { echo "  MISSING $f"; bad=1; }; done
    local n=0 other=0
    while read -r m; do n=$((n+1)); d=$(xdg-mime query default "$m"); [ "$d" = luminos-media.desktop ] || { other=$((other+1)); echo "  $m -> ${d:-(nothing)}"; }; done < <(mimes)
    echo "  $((n-other))/$n types open in Luminos Media"
    [ $bad = 0 ] && [ $other = 0 ] && echo "PASS" || { echo "FAIL"; return 1; }
}

uninstall() {
    if [ -f "$SAVE" ]; then
        while IFS=' ' read -r m d; do
            if [ -n "$d" ] && [ "$d" != "-" ] && [ "$d" != luminos-media.desktop ]; then xdg-mime default "$d" "$m"
            else sed -i "\#^$m=luminos-media.desktop;\?\$#d" "$HOME/.config/mimeapps.list"; fi
        done < "$SAVE"
    fi
    rm -f "$DESK"; sudo rm -f "$BIN" "$SHIM"; sudo rmdir "$SHIM_DIR" 2>/dev/null
    update-desktop-database -q "$HOME/.local/share/applications" 2>/dev/null; kbuildsycoca6 --noincremental >/dev/null 2>&1
    echo "removed; previous defaults restored from $SAVE"
}

case "${1:-}" in --check) check; exit;; --uninstall) uninstall; exit;; esac

set -e
build=$(mktemp -d "$HOME/.cache/luminos-media-build.XXXX")
gcc -O2 -Wall -shared -fPIC -o "$build/libluminos-vaapi-igpu.so" "$REPO/scripts/vaapi-igpu/luminos-vaapi-igpu.c" -ldl
sudo install -d "$SHIM_DIR"
sudo install -m 644 "$build/libluminos-vaapi-igpu.so" "$SHIM"
sudo install -m 755 "$REPO/scripts/luminos-media" "$BIN"
rm -rf "$build"
# Save the current defaults once, BEFORE our .desktop exists (with it installed, xdg-mime
# reports it for every type that had no default), so --uninstall can put them back exactly.
mkdir -p "$(dirname "$SAVE")"
if [ ! -f "$SAVE" ]; then
    cp -n "$HOME/.config/mimeapps.list" "$HOME/.config/mimeapps.list.bak-luminos-media" 2>/dev/null || true
    while read -r m; do d=$(xdg-mime query default "$m"); [ "$d" = luminos-media.desktop ] && d=""; echo "$m ${d:--}"; done < <(mimes) > "$SAVE"
fi
install -Dm 644 "$REPO/config/luminos-media.desktop" "$DESK"
while read -r m; do xdg-mime default luminos-media.desktop "$m"; done < <(mimes)
update-desktop-database -q "$HOME/.local/share/applications" 2>/dev/null || true
kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
check
