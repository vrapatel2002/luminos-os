#!/usr/bin/env bash
# luminos-qml-style-build — assemble the org.luminos.style QtQuick Controls style
# [CHANGE: claude-code | 2026-09-03]
#
# WHY THIS EXISTS
# ---------------
# We want Caelestia/Nexus shapes on every Qt Quick app (System Settings, the
# KCMs, Discover, our own QML windows) WITHOUT rebuilding any of them. The
# lever is a QtQuick Controls style module: QT_QUICK_CONTROLS_STYLE picks it,
# and it is pure QML on disk.
#
# THE TRAP THIS SCRIPT EXISTS TO AVOID (measured 2026-09-03, not guessed):
# A *partial* style does not fall back to org.kde.desktop. Setting
# QT_QUICK_CONTROLS_FALLBACK_STYLE=org.kde.desktop is silently ignored —
# Qt only accepts the built-in styles there — so every control the style does
# not define falls back to **Basic**. The visible result is a KDE app that
# turns light-grey with generic spinbox arrows and round slider handles, while
# reporting no error at all. The style must therefore be COMPLETE.
#
# So: symlink all 51 of org.kde.desktop's on-disk .qml files into our module,
# and let our own override files shadow the handful we actually reshape.
# Those on-disk files are the real upstream sources — they are inert in their
# own module only because its qmldir carries `prefer :/qt/qml/...` (DECISION 72),
# which sends lookups into the .so. Ours has no `prefer`, so they load for real.
#
# Overrides are ordinary .qml files committed in the module dir. This script
# never touches them: anything that already exists as a regular file is left
# alone, only the gaps are symlinked.
#
# Re-run after any qqc2-desktop-style upgrade — new upstream controls will not
# exist in our module until you do, and a missing type falls back to Basic
# rather than erroring.
#
# Revert: unset QT_QUICK_CONTROLS_STYLE. The module is inert if nothing selects it.

set -euo pipefail

SRC=/usr/lib/qt6/qml/org/kde/desktop
DEST="${1:-$HOME/luminos-os/config/qml/org/luminos/style}"

[[ -d $SRC ]] || { echo "error: $SRC missing — is qqc2-desktop-style installed?" >&2; exit 1; }
mkdir -p "$DEST"

# Drop stale symlinks so a removed upstream control does not linger.
find "$DEST" -maxdepth 1 -type l -name '*.qml' -delete

linked=0
kept=0
for f in "$SRC"/*.qml; do
    name=$(basename "$f")
    if [[ -f $DEST/$name && ! -L $DEST/$name ]]; then
        kept=$((kept + 1))          # our own override — never overwrite
    else
        ln -sfn "$f" "$DEST/$name"
        linked=$((linked + 1))
    fi
done

# qmldir: upstream's type list, minus the two things that must not be inherited.
#   `prefer`     — would send every lookup back into the .so and make this module
#                  a no-op, silently. This is the whole point of the exercise.
#   plugin lines — the C++ types belong to org.kde.desktop; re-registering them
#                  under a second module URI is asking for a clash. The private
#                  modules they live in are reached through `depends` instead.
{
    echo "# GENERATED by scripts/luminos-qml-style-build — do not edit by hand."
    echo "# Overrides are the real .qml files in this directory; everything else"
    echo "# is a symlink to $SRC."
    echo "module org.luminos.style"
    grep -E '^depends ' "$SRC/qmldir" || true
    echo "depends org.kde.kirigami"
    grep -E '^[A-Z][A-Za-z0-9]* [0-9]+\.[0-9]+ ' "$SRC/qmldir"
} > "$DEST/qmldir"

echo "org.luminos.style built at $DEST"
echo "  $kept override(s) kept, $linked inherited from org.kde.desktop"
echo
echo "Try it on one app without changing anything system-wide:"
echo "  QML_IMPORT_PATH=\$HOME/luminos-os/config/qml \\"
echo "  QT_QUICK_CONTROLS_STYLE=org.luminos.style systemsettings"
