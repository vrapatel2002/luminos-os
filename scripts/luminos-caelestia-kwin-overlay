#!/usr/bin/env python3
# [CHANGE: claude-code | 2026-08-09]
#
# Build ~/.config/quickshell/caelestia-kwin — Caelestia with the handful of edits
# it needs to work under KWin instead of Hyprland.
#
# WHY AN OVERLAY AND NOT A FORK
#   Caelestia is 269 QML files.  Copying all of them means the next `caelestia`
#   package upgrade silently does nothing for us: we would keep running whatever
#   we copied, with no error and no hint.  So every file is a SYMLINK back to
#   /etc/xdg/quickshell/caelestia, and only the patched files are real.  Upstream
#   fixes arrive for free; our diff stays visible and tiny.
#
# WHY THE PATCHES ARE RE-DERIVED EVERY RUN
#   The patched files are generated from the CURRENT upstream text, not stored.
#   If upstream moves the code we anchor on, the anchor stops matching and this
#   script FAILS LOUDLY instead of quietly shipping a stale file.  Re-running
#   this script is therefore the entire maintenance story after an upgrade.
#
# Usage:
#   luminos-caelestia-kwin-overlay            # build / rebuild
#   luminos-caelestia-kwin-overlay --check    # verify, change nothing, exit 1 if stale
#   luminos-caelestia-kwin-overlay --remove   # delete the overlay

import os
import shutil
import sys
from pathlib import Path

SRC = Path("/etc/xdg/quickshell/caelestia")
DST = Path.home() / ".config/quickshell/caelestia-kwin"
MARKER = ".luminos-overlay"   # refuse to delete a directory that is not ours

# ---------------------------------------------------------------------------
# The patches.  Each entry is (relative path, [(anchor, replacement), ...]).
# Anchors are exact text and must match EXACTLY ONCE.
# ---------------------------------------------------------------------------
PATCHES = {
    # Hypr.focusedMonitor is null with no Hyprland IPC socket.  Every drawer
    # toggle resolves the target screen through it, so on KWin the launcher,
    # dashboard, sidebar and session menu all no-op in complete silence -
    # `drawers list` even returns an empty string.  This is THE reason
    # Caelestia looks dead on KWin; everything else is cosmetic by comparison.
    # The fallback goes AFTER the loop, not before it. An earlier version bailed out
    # on `if (!focusedMonitor)` and that was not enough: focusedMonitor can be
    # non-null and still match none of KWin's screens - a reachable Hyprland socket
    # describes Hyprland's outputs, not KWin's. That case fell straight through the
    # loop to `return null` and the drawers were dead again, with the patch present
    # and looking correct. Patching the exit instead covers both.
    "services/ShellState.qml": [
        (
            "    function forActive(): ScreenState {\n"
            "        const mon = Hypr.focusedMonitor;\n"
            "        for (const s of states.instances)\n"
            "            if (Hypr.monitorFor(s.modelData) === mon)\n"
            "                return s;\n"
            "        return null;\n"
            "    }",
            "    function forActive(): ScreenState {\n"
            "        const mon = Hypr.focusedMonitor;\n"
            "        for (const s of states.instances)\n"
            "            if (Hypr.monitorFor(s.modelData) === mon)\n"
            "                return s;\n"
            "        // [LUMINOS-KWIN] No Hyprland IPC means focusedMonitor is null and\n"
            "        // monitorFor() never matches, so this returned null and EVERY drawer\n"
            "        // silently did nothing - `drawers list` even came back empty.  On one\n"
            "        // monitor the first instance is the active one, so this is not a guess.\n"
            "        return states.instances[0] ?? null;\n"
            "    }",
        ),
        (
            "    function componentsForActive(): Components {\n"
            "        const mon = Hypr.focusedMonitor;\n"
            "        for (const c of components.instances)\n"
            "            if (Hypr.monitorFor(c.modelData) === mon)\n"
            "                return c;\n"
            "        return null;\n"
            "    }",
            "    function componentsForActive(): Components {\n"
            "        const mon = Hypr.focusedMonitor;\n"
            "        for (const c of components.instances)\n"
            "            if (Hypr.monitorFor(c.modelData) === mon)\n"
            "                return c;\n"
            "        return components.instances[0] ?? null;   // [LUMINOS-KWIN] see forActive()\n"
            "    }",
        ),
    ],
    # The drawers window covers the whole screen and lets clicks through with a
    # mask.  dragMaskPadding widens that mask around the screen edges so a drawer
    # can be DRAGGED open - and upstream switches it off the moment the workspace
    # holds a window, so it never sits over anything real.  That check reads
    # Hyprland's monitor, which is null here, so it can never fire: the drag bands
    # stay armed forever and the shell eats every click near an edge.  Reported as
    # "the windows are not responding" - the windows were fine, an invisible band
    # over the titlebar was taking the clicks.
    # Cost: no drag-to-open on KWin.  The keyboard shortcuts do the same job, and a
    # desktop you cannot click is not a trade.
    "modules/drawers/ContentWindow.qml": [
        (
            "        if (monitor?.lastIpcObject.specialWorkspace?.name || "
            "monitor?.activeWorkspace?.lastIpcObject.windows > 0)\n"
            "            return 0;",
            "        // [LUMINOS-KWIN] With no Hyprland monitor the check below is always\n"
            "        // `undefined > 0` == false, so the drag bands never turned off and\n"
            "        // swallowed clicks meant for windows.  No monitor -> no padding.\n"
            "        if (!monitor)\n"
            "            return 0;\n"
            "\n"
            "        if (monitor?.lastIpcObject.specialWorkspace?.name || "
            "monitor?.activeWorkspace?.lastIpcObject.windows > 0)\n"
