    # Click-outside-to-close, half two: turn the press we now receive into the
    # same close that HyprlandFocusGrab.onCleared would have done.
    # Presses that land on real panel content never arrive here - a child
    # MouseArea takes them first - but presses on a panel's empty background do,
    # hence the geometry test.  It reuses the same helpers upstream already uses
    # for hover, so "inside a panel" means the same thing in both places.
    "modules/drawers/Interactions.qml": [
        (
            "    onPressed: event => dragStart = Qt.point(event.x, event.y)",
            "    // [LUMINOS-KWIN] ---- click outside to close ----------------------------\n"
            "    // See modules/drawers/ContentWindow.qml: KWin has no focus-grab protocol,\n"
            "    // so upstream's only click-away close path never fires and the launcher,\n"
            "    // session menu, sidebar and detached popouts stay open forever.\n"
            "    function luminosDismissible(): bool {\n"
            "        if (popouts.isDetached)\n"
            "            return true;\n"
            "        if (screenState.launcher && Config.launcher.enabled)\n"
            "            return true;\n"
            "        if (screenState.session && Config.session.enabled)\n"
            "            return true;\n"
            "        if (screenState.sidebar && Config.sidebar.enabled)\n"
            "            return true;\n"
            "        if (!Config.dashboard.showOnHover && screenState.dashboard && "
