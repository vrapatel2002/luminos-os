            "            return true;\n"
            "        return popouts.currentName.startsWith(\"traymenu\") "
            "&& ((popouts.current as StackView)?.depth ?? 0) > 1;\n"
            "    }\n"
            "\n"
            "    function luminosOnOpenPanel(x: real, y: real): bool {\n"
            "        if (x < bar.clampedWidth)\n"
            "            return true;   // the bar is part of the shell, not 'outside'\n"
            "        if (popouts.isDetached) {\n"
            "            // Detached popouts are centred, so the hover helpers (which think in\n"
            "            // screen edges) do not describe them.  Plain rect test instead.\n"
            "            const p = panels.popoutsWrapper;\n"
            "            const px = bar.implicitWidth + p.x;\n"
            "            const py = borderThickness + p.y;\n"
            "            return x >= px && x <= px + p.width && y >= py && y <= py + p.height;\n"
            "        }\n"
            "        if (screenState.launcher && inBottomPanel(panels.launcher, x, y))\n"
            "            return true;\n"
            "        if (screenState.dashboard && inTopPanel(panels.dashboard, x, y))\n"
            "            return true;\n"
            "        if (screenState.session && inRightPanel(panels.sessionWrapper, x, y))\n"
            "            return true;\n"
            "        if (screenState.sidebar && inRightPanel(panels.sidebar, x, y))\n"
            "            return true;\n"
            "        if (popouts.hasCurrent && inLeftPanel(panels.popoutsWrapper, x, y))\n"
            "            return true;\n"
            "        return false;\n"
            "    }\n"
            "\n"
            "    // Same body as HyprlandFocusGrab.onCleared, plus popouts.close() so a\n"
            "    // DETACHED popout also goes away (hasCurrent alone does not clear\n"
            "    // detachedMode, and a detached popout ignores every hover path).\n"
            "    function luminosClickOutside(): void {\n"
            "        popouts.close();\n"
            "        screenState.launcher = false;\n"
            "        screenState.session = false;\n"
            "        screenState.sidebar = false;\n"
            "        screenState.dashboard = false;\n"
            "        bar.closeTray();\n"
            "    }\n"
            "\n"
            "    onPressed: event => {\n"
            "        dragStart = Qt.point(event.x, event.y);\n"
            "        if (luminosDismissible() && !luminosOnOpenPanel(event.x, event.y))\n"
            "            luminosClickOutside();\n"
            "    }",
        ),
    ],
    # The GPU card read "failed" forever.  [CHANGE: claude-code | 2026-08-31]
    #
    # Upstream's Gpu service asks nvidia-smi as the shell user.  That is denied
    # here by design: the nvidia device nodes belong to group `dgpu` (gid 948),
    # and that group is deliberately EMPTY - the only way in is the setgid
    # wrapper /usr/local/bin/dgpu-exec.  So the card was not broken, it was the
    # lock working, and it had no way to say so.
    #
    # Handing the shell the group would fix the message and break the point.
    # Worse, asking at all is the wrong move: the 4050 sits in D3cold under RTD3
    # (BUG-047, NVreg_DynamicPowerManagement=0x02) and ANY query wakes it.
    # Measured 2026-08-31: awake and doing nothing draws 13.46 W.  A card that
    # polled nvidia-smi would hold the dGPU awake for as long as the tab is open,
    # which is a battery bug dressed up as a widget.
    #
    # So do not ask the GPU anything until it is already awake.  The kernel
    # already knows, and telling us costs nothing and wakes nothing:
    #
    #     /sys/bus/pci/devices/0000:01:00.0/power/runtime_status
    #         -> "suspended" (asleep, 0 W) or "active" (something is using it)
    #
    # Verified 2026-08-31 that reading it leaves the card in D3cold/suspended.
    # Asleep  -> say so, report 0 W, spawn nothing.
    # Awake   -> a game or a model already paid the wake cost, so nvidia-smi is
    #            free at that point; show the live numbers for exactly that window.
    #
    # The PCI address is hard-coded because this is one fixed laptop.  If it ever
    # moves, `lspci -D | grep -i nvidia` is where the new one comes from.
    #
    # The model name is the same trap in miniature.  `lspci -s 01:00.0` prints it,
    # and measured 2026-08-31 it flipped the card D3cold -> D0 just by asking.
    # The sysfs `modalias` attribute is already cached by the kernel, so reading
    # it wakes nothing, and systemd-hwdb turns it into a name offline:
    #
    #     modalias -> pci:v000010DEd000028E1sv00001043sd00003398bc03sc00i00
    #     systemd-hwdb query <that> -> ID_MODEL_FROM_DATABASE=AD107M [GeForce RTX 4050 ...]
    #
    # So the card knows what it is even while it is asleep, which is the point:
    # the name lives on the subLabel line and the sleep/wake state moved down to
    # the temperature row, where a number would otherwise just read 0.
    "modules/dashboard/Performance.qml": [
        (
            "import Quickshell.Services.UPower",
            "import Quickshell.Io\n"
            "import Quickshell.Services.UPower",
        ),
        (
            "    Loader {\n"
            "        id: placeholder",
            "    // [LUMINOS-KWIN] ---- dGPU state without waking the card ----------------\n"
            "    // See scripts/luminos-caelestia-kwin-overlay for why this does not just\n"
            "    // use upstream's Gpu service.\n"
            "    QtObject {\n"
            "        id: dgpu\n"
            "\n"
            "        readonly property string device: \"0000:01:00.0\"\n"
            "        property bool awake: false\n"
            "        property bool haveData: false\n"
            "        property string name: qsTr(\"NVIDIA dGPU\")\n"
            "        property real usage: 0\n"
            "        property real temperature: 0\n"
            "        property real power: 0\n"
            "\n"
            "        // Goes where the temperature normally goes. Asleep, a temperature\n"
            "        // is just a 0 - the state is the thing worth the space.\n"
            "        readonly property string status: {\n"
            "            if (!awake)\n"
            "                return qsTr(\"D3cold - 0 W\");\n"
            "            if (!haveData)\n"
            "                return qsTr(\"Waking...\");\n"
            "            const f = GlobalConfig.services.useFahrenheitPerformance;\n"
            "            const t = Math.ceil(f ? temperature * 1.8 + 32 : temperature);\n"
            "            return `${t}\\u00b0${f ? \"F\" : \"C\"} - ${power.toFixed(0)} W`;\n"
            "        }\n"
            "\n"
            "        readonly property string statusIcon: awake ? (haveData ? \"\" : \"hourglass\") : \"bedtime\"\n"
            "    }\n"
            "\n"
            "    // Kernel state only. Reading this does NOT wake the card.\n"
            "    FileView {\n"
            "        id: dgpuState\n"
            "\n"
            "        path: `/sys/bus/pci/devices/${dgpu.device}/power/runtime_status`\n"
            "        blockLoading: true\n"
            "        printErrors: false\n"
            "    }\n"
            "\n"
            "    // The kernel already cached this string, so reading it wakes nothing.\n"
            "    FileView {\n"
            "        id: dgpuModalias\n"
            "\n"
            "        path: `/sys/bus/pci/devices/${dgpu.device}/modalias`\n"
            "        blockLoading: true\n"
            "        printErrors: false\n"
            "    }\n"
            "\n"
            "    // Name from the offline PCI id database - never asks the card.\n"
            "    Process {\n"
            "        running: true\n"
            "        command: [\"systemd-hwdb\", \"query\", dgpuModalias.text().trim()]\n"
            "\n"
            "        stdout: StdioCollector {\n"
            "            onStreamFinished: {\n"
            "                const m = text.match(/^ID_MODEL_FROM_DATABASE=(.*)$/m);\n"
            "                if (!m)\n"
            "                    return;\n"
            "                // \"AD107M [GeForce RTX 4050 Max-Q / Mobile]\" -> the bracket\n"
            "                // half. The die codename means nothing on a dashboard.\n"
            "                const b = m[1].match(/\\[(.*)\\]/);\n"
            "                dgpu.name = b ? b[1] : m[1];\n"
            "            }\n"
            "        }\n"
            "    }\n"
            "\n"
            "    // Only ever run while the card is ALREADY awake, so this never\n"
            "    // causes a wake - it only reports one somebody else paid for.\n"
            "    Process {\n"
            "        id: dgpuQuery\n"
            "\n"
            "        command: [\"dgpu-exec\", \"nvidia-smi\", "
            "\"--query-gpu=utilization.gpu,temperature.gpu,power.draw\", "
            "\"--format=csv,noheader,nounits\"]\n"
            "\n"
            "        stdout: StdioCollector {\n"
            "            onStreamFinished: {\n"
            "                const f = text.trim().split(\",\").map(s => s.trim());\n"
            "                if (f.length < 3 || !f[0])\n"
            "                    return;\n"
            "                dgpu.usage = (parseFloat(f[0]) || 0) / 100;\n"
            "                dgpu.temperature = parseFloat(f[1]) || 0;\n"
            "                dgpu.power = parseFloat(f[2]) || 0;\n"
            "                dgpu.haveData = true;\n"
            "            }\n"
            "        }\n"
            "    }\n"
            "\n"
            "    Timer {\n"
            "        running: gpuCard.active\n"
            "        interval: GlobalConfig.dashboard.resourceUpdateInterval\n"
            "        repeat: true\n"
            "        triggeredOnStart: true\n"
            "\n"
            "        onTriggered: {\n"
            "            dgpuState.reload();\n"
            "            dgpu.awake = dgpuState.text().trim() === \"active\";\n"
            "            if (dgpu.awake) {\n"
            "                if (!dgpuQuery.running)\n"
            "                    dgpuQuery.running = true;\n"
            "            } else {\n"
            "                dgpu.haveData = false;\n"
            "                dgpu.usage = 0;\n"
            "                dgpu.temperature = 0;\n"
            "                dgpu.power = 0;\n"
            "            }\n"
            "        }\n"
            "    }\n"
            "\n"
            "    Loader {\n"
            "        id: placeholder",
        ),
        (
            "                    sourceComponent: HeroCard {\n"
            "                        icon: \"desktop_windows\"\n"
            "                        label: qsTr(\"GPU\")\n"
            "                        subLabel: Gpu.name\n"
            "                        usage: Gpu.percentage\n"
            "                        temperature: Gpu.temperature\n"
            "                        accent: Colours.palette.m3secondary\n"
            "\n"
            "                        ServiceRef {\n"
            "                            service: Gpu\n"
            "                        }\n"
            "                    }",
            "                    // [LUMINOS-KWIN] Fed from `dgpu` above, not from the Gpu\n"
            "                    // service, and with NO ServiceRef - refing it is what made\n"
            "                    // the card poll nvidia-smi and read 'failed'.\n"
            "                    sourceComponent: HeroCard {\n"
            "                        icon: \"desktop_windows\"\n"
            "                        label: qsTr(\"GPU\")\n"
