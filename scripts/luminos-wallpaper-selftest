#!/usr/bin/env bash
# Every check for the live wallpaper, in one run, with the answers written to a
# file instead of a terminal someone has to copy out of.
# [CHANGE: claude-code | 2026-09-19]  SPEC §3.1/§3.2/§3.4
# SPDX-License-Identifier: GPL-3.0-or-later
#
#   ~/luminos-os/scripts/luminos-wallpaper-selftest
#
# Writes docs/wallpaper/SELFTEST.log and prints the same thing. Exit code is the
# number of failed checks, so a wrapper can branch on it.
#
# Why a file: a Cowork session can read the repo but cannot run anything in the
# desktop session — no qml6, no plasmashell, no sound. Asking a person to paste
# terminal output back is a bad interface and it is slow. This writes the answers
# where the next session can read them directly.

set -uo pipefail

REPO="${LUMINOS_REPO:-$HOME/luminos-os}"
PLUGIN="$HOME/.local/share/plasma/wallpapers/org.luminos.livewallpaper/contents"
LOG="$REPO/docs/wallpaper/SELFTEST.log"
PASS=0
FAIL=0
mkdir -p "$(dirname "$LOG")"
: > "$LOG"

say()  { printf '%s\n' "$*" | tee -a "$LOG"; }
ok()   { PASS=$((PASS+1)); say "  PASS  $*"; }
bad()  { FAIL=$((FAIL+1)); say "  FAIL  $*"; }
info() { say "  ..    $*"; }

say "Luminos live wallpaper — self test"
say "  $(date -Is)   $(uname -r)   plugin: $PLUGIN"
say ""

# ---------------------------------------------------------------- 1. the files
say "[1] the package"
for f in ui/QmlMode.qml ui/scene.js ui/audio/AudioBridge.qml ui/audio/CaelestiaAudio.qml \
         ui/audio/AudioTexture.qml ui/props/PropertyStore.qml ui/props/PropsReader.qml \
         ui/props/PropertyEditor.qml ui/props/PropertyControls.qml ui/props/ShaderBaker.qml \
         ui/scenes/Spectrum.qml ui/scenes/ShaderToy.qml ui/scenes/Spectrum.properties.json \
         tools/luminos-shader-bake tools/luminos-wallpaper-props tools/shader-wrapper.glsl \
         samples/luminos-shadertoy.frag; do
    [ -f "$PLUGIN/$f" ] && ok "installed $f" || bad "MISSING $f"
done
# [CHANGE: claude-code | 2026-09-20] The installer loads two tested helpers by
# name. In the repo they resolve through ../../../../../scripts; from the
# DEPLOYED copy that path does not exist, so the Install… button answered
# "ERR cannot find luminos-wallpaper-pkg" while every other check passed. Both
# helpers now ship inside the package, and this is what notices if one stops.
if out="$(python3 "$PLUGIN/tools/luminos-wallpaper-install" install /nonexistent 2>&1)"; then
    bad "the installer accepted a path that does not exist"
elif printf '%s' "$out" | grep -q "cannot find"; then
    bad "the DEPLOYED installer cannot load its helpers: $out"
else
    ok "the deployed installer runs and refuses a bad path"
fi
if diff -rq "$REPO/src/wallpapers/org.luminos.livewallpaper" \
            "${PLUGIN%/contents}" >/dev/null 2>&1; then
    ok "installed copy matches the repo"
else
    bad "installed copy DIFFERS from the repo — run the deploy step"
fi
say ""

# ------------------------------------------------------- 2. the settings reader
say "[2] scene settings (SPEC §3.2, BUG-170)"
for scene in ui/scenes/Spectrum.qml ui/scenes/Shader.qml samples/luminos-shadertoy.frag; do
    out="$(python3 "$PLUGIN/tools/luminos-wallpaper-props" "$PLUGIN/$scene" 2>&1)"
    case "$out" in
        OK*)   ok "$(basename "$scene") -> $(printf '%s' "$out" | cut -c1-60)…" ;;
        NONE*) info "$(basename "$scene") has no properties.json (fine for some scenes)" ;;
        *)     bad "$(basename "$scene") -> $out" ;;
    esac
done
say ""

# -------------------------------------------------------- 3. the shader baker
say "[3] runtime shaders (SPEC §3.4)"
if [ -x /usr/lib/qt6/bin/qsb ]; then ok "qsb present"; else bad "qsb missing — install qt6-shadertools"; fi
bake="$(python3 "$PLUGIN/tools/luminos-shader-bake" \
        "$PLUGIN/samples/luminos-shadertoy.frag" \
        "$PLUGIN/samples/luminos-shadertoy.properties.json" 2>&1)"
case "$bake" in
    OK*) ok "sample shader compiles"
         say "        $(printf '%s' "$bake" | tail -1)"
         qsb_path="$(printf '%s' "$bake" | head -1 | cut -d' ' -f2)"
         [ -f "$qsb_path" ] && ok "cached at $qsb_path" || bad "baker reported a path that is not there" ;;
    *)   bad "sample shader did NOT compile: $bake" ;;
esac
say ""

# ----------------------------------------------------------- 4. the QML tests
# QT_QPA_PLATFORM=offscreen because this may be run from a shell with no display
# — without it Qt aborts on a bare Item and the failure reads as a broken test.
# The exit code IS the result: each harness exits with its failure count.
# ---------------------------------------------------------------------------
# [CHANGE: claude-code | 2026-09-19] BUG-179. budget_check.py takes its files as
# ARGUMENTS and checks nothing without them — run bare it prints "BUDGETS PASS"
# and exits 0 about zero files. It had never been wired in here at all, so SPEC
# §9's "over budget is a red build" was not a build rule, it was a sentence.
say "[3b] budgets (SPEC §9)"
TOOLS="$REPO/src/wallpapers/org.luminos.livewallpaper/contents/tools"
PYFILES="$REPO/scripts/luminos-wallpaper-pkg $REPO/scripts/luminos-wallpaper-lively
         $TOOLS/luminos-wallpaper-install
         $TOOLS/luminos-wallpaper-gallery $TOOLS/luminos-wallpaper-props
         $TOOLS/luminos-wallpaper-js"
if out="$(python3 "$REPO/tests/wallpaper/budget_check.py" $PYFILES 2>&1)"; then
    ok "python budgets — $(printf '%s' "$PYFILES" | wc -w) files within 150/40/3"
else
    bad "python budgets over"
    printf '%s\n' "$out" | grep FAIL | head -5 | sed 's/^/        /' | tee -a "$LOG"
fi
# QML has no AST checker here, so lines only. main.qml and config.qml predate
# SPEC §9 and are exempt BY NAME and by date, not by silence — see BUG-179.
QML_EXEMPT="main.qml config.qml"
over=""
for f in "$REPO"/src/wallpapers/org.luminos.livewallpaper/contents/ui/*.qml \
         "$REPO"/src/wallpapers/org.luminos.livewallpaper/contents/ui/*/*.qml; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    case " $QML_EXEMPT " in *" $base "*) continue ;; esac
    n=$(wc -l < "$f")
    case "$f" in */scenes/*) limit=150 ;; *) limit=200 ;; esac
    [ "$n" -gt "$limit" ] && over="$over $base:$n>$limit"
done
if [ -z "$over" ]; then
    ok "qml budgets — every file within 150 (scene) / 200 (host)"
else
    bad "qml over budget:$over"
fi
info "exempt by name, pre-SPEC §9: $QML_EXEMPT ($(wc -l < "$REPO/src/wallpapers/org.luminos.livewallpaper/contents/ui/main.qml") and $(wc -l < "$REPO/src/wallpapers/org.luminos.livewallpaper/contents/ui/config.qml") lines)"
say ""

# ---------------------------------------------------------------------------
# [CHANGE: claude-code | 2026-09-20] BUG-184. "The wallpaper must never touch the
# NVIDIA dGPU" is a claim, and a claim that nothing checks is a claim that drifts.
# This asks the kernel, not the environment: a process either holds a descriptor
# on the card or it does not.
say "[3c] the wallpaper stays on the iGPU (BUG-050, BUG-184)"
NV_NODES="$(ls -d /sys/class/drm/renderD*/device/driver 2>/dev/null | while read -r d; do
    case "$(basename "$(readlink -f "$d")")" in nvidia)
        echo "/dev/dri/$(echo "$d" | cut -d/ -f5)" ;; esac; done)"
holders=""
for pid in $(pgrep -u "$(id -u)" '' 2>/dev/null); do
    for fd in /proc/$pid/fd/*; do
        t="$(readlink "$fd" 2>/dev/null)" || continue
        case "$t" in
            /dev/nvidia*) holders="$holders $(cat /proc/$pid/comm 2>/dev/null):$t" ;;
            *) for n in $NV_NODES; do [ "$t" = "$n" ] &&
                   holders="$holders $(cat /proc/$pid/comm 2>/dev/null):$t"; done ;;
        esac
    done 2>/dev/null
done
if [ -z "$holders" ]; then
    ok "no process of this user holds an NVIDIA node ($(echo $NV_NODES) or /dev/nvidia*)"
else
    bad "a user process holds the dGPU:$holders"
fi
for n in $NV_NODES; do
    mode="$(stat -c '%a %U:%G' "$n" 2>/dev/null)"
    case "$mode" in
        66[0-9]*dgpu) ok "$n gated ($mode)" ;;
        *) bad "$n is NOT gated ($mode) — DECISION 25 / BUG-184" ;;
    esac
done
if pid="$(pgrep -x plasmashell | head -1)" && [ -n "$pid" ]; then
    nodes="$(for fd in /proc/$pid/fd/*; do readlink "$fd" 2>/dev/null; done \
             | grep -o '/dev/dri/[a-zA-Z0-9]*' | sort -u | tr '\n' ' ')"
    case "$nodes" in
        *renderD*) ok "plasmashell holds: $nodes" ;;
        *) info "plasmashell holds no DRM node right now" ;;
    esac
fi
say ""

say "[4] QML contract tests"
if command -v qml6 >/dev/null 2>&1; then
    # QT_FORCE_STDERR_LOGGING: Qt hands console.log to the JOURNAL when stderr is
    # not a tty, so `2>&1` captured NOTHING here and a failing check printed its
    # reason into a void. The exit code was all this ever had. BUG-173.
    # [CHANGE: claude-code | 2026-09-19]
    for t in audio_contract props_contract editor_contract canvasjs_contract gallery_contract; do
        out="$(QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 \
               timeout 30 qml6 "$REPO/tests/wallpaper/$t.qml" 2>&1)"
        rc=$?
        case "$rc" in
            0)   ok "$t — exit 0, every check passed" ;;
            124) bad "$t TIMED OUT — a throw before Qt.exit() will do this" ;;
            134) bad "$t ABORTED — usually no display; is QT_QPA_PLATFORM honoured?" ;;
            *)   bad "$t failed, exit $rc, $rc check(s) broken" ;;
        esac
        [ "$rc" -eq 0 ] || printf '%s\n' "$out" | grep -E 'FAIL|Error|error|\.qml:' \
            | head -6 | sed 's/^/        /' | tee -a "$LOG"
    done
else
    bad "qml6 not found — cannot run the contract tests"
fi
say ""

# --------------------------------------------------------- 5. what is running
say "[5] the running wallpaper"
pid="$(pgrep -x plasmashell | head -1)"
if [ -n "$pid" ]; then
    ok "plasmashell pid $pid"
    # [CHANGE: claude-code | 2026-09-20] DECISION 112 says Chromium must be mapped
    # ONLY in web mode. Reporting it as a failure while web mode is genuinely
    # selected is how a red line gets ignored — read the config, then judge.
    wpmode="$(awk '/^\[/{g=$0} /^WallpaperMode=/{ if (g ~ /luminos/) { sub(/^WallpaperMode=/,""); print } }' \
              "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" 2>/dev/null | tail -1)"
    if grep -q libQt6WebEngineCore "/proc/$pid/maps" 2>/dev/null; then
        if [ "$wpmode" = "web" ]; then
            ok "Chromium mapped, and web mode is selected — DECISION 112 holds"
        else
            bad "Chromium IS mapped into plasmashell but the mode is '$wpmode' — DECISION 112 broken"
        fi
    elif [ "$wpmode" = "web" ]; then
        info "web mode selected but Chromium not mapped yet (the view may not have loaded)"
    else
        ok "Chromium not mapped"
    fi
    if grep -q libcava "/proc/$pid/maps" 2>/dev/null; then
        ok "libcava mapped — the audio path is live"
    else
        info "libcava not mapped — audio is off, or the scene is not audio-reactive"
    fi
else
    bad "plasmashell is not running"
fi
cfgfile="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
awk '/^\[/{g=$0} /^(WallpaperMode|QmlScene|AudioReactive|SceneProperties)=/{ if (g ~ /luminos/) print "        " $0 }' \
    "$cfgfile" 2>/dev/null | tee -a "$LOG"
say ""

# ------------------------------------------------------------- 6. the journal
# Warnings from BEFORE the currently installed files were written are history —
# they are what the last version said, and flagging them as current faults makes
# the report cry wolf for the rest of the boot. Only lines newer than the newest
# installed file are this build's problem. [CHANGE: claude-code | 2026-09-19]
# ---------------------------------------------------------------------------
# [CHANGE: claude-code | 2026-09-20] DECISION 127. The lock screen has run this
# same plugin since DECISION 77, with its OWN copy of the settings — so it drifted
# quietly, and five months later was still playing a video from July while the
# desktop had moved on. Silent drift is exactly what a selftest is for.
say "[7] the lock screen shows the same wallpaper (DECISION 127)"
if out="$(bash "$REPO/scripts/luminos-wallpaper-lockscreen" --dry-run 2>&1)"; then
    case "$out" in
        *"already identical"*) ok "lock screen matches the desktop" ;;
        *) bad "lock screen has drifted — run: luminos-wallpaper-lockscreen"
           printf '%s\n' "$out" | grep '\->' | head -6 | sed 's/^/      /' | tee -a "$LOG" ;;
    esac
else
    info "$(printf '%s' "$out" | tail -1)"
fi
say ""

say "[6] what the wallpaper said"
deployed="$(find "$PLUGIN" -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -1 | cut -d. -f1)"
since="$(date -d "@${deployed:-0}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
info "installed files last written $since — older warnings are previous versions"
recent="$(journalctl --user -t plasmashell --no-pager --since "$since" 2>/dev/null | grep -c 'LUMINOS-WP')"
older="$(journalctl --user -b -t plasmashell --no-pager 2>/dev/null | grep -c 'LUMINOS-WP')"
older=$(( older - recent ))
if [ "${recent:-0}" -eq 0 ]; then
    ok "no [LUMINOS-WP] warnings since this build was installed"
    [ "${older:-0}" -gt 0 ] && info "$older older line(s) in this boot, from previous versions"
else
    bad "$recent [LUMINOS-WP] warning(s) from THIS build:"
    journalctl --user -t plasmashell --no-pager --since "$since" 2>/dev/null \
        | grep 'LUMINOS-WP' | tail -20 | sed 's/^/        /' | tee -a "$LOG"
fi
say ""

say "-----------------------------------------------------------"
say "  $PASS passed, $FAIL failed"
say "  report written to $LOG"
exit "$FAIL"
