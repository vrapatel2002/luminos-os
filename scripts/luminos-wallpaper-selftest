#!/usr/bin/env bash
# Every check for the live wallpaper, in one run, with the answers written to a
# file instead of a terminal someone has to copy out of.
# [CHANGE: claude-code | 2026-09-19]  SPEC §3.1/§3.2/§3.4
# SPDX-License-Identifier: GPL-3.0-or-later
#
#   ~/luminos-os/scripts/luminos-wallpaper-selftest
#
# Writes docs/wallpaper/SELFTEST.log and prints the same thing. Exit code is the
# number of failed checks, so a wrapper can branch on it.
#
# Why a file: a Cowork session can read the repo but cannot run anything in the
# desktop session — no qml6, no plasmashell, no sound. Asking a person to paste
# terminal output back is a bad interface and it is slow. This writes the answers
# where the next session can read them directly.

set -uo pipefail

REPO="${LUMINOS_REPO:-$HOME/luminos-os}"
PLUGIN="$HOME/.local/share/plasma/wallpapers/org.luminos.livewallpaper/contents"
LOG="$REPO/docs/wallpaper/SELFTEST.log"
PASS=0
FAIL=0
mkdir -p "$(dirname "$LOG")"
: > "$LOG"

say()  { printf '%s\n' "$*" | tee -a "$LOG"; }
ok()   { PASS=$((PASS+1)); say "  PASS  $*"; }
bad()  { FAIL=$((FAIL+1)); say "  FAIL  $*"; }
info() { say "  ..    $*"; }

say "Luminos live wallpaper — self test"
say "  $(date -Is)   $(uname -r)   plugin: $PLUGIN"
say ""

# ---------------------------------------------------------------- 1. the files
say "[1] the package"
for f in ui/QmlMode.qml ui/scene.js ui/audio/AudioBridge.qml ui/audio/CaelestiaAudio.qml \
         ui/audio/AudioTexture.qml ui/props/PropertyStore.qml ui/props/PropsReader.qml \
         ui/props/PropertyEditor.qml ui/props/PropertyControls.qml ui/props/ShaderBaker.qml \
         ui/scenes/Spectrum.qml ui/scenes/ShaderToy.qml ui/scenes/Spectrum.properties.json \
         tools/luminos-shader-bake tools/luminos-wallpaper-props tools/shader-wrapper.glsl \
         samples/luminos-shadertoy.frag; do
    [ -f "$PLUGIN/$f" ] && ok "installed $f" || bad "MISSING $f"
done
if diff -rq "$REPO/src/wallpapers/org.luminos.livewallpaper" \
            "${PLUGIN%/contents}" >/dev/null 2>&1; then
    ok "installed copy matches the repo"
else
    bad "installed copy DIFFERS from the repo — run the deploy step"
fi
say ""

# ------------------------------------------------------- 2. the settings reader
say "[2] scene settings (SPEC §3.2, BUG-170)"
for scene in ui/scenes/Spectrum.qml ui/scenes/Shader.qml samples/luminos-shadertoy.frag; do
    out="$(python3 "$PLUGIN/tools/luminos-wallpaper-props" "$PLUGIN/$scene" 2>&1)"
    case "$out" in
        OK*)   ok "$(basename "$scene") -> $(printf '%s' "$out" | cut -c1-60)…" ;;
        NONE*) info "$(basename "$scene") has no properties.json (fine for some scenes)" ;;
        *)     bad "$(basename "$scene") -> $out" ;;
    esac
done
say ""

# -------------------------------------------------------- 3. the shader baker
say "[3] runtime shaders (SPEC §3.4)"
if [ -x /usr/lib/qt6/bin/qsb ]; then ok "qsb present"; else bad "qsb missing — install qt6-shadertools"; fi
bake="$(python3 "$PLUGIN/tools/luminos-shader-bake" \
        "$PLUGIN/samples/luminos-shadertoy.frag" \
        "$PLUGIN/samples/luminos-shadertoy.properties.json" 2>&1)"
case "$bake" in
    OK*) ok "sample shader compiles"
         say "        $(printf '%s' "$bake" | tail -1)"
         qsb_path="$(printf '%s' "$bake" | head -1 | cut -d' ' -f2)"
         [ -f "$qsb_path" ] && ok "cached at $qsb_path" || bad "baker reported a path that is not there" ;;
    *)   bad "sample shader did NOT compile: $bake" ;;
esac
say ""

# ----------------------------------------------------------- 4. the QML tests
say "[4] QML contract tests (need a graphical session)"
if command -v qml6 >/dev/null 2>&1; then
    for t in audio_contract props_contract; do
        if out="$(timeout 60 qml6 "$REPO/tests/wallpaper/$t.qml" 2>&1)"; then
            ok "$t — $(printf '%s' "$out" | grep -c '  ok ') checks"
        else
            bad "$t FAILED"
            printf '%s\n' "$out" | grep -E 'FAIL|Error|error' | head -5 | sed 's/^/        /' | tee -a "$LOG"
        fi
    done
else
    bad "qml6 not found — cannot run the contract tests"
fi
say ""

# --------------------------------------------------------- 5. what is running
say "[5] the running wallpaper"
pid="$(pgrep -x plasmashell | head -1)"
if [ -n "$pid" ]; then
    ok "plasmashell pid $pid"
    if grep -q libQt6WebEngineCore "/proc/$pid/maps" 2>/dev/null; then
        bad "Chromium IS mapped into plasmashell (web mode selected?)"
    else
        ok "Chromium not mapped"
    fi
    if grep -q libcava "/proc/$pid/maps" 2>/dev/null; then
        ok "libcava mapped — the audio path is live"
    else
        info "libcava not mapped — audio is off, or the scene is not audio-reactive"
    fi
else
    bad "plasmashell is not running"
fi
cfgfile="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
awk '/^\[/{g=$0} /^(WallpaperMode|QmlScene|AudioReactive|SceneProperties)=/{ if (g ~ /luminos/) print "        " $0 }' \
    "$cfgfile" 2>/dev/null | tee -a "$LOG"
say ""

# ------------------------------------------------------------- 6. the journal
say "[6] what the wallpaper said this boot"
lines="$(journalctl --user -b -t plasmashell --no-pager 2>/dev/null | grep -c 'LUMINOS-WP')"
if [ "${lines:-0}" -eq 0 ]; then
    ok "no [LUMINOS-WP] warnings"
else
    bad "$lines [LUMINOS-WP] warning(s):"
    journalctl --user -b -t plasmashell --no-pager 2>/dev/null \
        | grep 'LUMINOS-WP' | tail -20 | sed 's/^/        /' | tee -a "$LOG"
fi
say ""

say "-----------------------------------------------------------"
say "  $PASS passed, $FAIL failed"
say "  report written to $LOG"
exit "$FAIL"
