#!/usr/bin/env bash
# luminos-claude-glm — open a SECOND Claude Desktop window that runs on GLM-5.3 (Abliteration),
# side by side with the normal Max-plan app. [CHANGE: cowork | 2026-10-22] DECISION 156.
#   luminos-claude-glm          open (or focus) the GLM app
#   luminos-claude-glm setup    (re)write its config only
#   luminos-claude-glm status
# HOW: --user-data-dir gives the app a whole separate profile (~/.config/Claude-glm) with its own
# single-instance lock and no claude.ai login; its 3P config lives in ~/.config/Claude-glm-3p. The Max app keeps using
# ~/.config/Claude and is never touched. Model names must look like Claude models (the app drops
# anything else), so the app talks to luminos-glm-proxy on 127.0.0.1:4141, which swaps names + key.
set -eu
GLMDIR="$HOME/.config/Claude-glm"      # the GLM app's own profile (login-free)
CFGDIR="$GLMDIR-3p"; LIB="$CFGDIR/configLibrary"   # the app reads 3P settings from <profile>-3p
ID="6c756d69-6e6f-7347-4c4d-353300000001"
ENVF="$HOME/.config/luminos/abliteration.env"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

setup() {
  [ -f "$ENVF" ] || { echo "No Abliteration key — run luminos-glm-key first" >&2; exit 1; }
  . "$ENVF"; [ -n "${GLM_LOCAL_TOKEN:-}" ] || { echo "GLM_LOCAL_TOKEN missing in $ENVF" >&2; exit 1; }
  mkdir -p "$LIB" "$GLMDIR"; chmod 700 "$GLMDIR" "$CFGDIR" "$LIB"
  TOK="$GLM_LOCAL_TOKEN" python3 - "$CFGDIR" "$ID" <<'PY'
import json,os,sys
d,i=sys.argv[1],sys.argv[2]
def w(p,o):
    t=p+".tmp"; open(t,"w").write(json.dumps(o,indent=2)); os.chmod(t,0o600); os.replace(t,p)
w(os.path.join(d,"configLibrary",i+".json"),{
 "inferenceProvider":"gateway",
 "inferenceGatewayBaseUrl":"http://127.0.0.1:4141",
 "inferenceGatewayApiKey":os.environ["TOK"],
 "inferenceGatewayAuthScheme":"bearer",
 "inferenceModels":[
   {"name":"claude-opus-4-5","labelOverride":"GLM-5.3 (Abliterated Large v2)","supports1m":True},
   {"name":"claude-haiku-4-5","labelOverride":"Abliterated (cheaper, reads images)"}],
 # DECISION 162: let Shawn upload luminos-skills.plugin (build, llm-council, ...). Skills copied straight into
 # skills-plugin/ are deleted by the app's own sync every 10 min; uploaded plugins are kept.
 "userPluginUploadsEnabled":True,
 "userPluginMarketplacesEnabled":True})
w(os.path.join(d,"configLibrary","_meta.json"),{"appliedId":i,"entries":[{"id":i,"name":"Abliteration GLM-5.3","provider":"gateway"}]})
p=os.path.join(d,"claude_desktop_config.json")
try: c=json.load(open(p))
except Exception: c={}
c["deploymentMode"]="3p"
# Local MCP servers (host-shell = run commands on this laptop, mempalace, code-review-graph):
# the GLM profile has its own config, so copy them from the Max app's on every launch. BUG-206.
try:
    mx=json.load(open(os.path.expanduser("~/.config/Claude/claude_desktop_config.json")))
    if mx.get("mcpServers"): c["mcpServers"]=mx["mcpServers"]
    # DECISION 162: GLM-only app control (windows, launch, accessibility clicks/text, keys, screenshot).
    c.setdefault("mcpServers",{})["luminos-desktop"]={"command":"/usr/bin/python3",
        "args":[os.path.expanduser("~/luminos-os/scripts/luminos-desktop-mcp")]}
    # DECISION 163: the GLM app runs inside netns claude-glm. Servers that must act on the REAL laptop (host-shell:
    # localhost services; luminos-desktop: apps it launches) go through luminos-mcp-share, whose broker is started by
    # the user systemd manager, i.e. in the normal namespace. All entries keep the normal runtime dir so the client
    # stubs find the broker sockets (the app itself gets a private XDG_RUNTIME_DIR, see open).
    share=os.path.expanduser("~/luminos-os/scripts/luminos-mcp-share")
    for n in ("host-shell","luminos-desktop"):
        e=c["mcpServers"].get(n)
        if e and os.path.basename(e.get("command",""))!="luminos-mcp-share":
            c["mcpServers"][n]={**e,"command":share,"args":["client","glm-"+n,"--",e["command"],*(e.get("args") or [])]}
    for n,e in c["mcpServers"].items():
        e.setdefault("env",{})["XDG_RUNTIME_DIR"]="/run/user/%d" % os.getuid()
    tf=mx.get("preferences",{}).get("localAgentModeTrustedFolders")
    if tf: c.setdefault("preferences",{})["localAgentModeTrustedFolders"]=sorted(set(tf)|set(c.get("preferences",{}).get("localAgentModeTrustedFolders",[])))
except Exception as e:
    print("warning: could not copy MCP servers from the Max app:", e)
w(p,c)
PY
  # [CHANGE: claude-code | 2026-10-24] DECISION 159: the servers copied from the Max app may be the bare form
  # (the Max app rewrites its config on any pref save) — put them back on the shared broker before launch.
  "$HOME/luminos-os/scripts/luminos-mcp-share" wrap-configs "$HOME/.config/Claude-glm-3p/claude_desktop_config.json" >/dev/null || true
}


case "${1:-open}" in
  setup) setup; echo "GLM app config written to $CFGDIR" ;;
  status)
    systemctl --user is-active --quiet luminos-glm-proxy && echo "translator: running" || echo "translator: NOT running"
    pgrep -f -- "CLAUDE_USER_DATA_DIR" >/dev/null 2>&1 || true
    grep -h "3P mode active" "$GLMDIR"/logs/main.log 2>/dev/null | tail -1 || true ;;
  open)
    setup
    # DECISION 162: refresh Shawn's skills (build, llm-council, ...) as an installed local plugin — only while the GLM
    # window is closed (the app reads plugins at start). Never fatal.
    if ! pgrep -f -- "--user-data-dir=$GLMDIR" >/dev/null; then
      "$HOME/luminos-os/scripts/luminos-glm-skills" >/dev/null 2>&1 && "$HOME/luminos-os/scripts/luminos-glm-skills-install" >/dev/null 2>&1 \
        || echo "warning: skills plugin refresh failed (run luminos-glm-skills-install by hand)" >&2
    fi
    systemctl --user start luminos-glm-proxy
    for _ in $(seq 10); do curl -fs 127.0.0.1:4141/health >/dev/null && break; sleep 0.5; done
    # DECISION 163 / BUG-224: own network namespace (own vsock port 51234 for the Cowork sandbox) and own
    # XDG_RUNTIME_DIR (own claude-cowork-vm.sock), so the GLM sandbox never collides with the Max app's.
    NETNS="$HOME/luminos-os/scripts/luminos-glm-netns"; U=$(id -u); R="/run/user/$U"
    if ! sudo -n "$NETNS" up >/dev/null; then
      echo "luminos-claude-glm: could not set up the GLM network namespace (sudo -n $NETNS up)" >&2
      command -v notify-send >/dev/null && notify-send "Claude (GLM-5.3)" "Could not set up its private network — see: sudo luminos-glm-netns up"
      exit 1
    fi
    GRT="$R/claude-glm-rt"; mkdir -p "$GRT"; chmod 700 "$GRT"
    BR="$R/luminos-glm-proxy.sock"   # 127.0.0.1:4141 inside the netns -> unix socket -> proxy on the real 127.0.0.1:4141
    systemctl --user is-active --quiet luminos-glm-proxy-bridge || systemd-run --user --quiet --collect \
      --unit=luminos-glm-proxy-bridge /usr/bin/socat "UNIX-LISTEN:$BR,fork,mode=600,unlink-early" TCP:127.0.0.1:4141
    systemctl --user is-active --quiet luminos-glm-proxy-ns || systemd-run --user --quiet --collect \
      --unit=luminos-glm-proxy-ns sudo -n "$NETNS" exec -- /usr/bin/socat TCP-LISTEN:4141,bind=127.0.0.1,fork,reuseaddr "UNIX-CONNECT:$BR"
    E=(env -i "HOME=$HOME" "USER=$(id -un)" "LOGNAME=$(id -un)" "SHELL=${SHELL:-/bin/bash}"
       "XDG_RUNTIME_DIR=$GRT" "DBUS_SESSION_BUS_ADDRESS=unix:path=$R/bus" "PIPEWIRE_RUNTIME_DIR=$R" "PULSE_SERVER=unix:$R/pulse/native")
    while IFS= read -r line; do
      case "$line" in
        XDG_RUNTIME_DIR=*|DBUS_SESSION_BUS_ADDRESS=*) ;;
        WAYLAND_DISPLAY=*) E+=("WAYLAND_DISPLAY=$R/${line#WAYLAND_DISPLAY=}");;   # absolute: XDG_RUNTIME_DIR differs
        KDE_*|XDG_*|DISPLAY=*|XAUTHORITY=*|QT_*|LANG=*|LC_*|PATH=*|SSH_AUTH_SOCK=*) E+=("$line");;
      esac
    done < <(systemctl --user show-environment)
    # --user-data-dir (not CLAUDE_USER_DATA_DIR): Electron applies it before the single-instance lock, so this really
    # is a second app. Runs as Shawn inside the netns (luminos-glm-netns exec drops root via setpriv).
    systemd-run --user --scope --quiet --unit="app-claude-glm-$$" \
      sudo -n "$NETNS" exec -- "${E[@]}" /usr/bin/claude-desktop --user-data-dir="$GLMDIR" "${@:2}"
    rc=$?
    # RAM rule: once the GLM app is really gone, take the bridge, socats and namespace down again.
    sleep 2
    if ! pgrep -f -- "--user-data-dir=$GLMDIR" >/dev/null; then
      systemctl --user stop luminos-glm-proxy-ns luminos-glm-proxy-bridge 2>/dev/null || true
      sudo -n "$NETNS" down >/dev/null 2>&1 || true
    fi
    exit $rc ;;
  *) echo "usage: luminos-claude-glm [open|setup|status]" >&2; exit 2 ;;
esac
