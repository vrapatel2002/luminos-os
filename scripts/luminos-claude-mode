#!/usr/bin/env bash
# luminos-claude-mode — switch the Claude DESKTOP APP between your Max plan and GLM-5.3.
# [CHANGE: cowork | 2026-10-22] DECISION 156.
#   luminos-claude-mode max     → normal claude.ai sign-in (Max plan)
#   luminos-claude-mode glm     → GLM-5.3 through Abliteration (app's "third-party" mode)
#   luminos-claude-mode status  → which one is set
# How: the app keeps 3P settings in ~/.config/Claude-3p/ (separate from the Max login in
# ~/.config/Claude/). It runs in 3P mode only when an applied config exists there AND
# deploymentMode != "1p". So switching = flip deploymentMode + restart. The Max login is not
# touched; a copy of its sign-in files is still taken once, just in case.
set -eu
DIR3="$HOME/.config/Claude-3p"; LIB="$DIR3/configLibrary"
ID="6c756d69-6e6f-7347-4c4d-353300000001"        # fixed id for the GLM entry
KEYFILE="$HOME/.config/luminos/abliteration.env"
RESTART="$HOME/luminos-os/scripts/luminos-claude-restart"

setmode() { python3 - "$DIR3/claude_desktop_config.json" "$1" <<'PY'
import json,os,sys
p,m=sys.argv[1],sys.argv[2]
try: d=json.load(open(p))
except Exception: d={}
d["deploymentMode"]=m
os.makedirs(os.path.dirname(p),mode=0o700,exist_ok=True)
t=p+".tmp"; open(t,"w").write(json.dumps(d,indent=2)); os.chmod(t,0o600); os.replace(t,p)
PY
}
getmode() { python3 -c "import json;print(json.load(open('$DIR3/claude_desktop_config.json')).get('deploymentMode','1p'))" 2>/dev/null || echo 1p; }

backup_login() {
  B="$HOME/.luminos-backups/claude-max-login"
  [ -d "$B" ] && return 0
  mkdir -p "$B"; chmod 700 "$B"
  ( cd "$HOME/.config/Claude" && cp -a Cookies "Local Storage" ant-device-registry.json ant-did \
      config.json claude_desktop_config.json buddy-tokens.json bridge-state.json "$B/" 2>/dev/null || true )
  echo "Saved a copy of your Max sign-in files to $B"
}

write_glm_config() {
  [ -f "$KEYFILE" ] || { echo "No Abliteration key yet — run: luminos-glm-key" >&2; exit 1; }
  . "$KEYFILE"
  mkdir -p "$LIB"; chmod 700 "$DIR3" "$LIB"
  KEY="$ABLITERATION_API_KEY" python3 - "$LIB" "$ID" <<'PY'
import json,os,sys
lib,i=sys.argv[1],sys.argv[2]
cfg={"inferenceProvider":"gateway",
     "inferenceGatewayBaseUrl":"https://api.abliteration.ai",
     "inferenceGatewayApiKey":os.environ["KEY"],
     "inferenceGatewayAuthScheme":"bearer",
     "inferenceModels":[
        {"name":"abliterated-model-large-v2","labelOverride":"GLM-5.3 (Abliterated Large v2)","supports1m":True},
        {"name":"abliterated-model","labelOverride":"Abliterated (cheaper, reads images)"}]}
def w(p,obj):
    t=p+".tmp"; open(t,"w").write(json.dumps(obj,indent=2)); os.chmod(t,0o600); os.replace(t,p)
w(os.path.join(lib,i+".json"),cfg)
mp=os.path.join(lib,"_meta.json")
try: meta=json.load(open(mp))
except Exception: meta={}
meta["appliedId"]=i
ents=[e for e in meta.get("entries",[]) if e.get("id")!=i]
ents.append({"id":i,"name":"Abliteration GLM-5.3","provider":"gateway"})
meta["entries"]=ents
w(mp,meta)
PY
}

case "${1:-status}" in
  glm) backup_login; write_glm_config; setmode 3p
       echo "Desktop app → GLM-5.3. Restarting the app..."; exec "$RESTART" ;;
  max) setmode 1p
       echo "Desktop app → Max plan. Restarting the app..."; exec "$RESTART" ;;
  status) m=$(getmode)
       if [ "$m" = 3p ] && [ -f "$LIB/$ID.json" ]; then echo "Desktop app: GLM-5.3 (Abliteration)"; else echo "Desktop app: Max plan (claude.ai)"; fi
       [ -f "$KEYFILE" ] && echo "Abliteration key: saved" || echo "Abliteration key: NOT saved (run luminos-glm-key)" ;;
  *) echo "usage: luminos-claude-mode max|glm|status" >&2; exit 2 ;;
esac
